{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "git": {
    "deploymentEnabled": { "*": false, "main": true }
  },
  "rewrites": [
    { "source": "/install", "destination": "https://raw.githubusercontent.com/nodelike/sikemux/main/scripts/install.sh" },
    { "source": "/ingest/static/(.*)", "destination": "https://eu-assets.i.posthog.com/static/$1" },
    { "source": "/ingest/array/(.*)", "destination": "https://eu-assets.i.posthog.com/array/$1" },
    { "source": "/ingest/(.*)", "destination": "https://eu.i.posthog.com/$1" }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.sikemux.com" }],
      "destination": "https://sikemux.com/$1",
      "permanent": true
    }
  ]
}
