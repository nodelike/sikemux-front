{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": { "*": false, "main": true }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.sikemux.com" }],
      "destination": "https://sikemux.com/$1",
      "permanent": true
    }
  ]
}
