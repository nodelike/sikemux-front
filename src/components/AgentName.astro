---
import "../styles/buddies.css";
import { buddy } from "../lib/buddies";
import { faceOf } from "../lib/showcase-buddies";

interface Props {
    name: string;
    chip?: boolean;
}

const { name, chip = false } = Astro.props;
const face = faceOf(name);
---

<span class:list={["agent-name", { "agent-chip": chip }]}>{face ? <span class="buddy" set:html={buddy(face.pack, face.shape, "idle").markup} /> : <img src="/brand/mark-purple.svg" alt="" />}@{name}</span>

<style>
    .agent-name {
        display: inline-flex;
        align-items: center;
        gap: 0.28em;
        white-space: nowrap;
        vertical-align: bottom;
    }
    .agent-name > :first-child {
        width: 1.2em;
        height: 1.2em;
        flex: none;
    }
    .agent-chip {
        flex: none;
        gap: 5px;
        padding: 0 6px 0 4px;
        border-radius: 5px;
        background: var(--surface-raised);
        color: var(--text-primary);
        line-height: 1.618;
    }
    .agent-chip > :first-child {
        width: calc(1em + 1px);
        height: calc(1em + 1px);
        margin: 0 calc((14px - 1em) / 2);
    }
    .agent-chip > img {
        scale: 1.2;
    }
</style>
