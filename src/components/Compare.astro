---
import { Image } from "astro:assets";
import Band from "./Band.astro";
import art from "../assets/art/compare-cabin.jpg";
import sikemux from "../assets/apps/sikemux.png";
import cursor from "../assets/apps/cursor.png";
import zed from "../assets/apps/zed.png";
import warp from "../assets/apps/warp.png";
import paradev from "../assets/apps/paradev.png";
import conductor from "../assets/apps/conductor.png";
import cmux from "../assets/apps/cmux.png";
import t3code from "../assets/apps/t3code.png";
import orca from "../assets/apps/orca.png";
import herdr from "../assets/apps/herdr.png";
import paseo from "../assets/apps/paseo.png";
import { COMPARISONS, comparisonPath } from "../lib/comparisons";

const icons: Record<string, ImageMetadata> = { t3code, orca, conductor, paradev, herdr, paseo, cmux, cursor, zed, warp };
---

<section class="compare" id="compare">
    <Band art={art} label="Compare" focus="right center">
        <Fragment slot="title">One window<br /><em>instead of five.</em></Fragment>
        <Fragment slot="lede">What changes when your agents, code and tools share a project, rather than living in a terminal, an editor and a pile of browser tabs.</Fragment>
        <div class="deck" data-compare data-reveal>
            <div class="rivals" role="tablist" aria-label="Compare Sikemux with">
                {
                    COMPARISONS.map((comparison, index) => (
                        <button type="button" role="tab" id={`vs-tab-${comparison.slug}`} aria-controls={`vs-${comparison.slug}`} aria-selected={index === 0 ? "true" : "false"}>
                            <Image class="icon" src={icons[comparison.slug]} alt="" width={36} densities={[2, 3]} format="webp" />
                            <span>
                                <span class="name">{comparison.name}</span>
                                <span class="kind">{comparison.kind}</span>
                            </span>
                        </button>
                    ))
                }
            </div>
            {
                COMPARISONS.map((comparison, index) => (
                    <article class="verdict" role="tabpanel" id={`vs-${comparison.slug}`} aria-labelledby={`vs-tab-${comparison.slug}`} hidden={index !== 0}>
                        <header>
                            <span class="pair">
                                <Image class="mark" src={sikemux} alt="" width={44} densities={[2, 3]} format="webp" />
                                <span class="vs mono">vs</span>
                                <Image class="mark" src={icons[comparison.slug]} alt="" width={44} densities={[2, 3]} format="webp" />
                            </span>
                            <h3>Sikemux vs {comparison.name}</h3>
                        </header>
                        <p class="difference">{comparison.difference}</p>
                        <div class="picks">
                            <div>
                                <p class="label">Pick {comparison.name} if</p>
                                <ul>
                                    {comparison.pickThem.map((reason) => (
                                        <li>{reason}</li>
                                    ))}
                                </ul>
                            </div>
                            <div class="ours">
                                <p class="label">Pick Sikemux if</p>
                                <ul>
                                    {comparison.pickSikemux.map((reason) => (
                                        <li>{reason}</li>
                                    ))}
                                </ul>
                            </div>
                        </div>
                        <a class="more" href={comparisonPath(comparison)}>
                            The full comparison <span aria-hidden="true">→</span>
                        </a>
                    </article>
                ))
            }
        </div>
    </Band>
</section>

<script>
    for (const deck of document.querySelectorAll<HTMLElement>("[data-compare]")) {
        const tabs = [...deck.querySelectorAll<HTMLButtonElement>("[role=tab]")];
        const show = (index: number) =>
            tabs.forEach((tab, i) => {
                tab.setAttribute("aria-selected", String(i === index));
                tab.tabIndex = i === index ? 0 : -1;
                deck.querySelector<HTMLElement>(`#${tab.getAttribute("aria-controls")}`)!.hidden = i !== index;
            });
        tabs.forEach((tab, i) => {
            tab.addEventListener("click", () => show(i));
            tab.addEventListener("keydown", (event) => {
                const step = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[event.key];
                if (step === undefined) return;
                event.preventDefault();
                const next = (i + step + tabs.length) % tabs.length;
                show(next);
                tabs[next].focus();
            });
        });
        show(0);
    }
</script>

<style>
    .compare {
        padding-block: 0 clamp(24px, 3vw, 40px);
    }

    .deck {
        display: grid;
        grid-template-columns: minmax(0, 300px) minmax(0, 1fr);
        gap: 14px;
        align-items: start;
    }

    .rivals {
        display: grid;
        gap: 6px;
        padding: 6px;
        border: 1px solid var(--border);
        border-radius: var(--radius-4);
        background: color-mix(in oklab, var(--surface-raised) 92%, transparent);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
    }

    .rivals button {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 10px 12px;
        border: 1px solid transparent;
        border-radius: var(--radius-3);
        background: none;
        font: inherit;
        text-align: left;
        color: var(--text-secondary);
        cursor: pointer;
        transition:
            background var(--dur-2) var(--ease-out),
            border-color var(--dur-2) var(--ease-out);
    }

    .rivals button:hover {
        background: var(--surface-hover);
    }

    .rivals button[aria-selected="true"] {
        border-color: var(--border-selected);
        background: var(--surface-selected);
        color: var(--text-primary);
    }

    .rivals :global(.icon) {
        flex: none;
        width: 36px;
        height: 36px;
    }

    .name {
        display: block;
        font-size: 15px;
        font-weight: 500;
        color: var(--text-primary);
    }

    .kind {
        display: block;
        font-size: 13px;
        color: var(--text-tertiary);
    }

    .kind::first-letter {
        text-transform: uppercase;
    }

    .verdict {
        display: grid;
        align-content: start;
        gap: 22px;
        min-height: 100%;
        padding: clamp(22px, 3vw, 36px);
        border: 1px solid var(--border);
        border-radius: var(--radius-4);
        background:
            radial-gradient(70% 60% at 100% 0%, color-mix(in oklab, var(--acc) 12%, transparent), transparent),
            linear-gradient(to bottom, var(--gray-100), var(--surface-sunken));
    }

    .verdict[hidden] {
        display: none;
    }

    header {
        display: flex;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
    }

    .pair {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .pair :global(.mark) {
        width: 44px;
        height: 44px;
    }

    .vs {
        font-size: 12px;
        color: var(--text-tertiary);
    }

    h3 {
        font-family: var(--serif);
        font-size: clamp(30px, 3vw, 40px);
        font-weight: 400;
        line-height: 1;
        letter-spacing: -0.01em;
    }

    .difference {
        max-width: 64ch;
        font-size: 16px;
        line-height: 1.6;
        color: var(--text-secondary);
    }

    .picks {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .picks > div {
        display: grid;
        align-content: start;
        gap: 12px;
        padding: 18px 20px;
        border: 1px solid var(--border);
        border-radius: var(--radius-3);
        background: color-mix(in oklab, var(--bg-dim) 60%, transparent);
    }

    .picks .ours {
        border-color: var(--border-selected);
    }

    .ours .label {
        color: var(--acc-soft);
    }

    ul {
        display: grid;
        gap: 10px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    li {
        position: relative;
        padding-left: 18px;
        font-size: 14px;
        line-height: 1.5;
        color: var(--text-secondary);
    }

    li::before {
        content: "–";
        position: absolute;
        left: 0;
        color: var(--text-tertiary);
    }

    .ours li::before {
        content: "✓";
        color: var(--acc-soft);
    }

    .more {
        justify-self: start;
        font-size: 14px;
        font-weight: 500;
        color: var(--text-primary);
    }

    .more span {
        display: inline-block;
        transition: transform var(--dur-2) var(--ease-out);
    }

    .more:hover span {
        transform: translateX(3px);
    }

    @media (max-width: 900px) {
        .deck {
            grid-template-columns: minmax(0, 1fr);
        }

        .rivals {
            display: flex;
            overflow-x: auto;
            scrollbar-width: none;
        }

        .rivals button {
            flex: none;
        }

        .picks {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
