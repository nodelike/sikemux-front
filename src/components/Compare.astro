---
import { Image } from "astro:assets";
import sikemux from "../assets/apps/sikemux.png";
import cursor from "../assets/apps/cursor.png";
import zed from "../assets/apps/zed.png";
import warp from "../assets/apps/warp.png";
import superset from "../assets/apps/superset.png";
import conductor from "../assets/apps/conductor.png";
import cmux from "../assets/apps/cmux.png";
import { COMPARISONS, comparisonPath } from "../lib/comparisons";

const icons: Record<string, ImageMetadata> = { cursor, zed, warp, superset, conductor, cmux };
---

<section class="compare" id="compare">
    <div class="page">
        <div class="statement" data-reveal>
            <h2 class="display">One window instead of five.</h2>
            <p>What changes when your agents, code and tools share a project, rather than living in a terminal, an editor and a pile of browser tabs.</p>
        </div>
        <ul class="cards" data-reveal>
            {
                COMPARISONS.map((comparison) => (
                    <li>
                        <a href={comparisonPath(comparison)}>
                            <span class="ground">
                                <span class="pair">
                                    <Image class="icon" src={sikemux} alt="" width={56} densities={[2, 3]} format="webp" />
                                    <span class="vs mono">vs</span>
                                    <Image class="icon" src={icons[comparison.slug]} alt="" width={56} densities={[2, 3]} format="webp" />
                                </span>
                            </span>
                            <span class="caption">
                                <span>
                                    <span class="title">Sikemux vs {comparison.name}</span>
                                    <span class="kind">{comparison.kind}</span>
                                </span>
                                <span class="arrow" aria-hidden="true">→</span>
                            </span>
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</section>

<style>
    .compare {
        padding-block: clamp(80px, 10vw, 136px);
    }

    .cards {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    a {
        display: grid;
        border: 1px solid var(--border);
        border-radius: var(--radius-4);
        overflow: hidden;
        background: var(--gray-100);
        transition: border-color var(--dur-2) var(--ease-out);
    }

    a:hover {
        border-color: var(--border-strong);
    }

    .ground {
        display: grid;
        place-items: center;
        aspect-ratio: 16 / 7;
        border-bottom: 1px solid var(--border);
        background:
            radial-gradient(50% 70% at 50% 100%, color-mix(in oklab, var(--acc) 0%, transparent), transparent),
            radial-gradient(circle at 1px 1px, var(--gray-300) 1px, transparent 0) 0 0 / 8px 8px,
            var(--surface-sunken);
        transition: background var(--dur-2) var(--ease-out);
    }

    a:hover .ground {
        background:
            radial-gradient(50% 70% at 50% 100%, color-mix(in oklab, var(--acc) 22%, transparent), transparent),
            radial-gradient(circle at 1px 1px, var(--gray-300) 1px, transparent 0) 0 0 / 8px 8px,
            var(--surface-sunken);
    }

    .pair {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .vs {
        font-size: 12px;
        color: var(--text-tertiary);
    }

    .pair :global(.icon) {
        width: 56px;
        height: 56px;
    }

    .caption {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 14px 18px;
    }

    .caption > span:first-child {
        display: grid;
    }

    .title {
        font-size: 15px;
        font-weight: 500;
        color: var(--text-primary);
    }

    .kind {
        display: block;
        font-size: 13px;
        color: var(--text-tertiary);
    }

    .kind::first-letter {
        text-transform: uppercase;
    }

    .arrow {
        color: var(--text-tertiary);
        transition: transform var(--dur-2) var(--ease-out);
    }

    a:hover .arrow {
        transform: translateX(3px);
        color: var(--text-primary);
    }

    @media (max-width: 900px) {
        .cards {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 560px) {
        .cards {
            grid-template-columns: minmax(0, 1fr);
        }

        .ground {
            aspect-ratio: 16 / 5;
        }
    }
</style>
