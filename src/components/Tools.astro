---
const tools = [
    { name: "workspace.inspect", body: "Panes, configured tasks, and what is running" },
    { name: "task.start", body: "Start a task from sikemux.json in a managed terminal" },
    { name: "task.read", body: "Read its output from a cursor, page by page" },
    { name: "events.wait", body: "Wait for output, exits, or files opening" },
    { name: "ui.open", body: "Put a file, diff, terminal, or preview in front of you" },
    { name: "task.stop", body: "Stop that exact run and everything it started" },
];

const session = [
    "# the same calls an agent makes over MCP",
    `sikemux tool task.start '{"taskId":"dev","idempotencyKey":"first-run"}'`,
    `sikemux tool task.read '{"executionId":"RETURNED_ID","cursor":0}'`,
    `sikemux tool ui.open '{"kind":"file","path":"src/App.tsx","line":42,"focus":true}'`,
    "",
    "# and as your editor",
    "sikemux .",
    "sikemux src/App.tsx:42:5",
    "EDITOR=sikemux-editor git commit",
];
---

<section class="section">
    <div class="page grid">
        <div class="section-head">
            <p class="label">For the agents</p>
            <h2>Agents can drive the project too.</h2>
            <p>
                Sikemux ships an MCP server and a matching CLI. An agent can start your dev server, read its logs, and open the file it just
                changed in your editor, without guessing at a shell.
            </p>
            <ul class="tools">
                {
                    tools.map((tool) => (
                        <li>
                            <code>{tool.name}</code>
                            <span>{tool.body}</span>
                        </li>
                    ))
                }
            </ul>
        </div>
        <pre class="code" aria-label="Example CLI session"><code>{
            session.map((line) =>
                line.startsWith("#") ? <span class="dim">{line}</span> : line ? <><span class="prompt">$</span> {line}</> : ""
            ).map((node, index) => <>{index > 0 && "\n"}{node}</>)
        }</code></pre>
    </div>
</section>

<style>
    .grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
        align-items: start;
        gap: clamp(32px, 5vw, 72px);
    }

    .grid .section-head {
        margin-bottom: 0;
    }

    .tools {
        display: grid;
        margin: 12px 0 0;
        padding: 0;
        list-style: none;
        border-top: 1px solid var(--border);
    }

    .tools li {
        display: grid;
        grid-template-columns: 150px minmax(0, 1fr);
        gap: 16px;
        padding-block: 10px;
        border-bottom: 1px solid var(--gray-200);
        font-size: 14px;
    }

    .tools code {
        font-size: 12.5px;
        color: var(--text-primary);
    }

    .code {
        margin: 0;
        padding: 24px;
        border: 1px solid var(--border);
        border-radius: var(--radius-3);
        background: var(--surface);
        overflow-x: auto;
        font-size: 13px;
        line-height: 1.8;
        color: var(--text-primary);
    }

    .code code {
        font-size: inherit;
    }

    .dim {
        color: var(--text-tertiary);
    }

    .prompt {
        color: var(--live);
        user-select: none;
    }

    @media (max-width: 960px) {
        .grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    @media (max-width: 520px) {
        .tools li {
            grid-template-columns: minmax(0, 1fr);
            gap: 2px;
        }
    }
</style>
