---
const tools = [
    { name: "workspace.inspect", body: "Panes, configured tasks, and what is running" },
    { name: "task.start", body: "Start a task from sikemux.json in a managed terminal" },
    { name: "task.read", body: "Read its output from a cursor, page by page" },
    { name: "events.wait", body: "Wait for output, exits, or files opening" },
    { name: "ui.open", body: "Put a file, diff, terminal, or preview in front of you" },
    { name: "task.stop", body: "Stop that exact run and everything it started" },
];

const session = [
    "# the calls an agent makes over MCP",
    `sikemux tool task.start '{"taskId":"dev"}'`,
    `sikemux tool task.read '{"executionId":"e1"}'`,
    `sikemux tool ui.open '{"path":"src/App.tsx"}'`,
    "",
    "# and Sikemux as your editor",
    "sikemux .",
    "sikemux src/App.tsx:42:5",
    "EDITOR=sikemux-editor git commit",
];
---

<section class="section">
    <div class="page">
        <div class="section-head">
            <p class="label">For the agents</p>
            <h2>Agents can drive the project too.</h2>
            <p>
                Sikemux ships an MCP server and a matching CLI. An agent can start your dev server, read its logs, and open the file it just
                changed in your editor, without guessing at a shell.
            </p>
        </div>
        <div class="grid">
            <figure class="terminal">
                <div class="bar" aria-hidden="true">
                    <span class="lights"></span>
                    <span class="title mono">zsh · ~/code/sikemux</span>
                </div>
                <pre aria-label="Example CLI session"><code>{
                    session.map((line) =>
                        line.startsWith("#") ? <span class="dim">{line}</span> : line ? <><span class="prompt">$</span> {line}</> : ""
                    ).map((node, index) => <>{index > 0 && "\n"}{node}</>)
                }</code></pre>
            </figure>
            <ul class="tools">
                {
                    tools.map((tool) => (
                        <li>
                            <code>{tool.name}</code>
                            <span>{tool.body}</span>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</section>

<style>
    .grid {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
        align-items: stretch;
        gap: 16px;
    }

    .terminal {
        display: grid;
        grid-template-rows: auto 1fr;
        margin: 0;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: var(--radius-4);
        background:
            radial-gradient(80% 60% at 0% 100%, color-mix(in oklab, var(--live) 7%, transparent), transparent 70%),
            var(--surface-sunken);
    }

    .bar {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 38px;
        border-bottom: 1px solid var(--border);
        background: var(--surface);
    }

    .lights {
        position: absolute;
        left: 16px;
        width: 11px;
        height: 11px;
        border-radius: 50%;
        background: #ff5f57;
        box-shadow:
            18px 0 0 #febc2e,
            36px 0 0 #28c840;
    }

    .title {
        font-size: 12px;
        color: var(--text-tertiary);
    }

    pre {
        margin: 0;
        padding: 22px 24px;
        overflow-x: auto;
        font-size: 13.5px;
        line-height: 1.85;
        color: var(--text-primary);
        white-space: pre-wrap;
        word-break: break-word;
    }

    pre code {
        font-size: inherit;
    }

    .dim {
        color: var(--text-tertiary);
    }

    .prompt {
        color: var(--live);
        user-select: none;
    }

    .tools {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .tools li {
        display: grid;
        gap: 8px;
        align-content: start;
        padding: 18px;
        border: 1px solid var(--border);
        border-radius: var(--radius-3);
        background: var(--surface);
        transition: border-color var(--dur-2) var(--ease-out);
    }

    .tools li:hover {
        border-color: var(--border-strong);
    }

    .tools code {
        font-size: 13px;
        color: var(--text-primary);
    }

    .tools span {
        font-size: 14px;
        line-height: 1.5;
    }

    @media (max-width: 960px) {
        .grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    @media (max-width: 520px) {
        .tools {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
