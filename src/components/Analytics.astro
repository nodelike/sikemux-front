<script>
    import { capture, startAnalytics } from "../lib/analytics";

    if (document.readyState === "complete") startAnalytics();
    else addEventListener("load", startAnalytics, { once: true });

    document.addEventListener("click", (event) => {
        const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>("a[data-release-dmg], a[data-download]") : null;
        if (link) capture("download_clicked", { url: link.href, platform: link.dataset.platform });
        if (event.target instanceof Element && event.target.closest("[data-install-copy]")) capture("install_command_copied");
    });
</script>
