---
import { FAQ } from "../lib/faq";
import { DISCORD_URL } from "../lib/release";
---

<section class="faq" id="faq">
    <div class="page grid">
        <div class="head">
            <h2 class="display">Questions</h2>
            <p>Short answers about price, agents, privacy and which computers it runs on.</p>
            <a class="ask" href={DISCORD_URL}>Ask us something else on Discord →</a>
        </div>
        <div class="list">
            {
                FAQ.map((entry) => (
                    <details>
                        <summary>{entry.question}</summary>
                        <p set:html={entry.answer} />
                    </details>
                ))
            }
        </div>
    </div>
</section>

<style>
    .faq {
        padding-block: clamp(80px, 10vw, 136px);
    }

    .head {
        position: sticky;
        top: 96px;
        display: grid;
        gap: 16px;
    }

    .head p {
        font-size: 16px;
    }

    .ask {
        font-size: 14px;
        color: var(--text-primary);
    }

    .grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
        align-items: start;
        gap: clamp(24px, 5vw, 72px);
    }

    .list {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        border-top: 1px solid var(--border);
    }

    details {
        border-bottom: 1px solid var(--border);
    }

    summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding-block: 22px;
        font-size: 17px;
        font-weight: 500;
        color: var(--text-primary);
        cursor: pointer;
        list-style: none;
    }

    summary::-webkit-details-marker {
        display: none;
    }

    summary::after {
        content: "+";
        font-family: var(--mono);
        font-weight: 400;
        color: var(--text-tertiary);
        transition: transform var(--dur-2) var(--ease-out);
    }

    details[open] summary::after {
        transform: rotate(45deg);
    }

    details p {
        max-width: 62ch;
        padding-bottom: 14px;
    }

    details p:last-child {
        padding-bottom: 20px;
    }

    details :global(a) {
        color: var(--text-primary);
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    pre {
        margin: 0 0 14px;
        padding: 12px 14px;
        border: 1px solid var(--border);
        border-radius: var(--radius-2);
        background: var(--surface);
        overflow-x: auto;
        font-size: 13px;
        color: var(--text-primary);
    }

    pre code {
        font-size: inherit;
    }

    @media (max-width: 860px) {
        .grid {
            grid-template-columns: minmax(0, 1fr);
        }

        .head {
            position: static;
        }
    }
</style>
