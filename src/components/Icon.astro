export type IconName = keyof typeof LINE_ICONS | "aws" | "rundeck" | "bruno" | "signoz";

interface Props {
    name: IconName;
    size?: number;
}

const { name, size = 16 } = Astro.props;
const line = name in LINE_ICONS ? LINE_ICONS[name as keyof typeof LINE_ICONS] : null;
---

{
    line && (
        <svg
            width={size}
            height={size}
            viewBox={line.viewBox}
            fill={line.fill}
            stroke="currentColor"
            stroke-width={line.strokeWidth}
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={line.body}
        />
    )
}
{
