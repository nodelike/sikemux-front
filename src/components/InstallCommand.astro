---
import Icon from "./Icon.astro";
import { INSTALL_COMMAND } from "../lib/release";
---

<button class="install mono" type="button" data-install-copy aria-label="Copy the install command">
    <span class="prompt" aria-hidden="true">$</span>
    <code>{INSTALL_COMMAND}</code>
    <span class="icon copy"><Icon name="copy" size={14} /></span>
    <span class="icon done"><Icon name="check" size={14} /></span>
</button>

<script>
    import { INSTALL_COMMAND } from "../lib/release";

    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-install-copy]")) {
        let reset = 0;
        button.addEventListener("click", async () => {
            await navigator.clipboard.writeText(INSTALL_COMMAND);
            button.dataset.copied = "";
            clearTimeout(reset);
            reset = window.setTimeout(() => delete button.dataset.copied, 1600);
        });
    }
</script>

<style>
    .install {
        display: inline-flex;
        align-items: center;
        width: fit-content;
        gap: 10px;
        max-width: 100%;
        height: 40px;
        padding-inline: 14px 12px;
        border: 1px solid var(--border);
        border-radius: var(--radius-2);
        background: color-mix(in oklab, var(--surface) 70%, transparent);
        font-size: 13px;
        color: var(--text-primary);
        cursor: pointer;
        transition: border-color var(--dur-2) var(--ease-out);
    }

    @media (max-width: 420px) {
        .install {
            gap: 8px;
            padding-inline: 12px 10px;
            font-size: 11px;
        }
    }

    .install:hover {
        border-color: var(--border-strong);
    }

    code {
        overflow: hidden;
        font-size: inherit;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .prompt {
        color: var(--live);
        user-select: none;
    }

    .icon {
        display: inline-flex;
        flex: none;
        color: var(--text-tertiary);
    }

    .done,
    [data-copied] .copy {
        display: none;
    }

    [data-copied] .done {
        display: inline-flex;
        color: var(--live);
    }
</style>
