---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import aws from "../assets/shots/aws-ecs-logs-card.png";
import rundeck from "../assets/shots/rundeck-deploy-card.png";
import signoz from "../assets/shots/signoz-dashboard-card.png";
import bruno from "../assets/shots/bruno-card.png";
import github from "../assets/shots/github-run-card.png";
import database from "../assets/cards/database.png";
import jira from "../assets/cards/jira.png";

const plugins = [
    {
        id: "database",
        icon: "database",
        name: "Database",
        claim: "Query your database next to the code that uses it.",
        points: ["PostgreSQL, MySQL, MariaDB and SQLite", "Passwords kept in your Keychain", "Agents query it read-only by default"],
        image: database,
        alt: "A PostgreSQL console listing the last day's failed orders, with the schema's tables beside it",
    },
    {
        id: "github",
        icon: "github",
        name: "GitHub Actions",
        claim: "Watch CI without opening GitHub.",
        points: ["Runs, jobs and their logs", "Re-run, download artifacts, approve deploys", "GitLab and Bitbucket pipelines too"],
        image: github,
        alt: "A passing release workflow with its four jobs and the test report",
    },
    {
        id: "jira",
        icon: "jira",
        name: "Jira and Linear",
        claim: "Your issue, next to the branch that fixes it.",
        points: ["Your sprint board, filtered like Jira's own", "Search, comment, assign and log time", "Agents read, comment on, move and file issues"],
        image: jira,
        alt: "A Jira sprint board grouped by person, with cards in To do, In progress, In review and Done",
    },
    {
        id: "rundeck",
        icon: "rundeck",
        name: "Rundeck",
        claim: "Deploy a branch and watch every step land.",
        points: ["Which branch is live on each service", "Step-by-step output as it streams", "A notification when a deploy ends"],
        image: rundeck,
        alt: "A Rundeck deploy of billing-service at step 5 of 6, with live output",
    },
    {
        id: "signoz",
        icon: "signoz",
        name: "SigNoz",
        claim: "See what production is doing right now.",
        points: ["Service health and error rates", "Logs, traces and your dashboards", "Agents can search it for you"],
        image: signoz,
        alt: "A SigNoz dashboard with request rate, error rate, throughput and p99 latency",
    },
    {
        id: "aws",
        icon: "aws",
        name: "AWS",
        claim: "Follow a service's logs without the AWS console.",
        points: ["Live logs for your services", "What you spend, by month and by service", "Signs in with your company login"],
        image: aws,
        alt: "CloudWatch logs streaming for an ECS service, with a warning and an error highlighted",
    },
    {
        id: "bruno",
        icon: "bruno",
        name: "Bruno",
        claim: "Send requests from the collection in your repo.",
        points: ["Uses the collection saved in your repo", "Switch between environments", "Scripts that run before and after a request"],
        image: bruno,
        alt: "A Bruno POST request and its 201 Created JSON response",
    },
] as const;
---

<section class="plugins" id="plugins">
    <div class="page">
        <div class="statement" data-reveal>
            <h2 class="display">CI, issues and production, without leaving.</h2>
            <p>Turn on the tools your team already uses. Watch CI, move an issue or follow a deploy right next to the code, and hand anything you find to an agent.</p>
        </div>
        <div class="deck" data-plugins data-reveal>
            <div class="tiles" role="tablist" aria-label="Plugins">
                {
                    plugins.map((plugin, index) => (
                        <button type="button" role="tab" id={`plugin-tab-${plugin.id}`} aria-controls={`plugin-${plugin.id}`} aria-selected={index === 0 ? "true" : "false"}>
                            <span class="glyph">
                                <Icon name={plugin.icon} size={20} />
                            </span>
                            {plugin.name}
                        </button>
                    ))
                }
            </div>
            {
                plugins.map((plugin, index) => (
                    <article class="panel" role="tabpanel" id={`plugin-${plugin.id}`} aria-labelledby={`plugin-tab-${plugin.id}`} hidden={index !== 0}>
                        <div class="text">
                            <h3>{plugin.claim}</h3>
                            <ul>
                                {plugin.points.map((point) => (
                                    <li>{point}</li>
                                ))}
                            </ul>
                        </div>
                        <div class="picture">
                            <Image src={plugin.image} alt={plugin.alt} format="avif" quality={80} widths={[720, 1080, 1440]} sizes="(min-width: 1240px) 760px, 100vw" />
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</section>

<script>
    const ROTATE_EVERY = 5000;

    for (const deck of document.querySelectorAll<HTMLElement>("[data-plugins]")) {
        const tabs = [...deck.querySelectorAll<HTMLButtonElement>("[role=tab]")];
        let current = 0;
        let timer = 0;

        const show = (index: number) => {
            current = index;
            tabs.forEach((tab, i) => {
                tab.setAttribute("aria-selected", String(i === index));
                const panel = deck.querySelector<HTMLElement>(`#${tab.getAttribute("aria-controls")}`);
                if (panel) panel.hidden = i !== index;
            });
        };

        const stop = () => window.clearInterval(timer);
        tabs.forEach((tab, i) =>
            tab.addEventListener("click", () => {
                stop();
                show(i);
            }),
        );

        if (matchMedia("(prefers-reduced-motion: reduce)").matches) continue;
        new IntersectionObserver(([entry]) => {
            stop();
            if (entry.isIntersecting) timer = window.setInterval(() => show((current + 1) % tabs.length), ROTATE_EVERY);
        }).observe(deck);
        deck.addEventListener("pointerdown", stop, { once: true });
    }
</script>

<style>
    .plugins {
        padding-block: clamp(80px, 10vw, 136px);
    }

    .deck {
        display: grid;
        gap: 18px;
    }

    .tiles {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
    }

    .tiles button {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        height: 52px;
        padding: 0 20px 0 7px;
        border: 1px solid var(--border);
        border-radius: var(--radius-pill);
        background: var(--gray-100);
        font: inherit;
        font-size: 15px;
        font-weight: 500;
        color: var(--text-secondary);
        cursor: pointer;
        transition:
            background var(--dur-2) var(--ease-out),
            color var(--dur-2) var(--ease-out);
    }

    .tiles button:hover {
        color: var(--text-primary);
    }

    .glyph {
        display: grid;
        place-items: center;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: var(--gray-300);
        color: var(--ink);
        transition: background var(--dur-2) var(--ease-out);
    }

    .tiles button[aria-selected="true"] {
        border-color: var(--border-strong);
        background: var(--gray-300);
        color: var(--text-primary);
    }

    .tiles button[aria-selected="true"] .glyph {
        background: var(--gray-500);
    }

    .panel {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
        gap: 32px;
        min-height: 460px;
        padding: 36px 0 0 36px;
        border: 1px solid var(--border);
        border-radius: var(--radius-4);
        background: linear-gradient(to bottom, var(--gray-100), var(--surface-sunken));
        overflow: hidden;
        animation: rise 0.45s var(--ease-out);
    }

    .panel[hidden] {
        display: none;
    }

    @keyframes rise {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
    }

    .text {
        display: grid;
        align-content: start;
        gap: 22px;
        padding-bottom: 36px;
    }

    h3 {
        font-size: clamp(26px, 2.6vw, 34px);
        font-weight: 600;
        line-height: 1.1;
        letter-spacing: -0.035em;
    }

    ul {
        display: grid;
        gap: 10px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    li {
        display: flex;
        gap: 10px;
        font-size: 15px;
    }

    li::before {
        content: "✓";
        flex: none;
        color: var(--acc);
    }

    .picture {
        align-self: end;
        border: 1px solid var(--border-strong);
        border-right: 0;
        border-bottom: 0;
        border-top-left-radius: var(--radius-3);
        overflow: hidden;
    }

    .picture :global(img) {
        width: 100%;
        height: auto;
    }

    @media (max-width: 860px) {
        .panel {
            grid-template-columns: minmax(0, 1fr);
            padding: 26px 0 0 26px;
        }

        .text {
            padding: 0 26px 0 0;
        }
    }
</style>
