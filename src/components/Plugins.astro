---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import database from "../assets/shots/database-stage.png";
import github from "../assets/shots/github-run-stage.png";
import jira from "../assets/shots/jira-board-stage.png";
import rundeck from "../assets/shots/rundeck-deploy-stage.png";
import signoz from "../assets/shots/signoz-dashboard-stage.png";
import aws from "../assets/shots/aws-ecs-logs-stage.png";
import bruno from "../assets/shots/bruno-stage.png";

const plugins = [
    {
        id: "jira",
        icon: "jira",
        name: "Jira",
        claim: "Your issue, next to the branch that fixes it.",
        points: ["Your sprint board, filtered like Jira's own", "Search, comment, assign and log time", "Agents read, move and file issues"],
        image: jira,
        alt: "A Jira sprint board grouped by person, with cards in To do, In progress, In review and Done",
    },
    {
        id: "database",
        icon: "database",
        name: "Database",
        claim: "Query your database next to the code that uses it.",
        points: ["PostgreSQL, MySQL, MariaDB and SQLite", "Passwords kept in your Keychain", "Agents query it read-only by default"],
        image: database,
        alt: "A PostgreSQL console listing the last day's failed orders, with the schema's tables beside it",
    },
    {
        id: "bruno",
        icon: "bruno",
        name: "Bruno",
        claim: "Send requests from the collection in your repo.",
        points: ["Uses the collection saved in your repo", "Switch between environments", "Scripts before and after a request"],
        image: bruno,
        alt: "A Bruno POST request and its 201 Created JSON response",
    },
    {
        id: "github",
        icon: "github",
        name: "GitHub Actions",
        claim: "Watch CI without opening GitHub.",
        points: ["Runs, jobs and their logs", "Re-run, download artifacts, approve deploys", "GitLab and Bitbucket pipelines too"],
        image: github,
        alt: "A passing release workflow with its four jobs and the test report",
    },
    {
        id: "rundeck",
        icon: "rundeck",
        name: "Rundeck",
        claim: "Deploy a branch and watch every step land.",
        points: ["Which branch is live on each service", "Step-by-step output as it streams", "A notification when a deploy ends"],
        image: rundeck,
        alt: "A Rundeck deploy of billing-service at step 5 of 6, with live output",
    },
    {
        id: "signoz",
        icon: "signoz",
        name: "SigNoz",
        claim: "See what production is doing right now.",
        points: ["Service health and error rates", "Logs, traces and your dashboards", "Agents can search it for you"],
        image: signoz,
        alt: "A SigNoz dashboard with request rate, error rate, throughput and p99 latency",
    },
    {
        id: "aws",
        icon: "aws",
        name: "AWS",
        claim: "Follow a service's logs without the AWS console.",
        points: ["Live logs for your services", "What you spend, by month and by service", "Signs in with your company login"],
        image: aws,
        alt: "CloudWatch logs streaming for an ECS service, with a warning and an error highlighted",
    },
] as const;

const extras = [
    { icon: "linear", name: "Linear" },
    { icon: "gitlab", name: "GitLab" },
    { icon: "bitbucket", name: "Bitbucket" },
    { icon: "vercel", name: "Vercel" },
    { icon: "slack", name: "Slack" },
] as const;
---

<section class="section" id="plugins">
<div class="page">
    <div class="head">
        <div class="section-head">
            <p class="label">Built-in plugins</p>
            <h2>CI, issues and production, without leaving.</h2>
        </div>
        <p class="lede">Turn on the tools your team already uses, right next to the code, and hand anything you find in them to an agent.</p>
    </div>
    <div class="dock" data-plugins>
        <ol class="rail" role="tablist" aria-label="Plugins">
            {plugins.map((plugin, index) => (
                <li>
                    <button type="button" role="tab" id={`plugin-tab-${plugin.id}`} aria-selected={index === 0 ? "true" : "false"} aria-controls={`plugin-${plugin.id}`}>
                        <span class="mark"><Icon name={plugin.icon} size={18} /></span>
                        <span class="words">
                            <span class="name">{plugin.name}</span>
                            <span class="claim">{plugin.claim}</span>
                        </span>
                        <span class="meter" aria-hidden="true"></span>
                    </button>
                </li>
            ))}
        </ol>
        <div class="window">
            <div class="bar">
                <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="title" data-plugin-title>{plugins[0].name}</span>
            </div>
            <div class="stage">
                {plugins.map((plugin, index) => (
                    <figure id={`plugin-${plugin.id}`} role="tabpanel" aria-labelledby={`plugin-tab-${plugin.id}`} class:list={{ on: index === 0 }}>
                        <div class="shot">
                            <Image src={plugin.image} alt={plugin.alt} format="avif" quality={80} widths={[880, 1320, 1760]} sizes="(min-width: 1240px) 880px, 100vw" />
                        </div>
                        <figcaption>
                            {plugin.points.map((point) => <span>{point}</span>)}
                        </figcaption>
                    </figure>
                ))}
            </div>
        </div>
    </div>
    <p class="also">
        <span class="label">Also built in</span>
        {extras.map((extra) => (
            <span class="chip"><Icon name={extra.icon} size={15} />{extra.name}</span>
        ))}
    </p>
</div>
</section>

<script>
    for (const dock of document.querySelectorAll<HTMLElement>("[data-plugins]")) {
        const tabs = [...dock.querySelectorAll<HTMLButtonElement>("[role=tab]")];
        const panels = [...dock.querySelectorAll<HTMLElement>("[role=tabpanel]")];
        const title = dock.querySelector<HTMLElement>("[data-plugin-title]")!;
        const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
        let current = 0;
        let timer = 0;

        const show = (index: number) => {
            current = index;
            tabs.forEach((tab, i) => tab.setAttribute("aria-selected", String(i === index)));
            panels.forEach((panel, i) => panel.classList.toggle("on", i === index));
            title.textContent = tabs[index].querySelector(".name")!.textContent;
        };
        const play = () => {
            if (still) return;
            clearInterval(timer);
            dock.dataset.playing = "";
            timer = window.setInterval(() => show((current + 1) % tabs.length), 6000);
        };
        const stop = () => {
            clearInterval(timer);
            delete dock.dataset.playing;
        };

        tabs.forEach((tab, index) =>
            tab.addEventListener("click", () => {
                show(index);
                stop();
            }),
        );
        new IntersectionObserver(([entry]) => (entry.isIntersecting ? play() : stop()), { threshold: 0.4 }).observe(dock);
    }
</script>

<style>
    .head {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 360px);
        align-items: end;
        gap: 40px;
        margin-bottom: 48px;
    }

    .head .section-head {
        margin-bottom: 0;
    }

    .lede {
        font-size: 16px;
        line-height: 1.6;
        color: var(--text-secondary);
    }

    .dock {
        display: grid;
        grid-template-columns: 300px minmax(0, 1fr);
        gap: 20px;
        align-items: start;
    }

    .rail {
        display: grid;
        gap: 2px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .rail button {
        position: relative;
        display: grid;
        grid-template-columns: 36px minmax(0, 1fr);
        gap: 14px;
        align-items: start;
        width: 100%;
        padding: 12px;
        border: 1px solid transparent;
        border-radius: var(--radius-3);
        background: none;
        color: inherit;
        font: inherit;
        text-align: left;
        cursor: pointer;
        overflow: hidden;
        transition:
            background var(--dur-1) var(--ease-out),
            border-color var(--dur-1) var(--ease-out);
    }

    .rail button:hover {
        background: var(--surface-hover);
    }

    .rail button[aria-selected="true"] {
        border-color: var(--border);
        background: var(--surface-raised);
    }

    .mark {
        display: grid;
        place-items: center;
        width: 36px;
        height: 36px;
        border: 1px solid var(--border);
        border-radius: var(--radius-2);
        background: var(--surface-sunken);
        color: var(--text-primary);
    }

    .words {
        display: grid;
        gap: 2px;
        padding-top: 7px;
    }

    .name {
        font-size: 15px;
        line-height: 22px;
        font-weight: 500;
        color: var(--text-secondary);
    }

    [aria-selected="true"] .name {
        color: var(--text-primary);
    }

    .claim {
        display: none;
        font-size: 13px;
        line-height: 1.45;
        color: var(--text-tertiary);
    }

    [aria-selected="true"] .claim {
        display: block;
    }

    .meter {
        position: absolute;
        inset: auto 12px 0;
        height: 1px;
        background: var(--acc);
        transform: scaleX(0);
        transform-origin: left;
    }

    [data-playing] [aria-selected="true"] .meter {
        animation: fill 6s linear forwards;
    }

    @keyframes fill {
        to {
            transform: scaleX(1);
        }
    }

    .window {
        border: 1px solid var(--border);
        border-radius: var(--radius-4);
        background: var(--surface-sunken);
        overflow: hidden;
    }

    .bar {
        display: flex;
        align-items: center;
        gap: 14px;
        height: 36px;
        padding-inline: 14px;
        border-bottom: 1px solid var(--border);
    }

    .dots {
        display: flex;
        gap: 6px;
    }

    .dots i {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--gray-400);
    }

    .title {
        font-family: var(--mono);
        font-size: 12px;
        color: var(--text-tertiary);
    }

    .stage {
        display: grid;
    }

    figure {
        grid-area: 1 / 1;
        margin: 0;
        opacity: 0;
        visibility: hidden;
        transition:
            opacity 200ms var(--ease-out),
            visibility 0s 200ms;
    }

    figure.on {
        opacity: 1;
        visibility: visible;
        transition: opacity 200ms var(--ease-out);
    }

    .shot {
        aspect-ratio: 2880 / 1840;
        overflow: hidden;
    }

    .shot img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top left;
    }

    figcaption {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 22px;
        padding: 14px 18px;
        border-top: 1px solid var(--border);
        font-family: var(--mono);
        font-size: 12px;
        color: var(--text-tertiary);
    }

    figcaption span::before {
        content: "→ ";
        color: var(--acc);
    }

    .also {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        margin-top: 28px;
    }

    .also .label {
        margin-right: 8px;
    }

    .chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        height: 32px;
        padding-inline: 12px;
        border: 1px solid var(--border);
        border-radius: var(--radius-2);
        font-size: 13px;
        color: var(--text-secondary);
    }

    @media (max-width: 900px) {
        .head,
        .dock {
            grid-template-columns: minmax(0, 1fr);
        }

        .rail {
            grid-auto-flow: column;
            grid-auto-columns: max-content;
            overflow-x: auto;
        }

        .rail .claim,
        .rail .meter {
            display: none;
        }
    }
</style>
