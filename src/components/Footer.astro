---
import Logo from "./Logo.astro";
import { AGENTS, agentPath } from "../lib/agents";
import { COMPARISONS, comparisonPath } from "../lib/comparisons";
import { DISCORD_URL, REPO_URL, X_URL } from "../lib/release";

const columns = [
    { title: "Agents", links: [...AGENTS.map((agent) => ({ label: agent.name, href: agentPath(agent) })), { label: "All agents", href: "/agents" }] },
    { title: "Compare", links: [...COMPARISONS.map((comparison) => ({ label: `vs ${comparison.name}`, href: comparisonPath(comparison) })), { label: "All comparisons", href: "/vs" }] },
    {
        title: "Sikemux",
        links: [
            { label: "Features", href: "/#features" },
            { label: "Phone app", href: "/phone" },
            { label: "Changelog", href: "/changelog" },
            { label: "Brand", href: "/brand" },
            { label: "Docs", href: "https://docs.sikemux.com" },
            { label: "GitHub", href: REPO_URL },
            { label: "Discord", href: DISCORD_URL },
            { label: "X", href: X_URL },
        ],
    },
    {
        title: "Legal",
        links: [
            { label: "Privacy", href: "/privacy" },
            { label: "Terms", href: "/terms" },
            { label: "License", href: `${REPO_URL}/blob/main/LICENSE` },
        ],
    },
];
---

<footer class="footer">
    <div class="page top">
    <div class="about">
        <a class="home" href="/" aria-label="Sikemux home">
            <span class="mark"><Logo size={16} /></span>
            Sikemux
        </a>
        <p class="pitch">The IDE for you and your coding agents. Claude Code, Codex and the rest, with your shell, browser, logs and deploys in one window.</p>
    </div>
    <nav class="columns" aria-label="Footer">
        {
            columns.map((column) => (
                <div class="column">
                    <p class="label">{column.title}</p>
                    <ul>
                        {column.links.map((link) => (
                            <li>
                                <a href={link.href}>{link.label}</a>
                            </li>
                        ))}
                    </ul>
                </div>
            ))
        }
    </nav>
    </div>
    <div class="page row">
        <span class="brand">
            <Logo size={14} />
            <span class="mono"><code>sike</code> + <code>mux</code>, built by <a href="https://github.com/nodelike">@nodelike</a></span>
        </span>
    </div>
</footer>

<style>
    .footer {
        border-top: 1px solid var(--border);
    }

    .top {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
        gap: clamp(32px, 6vw, 96px);
        padding-block: 64px 16px;
    }

    .about {
        display: grid;
        align-content: start;
        gap: 20px;
    }

    .home {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        width: fit-content;
        font-size: 17px;
        font-weight: 600;
        color: var(--text-primary);
    }

    .mark {
        display: grid;
        place-items: center;
        color: var(--acc);
    }

    .pitch {
        max-width: 22ch;
        font-size: clamp(22px, 2.2vw, 28px);
        line-height: 1.2;
        letter-spacing: -0.025em;
        color: var(--text-primary);
    }

    .columns {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 32px;
    }

    .column {
        display: grid;
        align-content: start;
        gap: 14px;
    }

    ul {
        display: grid;
        gap: 8px;
        margin: 0;
        padding: 0;
        list-style: none;
        font-size: 14px;
    }

    a {
        color: var(--text-secondary);
        transition: color var(--dur-2) var(--ease-out);
    }

    a:hover {
        color: var(--text-primary);
    }

    .row {
        padding-block: 28px;
        font-size: 13px;
        color: var(--text-tertiary);
    }

    .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

    .brand .mono {
        font-size: 12px;
    }

    .brand code {
        font-size: inherit;
        color: var(--text-secondary);
    }

    .brand a {
        text-decoration: underline;
        text-decoration-color: var(--border-strong);
        text-underline-offset: 3px;
    }

    @media (max-width: 860px) {
        .top {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    @media (max-width: 720px) {
        .columns {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
</style>
