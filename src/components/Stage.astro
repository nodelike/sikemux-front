---
import { Image } from "astro:assets";
import hero from "../assets/shots/hero.png";
import editor from "../assets/shots/files-editor.png";
import terminals from "../assets/shots/terminals-stage.png";
import git from "../assets/shots/git-stage.png";

const views = [
    {
        id: "agents",
        label: "Work with agents",
        image: hero,
        alt: "A Claude Code agent fixing a bug, with the pull request it opened shown in its own browser tab",
    },
    {
        id: "review",
        label: "Review and ship",
        image: git,
        alt: "The changed files and a commit message the agent wrote, ready to commit and push",
    },
    { id: "code", label: "Edit code", image: editor, alt: "The code editor with the project's files on the left" },
    { id: "terminal", label: "Run terminals", image: terminals, alt: "Terminals side by side running a dev server and the tests" },
] as const;
---

<div class="stage-tabs" data-stage>
    <div class="tabs" role="tablist" aria-label="What you can do in Sikemux">
        {
            views.map((view, index) => (
                <button type="button" role="tab" id={`stage-tab-${view.id}`} aria-controls={`stage-${view.id}`} aria-selected={index === 0 ? "true" : "false"}>
                    {view.label}
                </button>
            ))
        }
    </div>
    <figure class="stage">
        {
            views.map((view, index) => (
                <div class="view" role="tabpanel" id={`stage-${view.id}`} aria-labelledby={`stage-tab-${view.id}`} hidden={index !== 0}>
                    <Image
                        src={view.image}
                        alt={view.alt}
                        format="avif"
                        quality={80}
                        widths={[1280, 1920, 2560]}
                        sizes="(min-width: 1240px) 1200px, 100vw"
                        loading={index === 0 ? "eager" : "lazy"}
                        fetchpriority={index === 0 ? "high" : "auto"}
                    />
                </div>
            ))
        }
    </figure>
</div>

<script>
    for (const stage of document.querySelectorAll<HTMLElement>("[data-stage]")) {
        const tabs = [...stage.querySelectorAll<HTMLButtonElement>("[role=tab]")];
        for (const tab of tabs) {
            tab.addEventListener("click", () => {
                for (const other of tabs) {
                    const selected = other === tab;
                    other.setAttribute("aria-selected", String(selected));
                    const panel = stage.querySelector<HTMLElement>(`#${other.getAttribute("aria-controls")}`);
                    if (panel) panel.hidden = !selected;
                }
            });
        }
    }
</script>

<style>
    .stage-tabs {
        display: grid;
        gap: 16px;
    }

    .tabs {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 6px;
    }

    .tabs button {
        height: 36px;
        padding-inline: 14px;
        border: 1px solid var(--border);
        border-radius: var(--radius-2);
        background: var(--surface);
        color: var(--text-secondary);
        font: inherit;
        font-size: 14px;
        cursor: pointer;
        transition:
            border-color var(--dur-2) var(--ease-out),
            color var(--dur-2) var(--ease-out);
    }

    .tabs button:hover {
        color: var(--text-primary);
    }

    .tabs button[aria-selected="true"] {
        border-color: var(--border-selected);
        background: var(--surface-selected);
        color: var(--text-primary);
    }

    .stage {
        margin: 0;
        aspect-ratio: 16 / 10;
        border: 1px solid var(--border);
        border-radius: var(--radius-3);
        overflow: hidden;
        background: var(--surface-sunken);
    }

    .view,
    .view :global(img) {
        width: 100%;
        height: 100%;
    }

    .view :global(img) {
        object-fit: cover;
        object-position: top left;
    }

    @media (max-width: 560px) {
        .tabs button {
            height: 32px;
            padding-inline: 10px;
            font-size: 13px;
        }
    }
</style>
