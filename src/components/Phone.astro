---
import { Image } from "astro:assets";
import agents from "../assets/phone/phone-device.png";
import chat from "../assets/phone/phone-asking.png";
import { DISCORD_URL } from "../lib/release";

const points = [
    "See what every agent is doing, and get a notification when one needs you",
    "Allow or deny what an agent asks, right from the notification",
    "Start, resume and steer chats in any project, and send photos and files",
    "Connected end to end encrypted, and each phone approved once on your computer",
];
---

<section class="section" id="phone">
    <div class="page layout">
        <div class="section-head">
            <p class="label">New in 0.5 · Phone app</p>
            <h2>Close the laptop. Your agents keep going.</h2>
            <p>
                Your agents keep running on your computer after you walk away. The Sikemux phone app lets you check on them, answer them and
                start new ones from wherever you are.
            </p>
            <ul class="points">{points.map((point) => <li>{point}</li>)}</ul>
            <div class="get">
                <a class="btn primary" href="/phone">Get it for Android</a>
                <span class="soon">Android is in testing on Google Play. iPhone is coming soon; <a href={DISCORD_URL}>join the Discord</a> to hear first.</span>
            </div>
        </div>
        <div class="phones">
            <figure class="phone">
                <Image src={agents} alt="The phone app on a MacBook Pro: one agent asking to run a command, three open chats and recent ones" widths={[300, 600]} sizes="300px" />
            </figure>
            <figure class="phone back">
                <Image src={chat} alt="The phone app with an agent asking permission to run the tests" widths={[300, 600]} sizes="300px" />
            </figure>
        </div>
    </div>
</section>

<style>
    .layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        align-items: center;
        gap: clamp(32px, 6vw, 96px);
    }

    .layout .section-head {
        margin-bottom: 0;
    }

    .points {
        display: grid;
        gap: 10px;
        margin: 8px 0 0;
        padding: 0;
        list-style: none;
    }

    .points li {
        position: relative;
        padding-left: 26px;
        font-size: 15px;
        color: var(--text-secondary);
    }

    .points li::before {
        content: "✓";
        position: absolute;
        left: 0;
        color: var(--live);
    }

    .get {
        display: grid;
        justify-items: start;
        gap: 12px;
        margin-top: 10px;
    }

    .primary {
        border-color: color-mix(in oklab, var(--acc) 70%, var(--bg-dim));
        background: var(--acc);
        color: var(--on-accent);
        font-weight: 600;
    }

    .primary:hover {
        background: color-mix(in oklab, var(--acc) 88%, var(--ink));
    }

    .soon {
        font-size: 14px;
        color: var(--text-tertiary);
    }

    .soon a {
        color: var(--text-secondary);
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    .phones {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        gap: clamp(16px, 2.5vw, 28px);
    }

    /* A titanium edge, then a thin black bezel, around a screen with iOS's own corners. */
    .phone {
        flex: none;
        width: min(44%, 250px);
        margin: 0;
        padding: 4px;
        border-radius: 15.6% / 7.2%;
        background: #050507;
        box-shadow:
            0 0 0 1px #3b3b42,
            0 40px 80px -30px rgba(0, 0, 0, 0.8);
    }

    .phone :global(img) {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 402 / 874;
        border-radius: 14.7% / 6.8%;
    }

    .back {
        transform: translateY(56px);
    }

    @media (max-width: 860px) {
        .layout {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
