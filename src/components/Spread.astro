---
import Kbd from "./Kbd.astro";
import Icon from "./Icon.astro";

const rows = [
    { before: "VS Code, for reading the code", keys: "⌥1", icon: "editor", after: "Files" },
    { before: "iTerm, three tabs deep", keys: "⌥2", icon: "command", after: "Term" },
    { before: "lazygit in another split", keys: "⌥3", icon: "git", after: "Git" },
    { before: "claude, in a tab you forgot about", keys: "⌥4", icon: "agent", after: "Agents" },
    { before: "Chrome, for localhost and the docs", keys: "⌘T", icon: "globe", after: "Browser" },
    { before: "The AWS console, signed out again", keys: "⌥A", icon: "aws", after: "AWS" },
    { before: "Bruno, somewhere in the dock", keys: "⌥B", icon: "bruno", after: "Bruno" },
] as const;

const facts = [
    { icon: "shield", title: "Your CLI. Your login.", body: "Sikemux bundles no model and needs no API key. It starts the agent CLI you already installed." },
    { icon: "command", title: "Native shells", body: "Every terminal is a Rust PTY. No Electron, no bundled Chromium." },
    { icon: "globe", title: "A browser per agent", body: "Each agent gets its own tab that keeps its sign-ins, and you can take over." },
    { icon: "plug", title: "Tools over MCP", body: "Agents start your tasks, read their output and open files in your editor." },
] as const;
---

<section class="section">
    <div class="page layout">
        <div class="section-head">
            <p class="label">Why it exists</p>
            <h2>You already run this setup. It's just spread over seven apps.</h2>
            <p>
                Every one of those windows is pointed at the same repo, and none of them know it. In Sikemux they are views of one project, so
                they open where you are and close when you are done.
            </p>
        </div>
        <div class="table" role="table" aria-label="The apps Sikemux replaces, and the key that opens each view">
            <div class="head" role="row">
                <span role="columnheader" class="label">Before</span>
                <span role="columnheader" class="label">In Sikemux</span>
            </div>
            {
                rows.map((row) => (
                    <div class="line" role="row">
                        <span role="cell" class="before">
                            {row.before}
                        </span>
                        <span class="arrow" aria-hidden="true">→</span>
                        <span role="cell" class="after">
                            <Kbd keys={row.keys} />
                            <span class="view">
                                <Icon name={row.icon} size={15} />
                                {row.after}
                            </span>
                        </span>
                    </div>
                ))
            }
        </div>
    </div>
    <div class="page">
        <ul class="facts">
            {
                facts.map((fact) => (
                    <li>
                        <span class="fact-icon">
                            <Icon name={fact.icon} size={16} />
                        </span>
                        <strong>{fact.title}</strong>
                        <p>{fact.body}</p>
                    </li>
                ))
            }
        </ul>
    </div>
</section>

<style>
    .layout {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
        align-items: start;
        gap: clamp(32px, 5vw, 72px);
    }

    .layout .section-head {
        position: sticky;
        top: 96px;
        margin-bottom: 0;
    }

    .table {
        border: 1px solid var(--border);
        border-radius: var(--radius-4);
        overflow: hidden;
        background: var(--surface);
    }

    .head,
    .line {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 28px minmax(0, 0.8fr);
        align-items: center;
    }

    .head {
        padding: 14px 22px;
        border-bottom: 1px solid var(--border);
    }

    .head span:last-child {
        grid-column: 3;
    }

    .line {
        min-height: 56px;
        padding-inline: 22px;
        transition: background var(--dur-1) var(--ease-out);
    }

    .line + .line {
        border-top: 1px solid var(--gray-200);
    }

    .line:hover {
        background: var(--surface-hover);
    }

    .before {
        font-family: var(--mono);
        font-size: 13px;
        color: var(--text-tertiary);
    }

    .arrow {
        color: var(--gray-500);
        font-size: 14px;
    }

    .after {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-size: 15px;
        font-weight: 500;
        color: var(--text-primary);
    }

    .view {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .view :global(svg),
    .view :global(img) {
        color: var(--text-tertiary);
    }

    .after :global(kbd) {
        min-width: 34px;
    }

    .facts {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin: clamp(48px, 7vw, 88px) 0 0;
        padding: 0;
        list-style: none;
    }

    .facts li {
        display: grid;
        gap: 8px;
        align-content: start;
        padding: 20px;
        border: 1px solid var(--border);
        border-radius: var(--radius-3);
        background: linear-gradient(to bottom, var(--surface), transparent);
    }

    .fact-icon {
        display: grid;
        place-items: center;
        width: 32px;
        height: 32px;
        margin-bottom: 6px;
        border: 1px solid var(--border);
        border-radius: var(--radius-2);
        color: var(--text-primary);
    }

    .facts strong {
        font-size: 15px;
        font-weight: 600;
        color: var(--text-primary);
    }

    .facts p {
        font-size: 14px;
        line-height: 1.5;
    }

    @media (max-width: 960px) {
        .layout {
            grid-template-columns: minmax(0, 1fr);
        }

        .layout .section-head {
            position: static;
        }

        .facts {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 560px) {
        .facts {
            grid-template-columns: minmax(0, 1fr);
        }

        .before {
            font-size: 12px;
        }
    }
</style>
