---
import { Image } from "astro:assets";
import Band from "./Band.astro";
import art from "../assets/art/size-plane.jpg";
import { formatSize, type Release } from "../lib/release";
import { COMPARISONS, comparisonPath } from "../lib/comparisons";
import sikemuxIcon from "../assets/apps/sikemux.png";
import ghosttyIcon from "../assets/apps/ghostty.png";
import zedIcon from "../assets/apps/zed.png";
import cursorIcon from "../assets/apps/cursor.png";
import warpIcon from "../assets/apps/warp.png";
import supersetIcon from "../assets/apps/superset.png";

interface Props {
    release: Release;
}

const { release } = Astro.props;

const others = [
    { name: "Ghostty", icon: ghosttyIcon, bytes: 33_808_867 },
    { name: "Zed", icon: zedIcon, bytes: 122_610_677 },
    { name: "Cursor", icon: cursorIcon, bytes: 291_841_306 },
    { name: "Warp", icon: warpIcon, bytes: 334_774_677 },
    { name: "Superset", icon: supersetIcon, bytes: 453_107_779 },
];

const versus = (name: string) => {
    const comparison = COMPARISONS.find((other) => other.name === name);
    return comparison && comparisonPath(comparison);
};

const largest = Math.max(...others.map((app) => app.bytes));
const own = release.dmgBytes;
const byName = (name: string) => others.find((app) => app.name === name)!.bytes;
const facts =
    own === null
        ? []
        : [
              { figure: `${Math.round(byName("Superset") / own)}×`, text: "smaller than Superset" },
              { figure: `${Math.round(byName("Cursor") / own)}×`, text: "smaller than Cursor" },
              { figure: `${Math.round((1 - own / byName("Ghostty")) * 100)}%`, text: "smaller than Ghostty, which is only a terminal" },
          ];
const bar = (bytes: number) => `--share: ${Math.max(bytes / largest, 0.004)}`;
---

<section class="price" id="size">
    <Band art={art} label="Size" focus="center 55%">
        <Fragment slot="title"><em data-release-size>{release.dmgBytes === null ? "25 MB" : formatSize(release.dmgBytes)}</em><br />to download.</Fragment>
        <Fragment slot="lede">
            Sikemux is drawn natively on the GPU, and its browser tabs use the WebKit already built into macOS instead of shipping a browser of its own, so the whole
            IDE downloads smaller than Ghostty, which is only a terminal.
        </Fragment>
        <div class="chart" data-reveal>
            {
                facts.length > 0 && (
                    <dl class="facts">
                        {facts.map((fact) => (
                            <div>
                                <dt>{fact.figure}</dt>
                                <dd>{fact.text}</dd>
                            </div>
                        ))}
                    </dl>
                )
            }
            <ol class="rows" data-largest={largest}>
                <li class="own">
                    <Image class="icon" src={sikemuxIcon} alt="" width={32} densities={[2, 3]} format="webp" />
                    <span class="name">Sikemux</span>
                    <span class="track"><span class="fill" data-release-bar style={own === null ? undefined : bar(own)}></span></span>
                    <span class="value" data-release-size>{own === null ? "" : formatSize(own)}</span>
                </li>
                {
                    others.map((app) => (
                        <li>
                            <Image class="icon" src={app.icon} alt="" width={32} densities={[2, 3]} format="webp" />
                            {versus(app.name) ? (
                                <a class="name" href={versus(app.name)} aria-label={`Sikemux vs ${app.name}`}>
                                    {app.name}
                                </a>
                            ) : (
                                <span class="name">{app.name}</span>
                            )}
                            <span class="track">
                                <span class="fill" style={bar(app.bytes)} />
                            </span>
                            <span class="value">{formatSize(app.bytes)}</span>
                        </li>
                    ))
                }
            </ol>
            <p class="note">Apple Silicon installers from each project's own download link, checked 27 September 2026. Sikemux's row follows the latest release.</p>
        </div>
    </Band>
</section>

<style>
    .price {
        padding-block: 0 clamp(24px, 3vw, 40px);
    }

    .chart {
        display: grid;
        border: 1px solid var(--border);
        border-radius: var(--radius-4);
        background: linear-gradient(to bottom, var(--gray-100), var(--surface-sunken));
        overflow: hidden;
    }

    .facts {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin: 0;
        border-bottom: 1px solid var(--border);
    }

    .facts > div {
        display: grid;
        gap: 6px;
        padding: clamp(20px, 2.6vw, 32px);
    }

    .facts > div + div {
        border-left: 1px solid var(--border);
    }

    dt {
        font-family: var(--serif);
        font-size: clamp(44px, 5vw, 64px);
        line-height: 0.95;
        color: var(--acc-soft);
    }

    dd {
        margin: 0;
        max-width: 26ch;
        font-size: 14px;
        color: var(--text-tertiary);
    }

    .rows {
        display: grid;
        gap: 4px;
        margin: 0;
        padding: clamp(14px, 2vw, 24px);
        list-style: none;
    }

    li {
        display: grid;
        grid-template-columns: 32px 110px minmax(0, 1fr) 96px;
        align-items: center;
        column-gap: 16px;
        padding: 10px 14px;
        border: 1px solid transparent;
        border-radius: var(--radius-3);
        font-size: 15px;
        color: var(--text-secondary);
    }

    li :global(.icon) {
        width: 32px;
        height: 32px;
    }

    a.name {
        justify-self: start;
        text-decoration: underline;
        text-decoration-color: var(--border-strong);
        text-underline-offset: 3px;
        transition: text-decoration-color var(--dur-2) var(--ease-out);
    }

    a.name:hover {
        text-decoration-color: currentColor;
    }

    .value {
        font-family: var(--serif);
        font-size: 24px;
        line-height: 1;
        text-align: right;
        color: var(--text-tertiary);
    }

    .track {
        height: 10px;
        border-radius: 999px;
        background: color-mix(in oklab, var(--ink) 6%, transparent);
    }

    .fill {
        display: block;
        width: calc(var(--share) * 100%);
        min-width: 10px;
        height: 100%;
        border-radius: inherit;
        background: var(--gray-500);
    }

    .own {
        border-color: var(--border-selected);
        background: var(--surface-selected);
        color: var(--text-primary);
    }

    .own .value {
        color: var(--acc-soft);
    }

    .own .fill {
        background: var(--acc);
        box-shadow: 0 0 14px color-mix(in oklab, var(--acc) 70%, transparent);
    }

    .note {
        padding: 0 clamp(14px, 2vw, 24px) clamp(16px, 2vw, 22px) calc(clamp(14px, 2vw, 24px) + 14px);
        font-size: 12.5px;
        color: var(--text-tertiary);
    }

    @media (max-width: 720px) {
        .facts {
            grid-template-columns: minmax(0, 1fr);
        }

        .facts > div + div {
            border-left: 0;
            border-top: 1px solid var(--border);
        }

        li {
            grid-template-columns: 28px minmax(0, 1fr) auto;
            grid-template-areas:
                "icon name value"
                "icon track track";
            row-gap: 8px;
            column-gap: 12px;
        }

        li :global(.icon) {
            grid-area: icon;
            width: 28px;
            height: 28px;
        }

        .name {
            grid-area: name;
        }

        .track {
            grid-area: track;
        }

        .value {
            grid-area: value;
            font-size: 20px;
        }
    }
</style>
