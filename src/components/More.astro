---
import { Image } from "astro:assets";
import allAgents from "../assets/shots/agents-all-projects-rail.png";
import spaces from "../assets/cards/spaces.png";
import deck from "../assets/cards/deck.png";
import splits from "../assets/cards/splits.png";
import ssh from "../assets/cards/ssh.png";
import tools from "../assets/cards/tools.png";
import limits from "../assets/cards/limits.png";
import simulator from "../assets/cards/simulator.png";
import VisualsDemo from "./VisualsDemo.astro";

const groups = [
    {
        title: "Keep track of your agents",
        line: "However many are running, and in whichever project.",
        cards: [
            {
                title: "Every agent in one list",
                body: "Agents from all your open projects, sorted into needs you, working and done. Click one to jump to it.",
                image: allAgents,
                alt: "The agent rail listing chats from several projects",
                fit: "rail",
                hint: "⌘ ⇧ N",
            },
            {
                title: "Several Claude or Codex accounts",
                body: "Add each account and see how much of its five-hour and weekly limit is left. Switch in a click, or let a chat move on when one runs out.",
                image: limits,
                alt: "The account picker open on Work, Personal at 82% used and Client at 9% used, above Work's five-hour and weekly limits",
                fit: "contain",
            },
            {
                title: "Agents can use the app too",
                body: "An agent can open the browser, start your dev server, query the database read-only, and read Jira issues and SigNoz logs without asking you to.",
                image: tools,
                alt: "Nine tool calls: reading a Jira issue and SigNoz logs, starting the dev task, opening, clicking and screenshotting checkout, then commenting on and moving the issue",
            },
        ],
    },
    {
        title: "Work from the keyboard",
        line: "Everything has a shortcut, and you can change any of them.",
        cards: [
            {
                title: "Run any action by name",
                body: "One search for every command. It also finds your project's dev, test and check tasks, for you and your agents.",
                image: deck,
                alt: "The command deck listing a project's actions and tasks",
                hint: "⌘ ⇧ P",
            },
            {
                title: "A shortcut for everything",
                body: "New agent, new terminal, open a file, show the agent's desk. Rebind any of them in Settings.",
                shortcuts: [
                    ["⌘ N", "New agent"],
                    ["⌘ T", "New terminal"],
                    ["⌘ P", "Open file"],
                    ["⌘ J", "Agent's desk"],
                ],
            },
            {
                title: "Open it from your shell",
                body: "Open a folder or a file at a line, or make Sikemux the editor Git opens for commit messages.",
                terminal: ["sikemux .", "sikemux src/App.tsx:42", "EDITOR=sikemux-editor git commit"],
            },
        ],
    },
    {
        title: "Set up projects and servers",
        line: "For when you juggle several repos, clients or machines.",
        cards: [
            {
                title: "Group projects by team or client",
                body: "Put projects in spaces like Work and Personal. Pick a space and the sidebar shows only its projects.",
                image: spaces,
                alt: "The project rail with All, Acme and Personal spaces, and the sikemux project open on its files, terminals, Git, agents and search",
                fit: "contain",
            },
            {
                title: "Split terminals side by side",
                body: "Drag a tab to put it beside, above or below another, so the dev server, tests and git share one screen.",
                image: splits,
                alt: "Three terminals side by side running a dev server, tests and git",
                fit: "contain",
                hint: "⌘ D",
            },
            {
                title: "A terminal on any server",
                body: "Hosts from your ~/.ssh/config show up in the sidebar. Click one to open a shell on it.",
                image: ssh,
                alt: "Two SSH hosts in the rail above the plugins",
                fit: "contain",
                hint: "⌘ ⇧ S",
            },
        ],
    },
] as const;
---

<section class="section" id="more">
    <div class="page">
        <div class="section-head">
            <p class="label">And more</p>
            <h2>The everyday details.</h2>
            <p>Smaller features you'll use all day, grouped by the job they do.</p>
        </div>
        <div class="featured">
            <article class="feature">
                <div class="feature-shot">
                    <Image
                        src={simulator}
                        alt="An agent's chat beside an iPhone 18 Pro Simulator on its desk: it built the app, installed it, tapped through and is taking a screenshot"
                        width={Math.round(simulator.width / 2)}
                        densities={[1, 2]}
                        format="webp"
                        quality={90}
                    />
                </div>
                <div class="feature-text">
                    <p class="kicker">iOS Simulator</p>
                    <h3>Agents test your iPhone app, right beside the chat.</h3>
                    <p>The agent builds your app, installs it on a real iOS Simulator on its desk, then taps, types and takes screenshots to check its own work. You see every tap, and can pick up the device yourself.</p>
                </div>
            </article>
            <article class="feature">
                <div class="feature-shot">
                    <VisualsDemo />
                </div>
                <div class="feature-text">
                    <p class="kicker">Visual answers</p>
                    <h3>When words aren't enough, the agent draws.</h3>
                    <p>A diagram of how your services talk, a chart from production data, mockups to pick from before any code. Built from your code, logs and data, and shown right in the chat.</p>
                </div>
            </article>
        </div>
        {
            groups.map((group) => (
                <div class="group">
                    <div class="group-head">
                        <h3>{group.title}</h3>
                        <p>{group.line}</p>
                    </div>
                    <ul class:list={["cards", `of-${group.cards.length}`]}>
                        {group.cards.map((card) => (
                            <li>
                                <figure class:list={["visual", "fit" in card && card.fit]}>
                                    {"image" in card && (
                                        <button type="button" class="zoom" data-zoom={card.image.src} data-alt={card.alt} aria-label={`Show larger: ${card.alt}`}>
                                            <Image src={card.image} alt={card.alt} width={Math.round(card.image.width / 2)} densities={[1, 2]} format="webp" quality={95} />
                                        </button>
                                    )}
                                    {"terminal" in card && (
                                        <div class="term mono">
                                            {card.terminal.map((line) => (
                                                <span>
                                                    <b>❯</b> {line}
                                                </span>
                                            ))}
                                        </div>
                                    )}
                                    {"shortcuts" in card && (
                                        <dl class="keys">
                                            {card.shortcuts.map(([keys, action]) => (
                                                <div>
                                                    <dt>{keys}</dt>
                                                    <dd>{action}</dd>
                                                </div>
                                            ))}
                                        </dl>
                                    )}
                                    {"hint" in card && <span class="badge">{card.hint}</span>}
                                </figure>
                                <h4>{card.title}</h4>
                                <p>{card.body}</p>
                            </li>
                        ))}
                    </ul>
                </div>
            ))
        }
    </div>
    <dialog class="lightbox" data-lightbox>
        <form method="dialog">
            <button class="close" aria-label="Close">✕</button>
        </form>
        <img alt="" />
    </dialog>
</section>

<script>
    const lightbox = document.querySelector<HTMLDialogElement>("[data-lightbox]");
    const picture = lightbox?.querySelector("img");
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-zoom]")) {
        button.addEventListener("click", () => {
            if (!lightbox || !picture) return;
            picture.src = button.dataset.zoom ?? "";
            picture.alt = button.dataset.alt ?? "";
            lightbox.showModal();
        });
    }
    lightbox?.addEventListener("click", (event) => {
        if (event.target === lightbox) lightbox.close();
    });
</script>

<style>
    .featured {
        display: grid;
        gap: 16px;
        margin-bottom: 56px;
    }

    .feature {
        display: grid;
        grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
        align-items: center;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: var(--radius-4);
        background:
            radial-gradient(80% 60% at 50% 0%, color-mix(in oklab, var(--acc) 10%, transparent), transparent 70%),
            var(--surface);
    }

    .feature-shot {
        padding: 22px;
    }

    .feature:nth-child(2) {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    }

    .feature:nth-child(2) .feature-text {
        order: -1;
    }

    .feature-shot > :global(img) {
        display: block;
        width: 100%;
        height: auto;
        border: 1px solid var(--border);
        border-radius: var(--radius-3);
    }

    .feature-text {
        display: grid;
        align-content: start;
        gap: 12px;
        padding: 28px 36px;
    }

    .kicker {
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--acc);
    }

    .feature-text h3 {
        padding: 0;
        font-size: clamp(24px, 2.6vw, 34px);
        font-weight: 500;
        line-height: 1.15;
        letter-spacing: -0.03em;
    }

    .feature-text > p:not(.kicker) {
        padding: 0;
        font-size: 15px;
        line-height: 1.6;
        color: var(--text-secondary);
    }

    @media (max-width: 900px) {
        .feature,
        .feature:nth-child(2) {
            grid-template-columns: minmax(0, 1fr);
        }

        .feature:nth-child(2) .feature-text {
            order: 0;
        }
    }

    .group + .group {
        margin-top: 56px;
    }

    .group-head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 4px 14px;
        margin-bottom: 20px;
    }

    .group-head h3 {
        font-size: 20px;
        font-weight: 500;
        letter-spacing: -0.01em;
    }

    .group-head p {
        font-size: 15px;
        color: var(--text-tertiary);
    }

    .cards {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 16px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .of-2 li {
        grid-column: span 3;
    }

    .of-3 li {
        grid-column: span 2;
    }

    li {
        display: grid;
        grid-template-rows: auto auto 1fr;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: var(--radius-4);
        background: var(--surface);
        transition: border-color var(--dur-2) var(--ease-out);
    }

    li:hover {
        border-color: var(--border-strong);
    }

    .visual {
        position: relative;
        margin: 0;
        aspect-ratio: 16 / 10;
        overflow: hidden;
        border-bottom: 1px solid var(--border);
        background:
            radial-gradient(80% 70% at 50% 0%, color-mix(in oklab, var(--acc) 10%, transparent), transparent 70%),
            var(--surface-sunken);
    }

    .zoom {
        display: block;
        width: 100%;
        height: 100%;
        padding: 0;
        border: 0;
        background: none;
        cursor: zoom-in;
    }

    .zoom :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top left;
        transition: transform 0.4s var(--ease-out);
    }

    li:hover .zoom :global(img) {
        transform: scale(1.02);
    }

    .contain .zoom,
    .rail .zoom {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 16px;
    }

    .rail .zoom {
        align-items: flex-start;
        padding-bottom: 0;
    }

    .contain .zoom :global(img),
    .rail .zoom :global(img) {
        width: auto;
        height: auto;
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
    }

    .rail .zoom :global(img) {
        max-height: none;
        mask-image: linear-gradient(to bottom, #000 80%, transparent);
        -webkit-mask-image: linear-gradient(to bottom, #000 80%, transparent);
        border: 1px solid var(--border);
        border-bottom: 0;
        border-radius: var(--radius-3) var(--radius-3) 0 0;
    }

    .badge {
        position: absolute;
        top: 12px;
        right: 12px;
        padding: 4px 10px;
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-2);
        background: color-mix(in oklab, var(--bg-dim) 85%, transparent);
        backdrop-filter: blur(6px);
        font-family: var(--kbd);
        font-size: 13px;
        letter-spacing: 0.1em;
        color: var(--text-primary);
        pointer-events: none;
    }

    .term {
        display: grid;
        align-content: center;
        gap: 12px;
        height: 100%;
        margin: 0;
        padding: 24px;
        font-size: 13px;
        color: var(--text-primary);
    }

    .term b {
        color: var(--acc);
        font-weight: 400;
    }

    .keys {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        align-content: center;
        gap: 10px;
        height: 100%;
        margin: 0;
        padding: 22px;
    }

    .keys div {
        display: grid;
        justify-items: center;
        gap: 6px;
        padding: 10px 8px;
        border: 1px solid var(--border);
        border-radius: var(--radius-3);
        background: var(--surface);
    }

    .keys dt {
        padding: 2px 8px;
        border: 1px solid var(--border-strong);
        border-bottom-width: 2px;
        border-radius: var(--radius-1);
        font-family: var(--kbd);
        font-size: 13px;
        letter-spacing: 0.08em;
        color: var(--text-primary);
    }

    .keys dd {
        margin: 0;
        font-size: 12px;
        color: var(--text-tertiary);
    }

    h4 {
        margin: 0;
        padding: 20px 22px 0;
        font-size: 16px;
        font-weight: 500;
    }

    li > p {
        padding: 8px 22px 22px;
        font-size: 14.5px;
        line-height: 1.55;
        color: var(--text-secondary);
    }

    .lightbox {
        max-width: min(92vw, 1400px);
        max-height: 90vh;
        padding: 0;
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-4);
        background: var(--surface-sunken);
        overflow: hidden;
    }

    .lightbox::backdrop {
        background: rgba(0, 0, 0, 0.72);
        backdrop-filter: blur(4px);
    }

    .lightbox img {
        display: block;
        max-width: 100%;
        max-height: 90vh;
        object-fit: contain;
    }

    .close {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 32px;
        height: 32px;
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-2);
        background: var(--surface);
        color: var(--text-primary);
        cursor: pointer;
    }

    @media (max-width: 960px) {
        .cards li {
            grid-column: span 3;
        }
    }

    @media (max-width: 600px) {
        .cards li {
            grid-column: 1 / -1;
        }
    }
</style>
