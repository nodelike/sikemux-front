---
interface Props {
    agent?: string;
}

const { agent = "Your agent" } = Astro.props;

const items = [
    { href: "/#browser", title: "Its own browser tab", body: `${agent} opens your app, clicks through it and takes screenshots in a real WebKit tab beside its chat, and you can take over at any time.` },
    { href: "/#browser", title: "A live iOS Simulator", body: `Building for iPhone? ${agent} builds your app, installs it on a Simulator on its desk, and taps and types to check its own work.` },
    { href: "/#review", title: "Review and ship", body: "See every file the agent touched before you commit. Pull requests, reviews and CI from GitHub, GitLab and Bitbucket open next to the code." },
    { href: "/#review", title: "A real code editor", body: "Go to definitions, search the whole project and review every change, without opening another app." },
    { href: "/#review", title: "Terminals that outlive the app", body: "Quit Sikemux or let it update, and the agents and terminals keep running. Open it again and everything is where you left it." },
    { href: "/#notch", title: "Answers from anywhere", body: "When an agent needs you, answer it from the MacBook notch, or from the phone app over an end to end encrypted link." },
];
---

<ul class="highlights">
    {
        items.map((item) => (
            <li>
                <a href={item.href}>
                    <h3>{item.title}</h3>
                    <p>{item.body}</p>
                </a>
            </li>
        ))
    }
</ul>

<style>
    .highlights {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        margin: 0;
        padding: 0;
        list-style: none;
        border-top: 1px solid var(--rule);
        border-left: 1px solid var(--rule);
    }
    li {
        border-right: 1px solid var(--rule);
        border-bottom: 1px solid var(--rule);
    }
    a {
        display: grid;
        height: 100%;
        align-content: start;
        gap: 8px;
        padding: 22px 20px 24px;
        text-decoration: none;
        transition: background-color 0.14s;
    }
    a:hover {
        background: var(--field);
    }
    h3 {
        font-size: 17px;
        font-weight: 500;
        letter-spacing: -0.02em;
        color: var(--ink);
    }
    a p {
        font-size: 15px;
        line-height: 1.6;
        color: var(--ink-2);
    }
    @media (max-width: 640px) {
        .highlights {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
