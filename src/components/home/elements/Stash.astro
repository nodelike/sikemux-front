---
import { Image } from "astro:assets";
import jetty from "../../../assets/art/jetty-day.jpg";
import table from "../../../assets/art/table-day.jpg";
import "../widgets/app.css";

const STACK = `<path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"/><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"/><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"/>`;
---

<div class="app part unframed dock" data-play>
    <div class="dock-tray" data-step data-wait="700">
        <div class="dock-head">
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={STACK} />
            <span class="dock-caps">STASH</span>
            <span class="dock-count">2</span>
            <i class="dock-space"></i>
            <span class="dock-link">Add 1 new</span>
            <span class="dock-link">Open Stash ↗</span>
        </div>
        <div class="dock-rows">
            <div class="dock-row picked">
                <Image class="dock-tile" src={jetty} width={88} height={88} fit="cover" position="bottom" format="webp" alt="" />
                <span class="dock-item">
                    <span class="dock-words">Dusk colours for the hero</span>
                </span>
                <span class="dock-aside">
                    <span class="dock-new">NEW</span>
                    <span>5m ago</span>
                </span>
            </div>
            <div class="dock-row">
                <Image class="dock-tile" src={table} width={88} height={88} fit="cover" position="right" format="webp" alt="" />
                <span class="dock-item">
                    <span class="dock-words">Lilac palettes, twelve examples</span>
                    <span class="dock-under">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="12" r="10"></circle>
                            <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
                            <path d="M2 12h20"></path>
                        </svg>
                        <span>example.com</span>
                    </span>
                </span>
                <span class="dock-aside">
                    <span>3h ago</span>
                </span>
            </div>
        </div>
        <div class="dock-foot">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 15V3"></path>
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <path d="m7 10 5 5 5-5"></path>
            </svg>
            <span>Stash this prompt</span>
            <i class="dock-space"></i>
            <kbd>⌘S</kbd>
        </div>
    </div>
    <div class="dock-composer">
        <p class="dock-draft">Match the hero to these colours</p>
        <div class="dock-bar">
            <span class="dock-attach">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
            </span>
            <span class="dock-button">
                <svg viewBox="0 0 24 24" aria-hidden="true" set:html={STACK} />
                <span class="dock-pill">1</span>
            </span>
            <i class="dock-space"></i>
            <span class="dock-send">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></svg>
            </span>
        </div>
    </div>
</div>

<style>
    .dock {
        display: flex;
        flex-direction: column;
        width: min(100%, 364px);
        text-align: left;
        color: var(--text-primary);
        filter: drop-shadow(0 18px 16px color-mix(in srgb, var(--violet-ink) 16%, transparent));
    }
    .dock svg {
        display: block;
        flex: none;
    }
    .dock-space {
        flex: 1;
    }
    .dock-tray {
        display: flex;
        flex-direction: column;
        margin: 0 20px;
        padding: 12px 8px;
        border: 1px solid var(--border);
        border-bottom: 0;
        border-radius: 10px 10px 0 0;
        background: var(--surface-composer);
    }
    .dock-head {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 0 6px 8px;
        font-size: 10.5px;
        white-space: nowrap;
        color: var(--text-tertiary);
    }
    .dock-head svg {
        width: 13px;
        height: 13px;
    }
    .dock-caps {
        font-weight: 600;
        letter-spacing: 0.1em;
    }
    .dock-link {
        font-size: 12px;
        font-weight: 500;
        color: var(--text-secondary);
    }
    .dock-rows {
        display: grid;
        gap: 2px;
    }
    .dock-row {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 8px;
        border-radius: 5px;
    }
    .picked {
        background: var(--surface-chosen);
    }
    .dock-tile {
        flex: none;
        width: 44px;
        height: 44px;
        border-radius: 5px;
        background: var(--surface-raised);
        object-fit: cover;
    }
    .dock-item {
        flex: 1;
        display: grid;
        gap: 2px;
        min-width: 0;
    }
    .dock-words {
        display: -webkit-box;
        overflow: hidden;
        font-size: 13px;
        line-height: 19px;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
    }
    .dock-under {
        display: flex;
        align-items: center;
        gap: 5px;
        min-width: 0;
        font-size: 11.5px;
        color: var(--text-tertiary);
    }
    .dock-under svg {
        width: 14px;
        height: 14px;
    }
    .dock-under span {
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }
    .dock-aside {
        flex: none;
        display: flex;
        align-items: center;
        gap: 6px;
        padding-top: 2px;
        font-size: 11px;
        white-space: nowrap;
        color: var(--text-tertiary);
    }
    .dock-new {
        padding: 0 5px;
        border-radius: 4px;
        background: var(--accent);
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.08em;
        color: var(--on-accent);
    }
    .dock-foot {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 8px 6px 0;
        padding-top: 9px;
        border-top: 1px solid var(--line);
        font-size: 12px;
        color: var(--text-secondary);
    }
    .dock-foot svg {
        width: 13px;
        height: 13px;
        color: var(--text-tertiary);
    }
    .dock-foot kbd {
        font: 500 11px/1 system-ui, sans-serif;
        color: var(--text-tertiary);
    }
    .dock-composer {
        padding: 8px;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: var(--surface-composer);
    }
    .dock-draft {
        min-height: 63.4px;
        margin: 0;
        padding: 2px 0;
        font-size: 14.5px;
        line-height: 1.75;
    }
    .dock-bar {
        display: flex;
        align-items: center;
        gap: 5px;
        min-height: 34px;
        padding: 8px 3px 1px;
    }
    .dock-attach {
        display: grid;
        place-items: center;
        width: 31px;
        height: 26px;
        border-radius: 5px;
        color: var(--icon-quiet);
    }
    .dock-attach svg {
        width: 17px;
        height: 17px;
    }
    .dock-button {
        display: flex;
        align-items: center;
        gap: 6px;
        height: 28px;
        padding: 0 8px;
        border-radius: 5px;
        color: var(--text-secondary);
    }
    .dock:has(.dock-tray.on) .dock-button {
        background: var(--surface-chosen);
        color: var(--text-primary);
    }
    .dock-button svg {
        width: 14px;
        height: 14px;
    }
    .dock-pill {
        display: grid;
        place-items: center;
        min-width: 16px;
        height: 16px;
        padding: 0 5px;
        border-radius: 8px;
        background: var(--accent);
        font-size: 10.5px;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        color: var(--on-accent);
    }
    .dock-send {
        display: grid;
        place-items: center;
        flex: none;
        width: 30px;
        height: 30px;
        margin-left: 3px;
        border-radius: 5px;
        background: var(--text-primary);
        color: var(--surface-sunken);
    }
    .dock-send svg {
        width: 15px;
        height: 15px;
    }
</style>
