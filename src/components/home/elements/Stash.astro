---
import Flow from "../Flow.astro";
import "../widgets/app.css";
---

<Flow class="stash" wires={[{ from: "phone", to: "tray" }]} beats={[["phone>tray"]]} pause={1700}>
    <p class="spot level">
        <span class="pin" data-node="phone">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 2h10v20H7z"></path><path d="M11 18.5h2"></path></svg>
        </span>
        <span class="words"><b>iPhone</b></span>
    </p>
    <div class="app part tray" data-node="tray">
        <p class="label">STASH</p>
        <p class="item">
            <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="9" cy="10" r="1.6"></circle><path d="m4 18 5-5 4 4 3-3 4 4"></path></svg>
            <span><b>Receipt, a cent off</b>1 photo</span>
            <i>NEW</i>
        </p>
        <p class="item">
            <svg viewBox="0 0 24 24"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"></path><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"></path></svg>
            <span><b>Checkout page</b>1 link</span>
        </p>
    </div>
</Flow>

<style>
    :global(.stash) {
        --pin-size: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 40px;
        width: min(100%, 330px);
    }
    .pin svg {
        width: 22px;
        height: 22px;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.6;
        stroke-linejoin: round;
        stroke-linecap: round;
    }
    .tray {
        flex: 1 1 0;
        display: grid;
        gap: 4px;
        min-width: 0;
        padding: 12px 8px 8px;
        text-align: left;
    }
    p {
        margin: 0;
    }
    .label {
        padding: 0 6px 4px;
        font-size: 10.5px;
        font-weight: 600;
        letter-spacing: 0.08em;
        color: var(--quiet);
    }
    .item {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 6px;
        border-radius: 8px;
    }
    .item:first-of-type {
        background: var(--hover);
    }
    .item svg {
        flex: none;
        width: 15px;
        height: 15px;
        color: var(--secondary);
    }
    .item span {
        flex: 1;
        display: grid;
        min-width: 0;
        font-size: 11px;
        color: var(--quiet);
    }
    .item b {
        overflow: hidden;
        font-size: 12.5px;
        font-weight: 500;
        white-space: nowrap;
        text-overflow: ellipsis;
        color: var(--ink);
    }
    .item i {
        font: 600 9px/1 var(--mono);
        letter-spacing: 0.06em;
        color: var(--accent);
    }
    :global(.stash .lit) .item i {
        filter: brightness(1.2);
    }
</style>
