---
interface Props {
    /** A picture of the drawing: nothing in it moves. */
    still?: boolean;
}

const { still = false } = Astro.props;
const stops = [
    { name: "Checkout", does: "saves the order" },
    { name: "Orders queue", does: "hands it on" },
    { name: "Warehouse", does: "prints the label" },
];
---

<div class:list={["drawing", { still }]}>
    {
        stops.map((stop, index) => (
            <>
                {index > 0 && <i class="hop" style={`grid-column: ${index * 2}; --order: ${index - 1}`} />}
                <b class="stop" style={`grid-column: ${index * 2 + 1}`}>
                    {stop.name}
                </b>
                <small class="does" style={`grid-column: ${index * 2 + 1}`}>
                    {stop.does}
                </small>
            </>
        ))
    }
</div>

<style>
    .drawing {
        display: grid;
        grid-template-columns: auto 1fr auto 1fr auto;
        align-items: center;
        row-gap: 7px;
        font-family: "Figtree", var(--sans);
    }
    .stop {
        grid-row: 1;
        padding: 6px 10px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--surface-raised);
        font-size: 12px;
        font-weight: 500;
        line-height: 1.3;
        color: var(--text-primary);
        white-space: nowrap;
    }
    .does {
        grid-row: 2;
        display: flex;
        justify-content: center;
        justify-self: center;
        width: 0;
        font-size: 10.5px;
        line-height: 1.3;
        color: var(--text-secondary);
        white-space: nowrap;
    }
    .hop {
        grid-row: 1;
        position: relative;
        height: 1px;
        margin: 0 5px 0 3px;
        background: var(--border-strong);
    }
    .hop::after {
        content: "";
        position: absolute;
        top: 50%;
        right: 0;
        width: 5px;
        height: 5px;
        border: solid var(--border-strong);
        border-width: 1px 1px 0 0;
        translate: 0 -50%;
        rotate: 45deg;
    }
    .hop::before {
        content: "";
        position: absolute;
        top: 50%;
        left: 0;
        width: 5px;
        height: 5px;
        margin: -2.5px 0 0 -2.5px;
        border-radius: 50%;
        background: var(--accent);
        opacity: 0;
    }
    @media (prefers-reduced-motion: no-preference) {
        .drawing:not(.still) .hop::before {
            animation: drawing-hop 2.8s cubic-bezier(0.45, 0, 0.3, 1) infinite;
            animation-delay: calc(var(--order) * 0.7s);
        }
    }
    @keyframes drawing-hop {
        0% {
            left: 0;
            opacity: 0;
        }
        6% {
            opacity: 1;
        }
        22% {
            left: 100%;
            opacity: 1;
        }
        28%,
        100% {
            left: 100%;
            opacity: 0;
        }
    }
    @media (max-width: 600px) {
        .stop {
            padding: 5px 7px;
            font-size: 11.5px;
        }
        .does {
            font-size: 10px;
        }
    }
</style>
