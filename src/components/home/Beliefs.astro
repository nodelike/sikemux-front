---
import { copyFor } from "../../i18n";

const t = copyFor(Astro.currentLocale).beliefs;
---

<section class="frame beliefs" aria-labelledby="beliefs-title">
    <div class="head">
        <span class="tag">{t.tag}</span>
        <h2 id="beliefs-title">{t.title}</h2>
    </div>
    <ol>
        {
            t.list.map((belief, index) => (
                <li>
                    <span class="n mono">{String(index + 1).padStart(2, "0")}</span>
                    <h3>{belief.title}</h3>
                    <p>{belief.body}</p>
                </li>
            ))
        }
    </ol>
</section>

<style>
    .beliefs {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.25fr);
        border-top: 1px solid var(--rule);
    }
    .head {
        position: relative;
        display: grid;
        gap: 22px;
        justify-items: start;
        align-content: space-between;
        padding: clamp(40px, 5vw, 64px) 20px;
        background: var(--violet);
        color: #120d1c;
    }
    .head .tag {
        background: #120d1c;
        color: #f4f3f7;
    }
    h2 {
        font-size: clamp(38px, 4.6vw, 68px);
        line-height: 0.98;
    }
    ol {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        border-left: 1px solid var(--rule);
    }
    li {
        display: grid;
        align-content: start;
        gap: 12px;
        padding: 26px 20px 34px;
    }
    li:nth-child(odd) {
        border-right: 1px solid var(--rule);
    }
    li:nth-child(-n + 2) {
        border-bottom: 1px solid var(--rule);
    }
    .n {
        font-size: 12px;
        color: var(--violet-ink);
    }
    h3 {
        font-size: clamp(22px, 2vw, 28px);
        line-height: 1.05;
    }
    p {
        font-size: 15px;
        line-height: 1.5;
        color: var(--ink-2);
        max-width: 26em;
    }
    @media (max-width: 900px) {
        .beliefs {
            grid-template-columns: minmax(0, 1fr);
        }
        ol {
            border-left: 0;
            border-top: 1px solid var(--rule);
        }
    }
    @media (max-width: 560px) {
        .head {
            padding: 32px 16px;
        }
        ol {
            grid-template-columns: minmax(0, 1fr);
        }
        li {
            padding: 22px 16px 26px;
        }
        li:nth-child(n) {
            border-right: 0;
            border-bottom: 1px solid var(--rule);
        }
        li:last-child {
            border-bottom: 0;
        }
    }
</style>
