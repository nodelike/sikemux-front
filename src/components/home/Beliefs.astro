---
const beliefs = [
    { title: "Your AI, your login.", body: "We don’t sell models. Sikemux runs the plan you already pay for, or free models when you have none." },
    { title: "Native, or nothing.", body: "Typing and scrolling come first, even with twenty agents streaming." },
    { title: "Agents are teammates.", body: "They get names, talk to each other and ask you only what’s yours to decide." },
    { title: "If we don’t use it, it goes.", body: "Every feature here is one we reach for daily. The rest gets cut." },
];
---

<section class="frame beliefs" aria-labelledby="beliefs-title">
    <div class="head">
        <h2 id="beliefs-title">Built by people <br /><span class="chip">who use it all day.</span></h2>
    </div>
    <ol>
        {
            beliefs.map((belief, index) => (
                <li>
                    <span class="n mono">{String(index + 1).padStart(2, "0")}</span>
                    <h3>{belief.title}</h3>
                    <p>{belief.body}</p>
                </li>
            ))
        }
    </ol>
</section>

<style>
    .beliefs {
        border-top: 1px solid var(--rule);
    }
    .head {
        padding: clamp(56px, 7vw, 96px) 20px clamp(32px, 4vw, 48px);
    }
    h2 {
        font-size: clamp(36px, 4.4vw, 64px);
    }
    ol {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        border-top: 1px solid var(--rule);
    }
    li {
        display: grid;
        align-content: start;
        gap: 12px;
        padding: 24px 20px 32px;
        border-right: 1px solid var(--rule);
    }
    li:last-child {
        border-right: 0;
    }
    .n {
        font-size: 12px;
        color: var(--ink-3);
    }
    h3 {
        font-size: clamp(20px, 1.8vw, 26px);
    }
    p {
        font-size: 14.5px;
        line-height: 1.5;
        color: var(--ink-2);
    }
    @media (max-width: 900px) {
        ol {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        li:nth-child(2) {
            border-right: 0;
        }
        li:nth-child(-n + 2) {
            border-bottom: 1px solid var(--rule);
        }
    }
    @media (max-width: 560px) {
        ol {
            grid-template-columns: minmax(0, 1fr);
        }
        li {
            border-right: 0;
            border-bottom: 1px solid var(--rule);
        }
        li:last-child {
            border-bottom: 0;
        }
    }
</style>
