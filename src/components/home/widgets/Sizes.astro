---
import Browser from "./desk/Browser.astro";
import "./app.css";
---

<div class="app sizes" data-play data-sizes>
    <i data-step="tablet" data-wait="1900" hidden></i>
    <i data-step="mobile" data-wait="1900" hidden></i>
    <Browser title="Sign in · Acme" address="http://localhost:5173/login" held="desktop" worker="Wren">
        <div class="view" data-view>
            <div class="held">
                <div class="page">
                    <div class="top"><span class="brand"><i></i>acme</span><span>Help</span></div>
                    <div class="card">
                        <h4>Welcome back</h4>
                        <label>Email<span class="field">maya@northwind.io</span></label>
                        <label>Password<span class="field">••••••••••</span></label>
                        <div class="actions">
                            <span class="signin">Sign in</span>
                            <span class="forgot">Forgot password<i class="noted" data-step="mark" data-wait="1300"></i></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </Browser>
</div>

<script>
    for (const box of document.querySelectorAll<HTMLElement>("[data-sizes]")) {
        const desk = box.querySelector<HTMLElement>(".desk")!;
        const view = box.querySelector<HTMLElement>("[data-view]")!;
        const measure = () => {
            box.style.setProperty("--aw", String(view.clientWidth));
            box.style.setProperty("--ah", String(view.clientHeight));
        };
        new ResizeObserver(measure).observe(view);
        measure();
        box.addEventListener("step", (event) => {
            const held = (event as CustomEvent).detail;
            if (held === "tablet" || held === "mobile") desk.dataset.held = held;
        });
    }
</script>

<style>
    @property --vw {
        syntax: "<number>";
        inherits: true;
        initial-value: 1440;
    }
    @property --vh {
        syntax: "<number>";
        inherits: true;
        initial-value: 900;
    }
    .sizes {
        --aw: 352;
        --ah: 296;
        padding: 5px;
    }
    .view {
        --vw: 1440;
        --vh: 900;
        --fit: min(var(--aw) / var(--vw), var(--ah) / var(--vh), 1);
        display: flex;
        justify-content: center;
        align-items: flex-start;
        height: 296px;
        overflow: hidden;
        transition:
            --vw 0.55s cubic-bezier(0.2, 0.7, 0.2, 1),
            --vh 0.55s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .sizes :global(.desk[data-held="tablet"]) .view {
        --vw: 820;
        --vh: 1180;
    }
    .sizes :global(.desk[data-held="mobile"]) .view {
        --vw: 390;
        --vh: 844;
    }
    .held {
        flex: none;
        width: calc(var(--vw) * var(--fit) * 1px);
        height: calc(var(--vh) * var(--fit) * 1px);
        overflow: hidden;
    }
    .page {
        container-type: inline-size;
        display: grid;
        grid-template-rows: auto 1fr;
        place-items: center;
        width: calc(var(--vw) * 1px);
        height: calc(var(--vh) * 1px);
        scale: var(--fit);
        transform-origin: 0 0;
        background: #fff;
        color: #1c1a22;
        font-family: "Figtree", var(--sans);
    }
    .top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-sizing: border-box;
        width: 100%;
        height: 92px;
        padding: 0 48px;
        background: #1c1a22;
        color: #fff;
        font-size: 26px;
    }
    .brand {
        display: flex;
        align-items: center;
        gap: 14px;
        font-size: 34px;
        font-weight: 700;
    }
    .brand i {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: #fff;
    }
    .card {
        display: grid;
        gap: 26px;
        box-sizing: border-box;
        width: 640px;
        padding: 56px 56px 64px;
        border: 2px solid #dedbe5;
        border-radius: 32px;
    }
    h4 {
        margin: 0 0 6px;
        font-size: 64px;
        font-weight: 600;
        line-height: 1.1;
        letter-spacing: -0.01em;
    }
    label {
        display: grid;
        gap: 10px;
        font-size: 26px;
        color: #6b6776;
    }
    .field {
        padding: 22px 24px;
        border: 2px solid #dedbe5;
        border-radius: 16px;
        background: #fff;
        font-size: 30px;
        line-height: 1.2;
        color: #1c1a22;
    }
    .actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 22px 32px;
        margin-top: 10px;
    }
    .signin {
        flex: 1 0 240px;
        padding: 24px;
        border-radius: 16px;
        background: #1c1a22;
        color: #fff;
        font-size: 30px;
        font-weight: 600;
        line-height: 1.2;
        text-align: center;
    }
    .forgot {
        position: relative;
        font-size: 28px;
        color: #5b3fd6;
        text-decoration: underline;
        white-space: nowrap;
    }
    .noted {
        position: absolute;
        inset: -3px;
        border: 2px solid #ff4f7b;
        border-radius: 3px;
    }
    @container (max-width: 600px) {
        .top {
            height: 72px;
            padding: 0 28px;
            font-size: 20px;
        }
        .card {
            gap: 20px;
            width: 100%;
            padding: 0 28px;
            border: 0;
            border-radius: 0;
        }
        .brand {
            gap: 10px;
            font-size: 26px;
        }
        .brand i {
            width: 28px;
            height: 28px;
            border-radius: 8px;
        }
        h4 {
            font-size: 46px;
        }
        label {
            gap: 8px;
            font-size: 20px;
        }
        .field {
            padding: 16px 18px;
            border-radius: 12px;
            font-size: 22px;
        }
        .actions {
            gap: 18px 24px;
        }
        .signin {
            padding: 18px;
            border-radius: 12px;
            font-size: 22px;
        }
        .forgot {
            font-size: 21px;
        }
    }
</style>
