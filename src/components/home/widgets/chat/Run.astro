---
import AgentName from "../../../AgentName.astro";
import FileIcon from "../../../FileIcon.astro";
import Mark from "./Mark.astro";
import type { AgentIconId } from "../../../../lib/agents";

export interface Call {
    verb: string;
    kind: "looked" | "changed" | "ran" | "called" | "removed" | "plugin";
    icon: "search" | "file" | "pencil" | "command" | "globe" | "pulse" | "square-plus" | "resize" | "signoz";
    target: string;
    took: number;
    diff?: [string, string];
    file?: boolean;
    starts?: { name: string; title: string; model: string };
}

interface Props {
    calls: Call[];
    agent?: AgentIconId;
    who?: string;
    worked?: string;
    folds?: boolean;
    wait?: number;
}

const { calls, agent = "claude", who, worked, folds = false, wait = 300 } = Astro.props;
const glyph: Record<Exclude<Call["icon"], "signoz">, string> = {
    search: '<path d="m21 21-4.34-4.34"/><circle cx="11" cy="11" r="8"/>',
    file: '<path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"/><path d="M14 2v5a1 1 0 0 0 1 1h5"/>',
    pencil: '<path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"/><path d="m15 5 4 4"/>',
    command: '<path d="M12 19h8"/><path d="m4 17 6-6-6-6"/>',
    globe: '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>',
    pulse: '<path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"/>',
    "square-plus": '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M8 12h8"/><path d="M12 8v8"/>',
    resize: '<path d="M15 3h6v6"/><path d="m21 3-7 7"/><path d="m3 21 7-7"/><path d="M9 21H3v-6"/>',
};
const chevron = '<path d="m9 18 6-6-6-6"/>';
const took = (seconds: number) => {
    const ms = Math.round(seconds * 1000);
    if (ms < 1000) return `${ms}ms`;
    const whole = Math.floor((ms + 500) / 1000);
    return whole < 60 ? `${whole}s` : `${Math.floor(whole / 60)}m ${String(whole % 60).padStart(2, "0")}s`;
};
let spent = 0;
const rows = calls.map((call) => ({ ...call, soFar: took((spent += call.took)) }));
---

<div class="turn" data-run-block data-folds={folds ? "" : undefined} data-step data-wait={String(wait)} style={`--verb: ${Math.min(Math.max(...calls.map((call) => call.verb.length), 4), 16) * 6.6 + 1}px`}>
    <div class="run">
        <p class="sum live waiting"><span class="label" data-calls>1 tool call</span><span class="time" data-spent></span><svg class="chev open" viewBox="0 0 24 24" set:html={chevron} /></p>
        <div class="rows">
            {
                rows.map((call, index) => (
                    <div class:list={["row", call.kind, { last: index === rows.length - 1 }]} data-step={`call:${call.took}`} data-wait={index === 0 ? "250" : "450"} data-run={String(Math.min(call.took * 350, 1400))} data-so-far={call.soFar}>
                        <span class="spine" />
                        <span class="icon">
                            {call.icon === "signoz" ? <img src="/signoz.svg" width="11" height="11" alt="" /> : <svg viewBox="0 0 24 24" set:html={glyph[call.icon]} />}
                        </span>
                        <span class="verb">{call.verb}</span>
                        {call.starts ? (
                            <span class="target starts">
                                <AgentName name={call.starts.name} chip />
                                <span class="task">{call.starts.title}</span>
                                <span class="on-model">· {call.starts.model}</span>
                            </span>
                        ) : (
                            <span class:list={["target", { file: call.file }]}>
                                {call.file && <FileIcon name={call.target} size={12} />}
                                {call.target}
                            </span>
                        )}
                        <span class="end">
                            {call.diff && (
                                <span class="diff">
                                    <i class="add">{call.diff[0]}</i>
                                    <i class="del">{call.diff[1]}</i>
                                </span>
                            )}
                            <span class="took">{took(call.took)}</span>
                            {call.diff && <svg class="opens" viewBox="0 0 24 24" set:html={chevron} />}
                        </span>
                    </div>
                ))
            }
        </div>
    </div>
    {
        worked && (
            <div class="work-block" data-step="fold" data-wait="300">
                <p class="work">
                    <Mark agent={agent} who={who} size={17} />
                    <span>{worked}</span>
                    <span>· {calls.length === 1 ? "1 tool call" : `${calls.length} tool calls`}</span>
                    <svg class="chev" viewBox="0 0 24 24" set:html={chevron} />
                </p>
            </div>
        )
    }
</div>

<script>
    for (const block of document.querySelectorAll<HTMLElement>("[data-run-block]")) {
        const label = block.querySelector<HTMLElement>("[data-calls]")!;
        const spent = block.querySelector<HTMLElement>("[data-spent]")!;
        const sum = block.querySelector<HTMLElement>(".sum")!;
        const total = block.querySelectorAll(".row").length;
        let landed = 0;
        let settled = 0;
        block.addEventListener("step", (event) => {
            const step = (event as CustomEvent).detail as string | undefined;
            if (step === "fold") return block.classList.add("folded");
            if (!step?.startsWith("call:")) return;
            landed += 1;
            sum.classList.remove("waiting");
            label.textContent = landed === 1 ? "1 tool call" : `${landed} tool calls`;
        });
        block.addEventListener("settled", (event) => {
            const step = (event as CustomEvent).detail as string | undefined;
            if (!step?.startsWith("call:")) return;
            settled += 1;
            spent.textContent = (event.target as HTMLElement).dataset.soFar ?? "";
            if (settled < total) return;
            sum.classList.remove("live");
            if (block.hasAttribute("data-folds")) block.classList.add("shut");
        });
    }
</script>
