---
import AgentIcon from "../../../AgentIcon.astro";
import AgentName from "../../../AgentName.astro";
import type { AgentIconId } from "../../../../lib/agents";

interface Props {
    title: string;
    who: string;
    agent?: AgentIconId | "chief";
}

const { title, who, agent = "claude" } = Astro.props;
---

<div class="pane-head">
    <span class="mark" style={agent === "chief" ? undefined : `color: var(--brand-${agent})`}>
        {agent === "chief" ? <img src="/brand/mark-purple.svg" alt="" width="15" height="15" /> : <AgentIcon agent={agent} size={15} />}
    </span>
    <span class="title">{title}</span>
    <span class="who"><AgentName name={who} /></span>
    <span class="seg"><span class="on">GUI</span><span>TUI</span></span>
</div>
