---
import AgentName from "../../../AgentName.astro";
import Letter from "./Letter.astro";

interface Props {
    messages: { from: string; to: string; name: string; face: string; text: string; when: string }[];
}

const SHOWN = 4;

const { messages } = Astro.props;
const minute = (when: string) => {
    const [hours, minutes] = when.split(":").map(Number);
    return hours * 60 + minutes;
};
const steps = messages.map(({ from, to, when }) => ({ from, to, took: `${minute(when) - minute(messages[0].when)}m` }));
const senders = [...new Map(messages.map((message) => [message.from, message])).values()];
const last = messages.length - 1;
---

<div class="team-run" data-team-run data-steps={JSON.stringify(steps)}>
    <p class="team-line">
        <svg class="chev" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"></path></svg>
        <span class="team-marks" data-marks hidden={senders.length < 2}>
            {senders.slice(0, SHOWN).map((sender) => <span class="buddy" data-face={sender.from} set:html={sender.face} />)}
            <span class="more" data-more hidden={senders.length <= SHOWN}>+{senders.length - SHOWN}</span>
        </span>
        <b class="count" data-count>{messages.length === 1 ? "1 message" : `${messages.length} messages`}</b>
        {
            messages.map((message, index) => (
                <>
                    <span class="said-by" data-said={index} hidden={index !== last}>
                        <AgentName name={message.name} />
                    </span>
                    <span class="said" data-said={index} hidden={index !== last}>
                        {message.text}
                    </span>
                </>
            ))
        }
        <span class="took" data-took hidden={messages.length < 2}>{steps[last].took}</span>
    </p>
    <div class="team-open">
        <div class="team-letters">
            {
                messages.map((message) => (
                    <div class="team-letter landed" data-letter>
                        <Letter name={message.name} when={message.when}>
                            {message.text}
                        </Letter>
                    </div>
                ))
            }
        </div>
    </div>
</div>

<script>
    const SHOWN = 4;
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

    for (const run of document.querySelectorAll<HTMLElement>("[data-team-run]")) {
        if (still) continue;

        const steps = JSON.parse(run.dataset.steps ?? "[]") as { from: string; to: string; took: string }[];
        const letters = [...run.querySelectorAll<HTMLElement>("[data-letter]")];
        const column = run.closest<HTMLElement>(".column");
        const marks = run.querySelector<HTMLElement>("[data-marks]")!;
        const more = run.querySelector<HTMLElement>("[data-more]")!;
        const count = run.querySelector<HTMLElement>("[data-count]")!;
        const took = run.querySelector<HTMLElement>("[data-took]")!;
        const say = (detail: string) => run.dispatchEvent(new CustomEvent("step", { detail, bubbles: true }));

        const sum = (index: number) => {
            const senders = [...new Set(steps.slice(0, index + 1).map((step) => step.from))];
            marks.hidden = senders.length < 2;
            for (const face of marks.querySelectorAll<HTMLElement>("[data-face]")) face.hidden = !senders.includes(face.dataset.face!);
            more.hidden = senders.length <= SHOWN;
            more.textContent = `+${senders.length - SHOWN}`;
            count.textContent = index === 0 ? "1 message" : `${index + 1} messages`;
            for (const said of run.querySelectorAll<HTMLElement>("[data-said]")) said.hidden = said.dataset.said !== String(index);
            took.hidden = index === 0;
            took.textContent = steps[index].took;
        };
        const land = (index: number) => {
            run.classList.remove("empty");
            letters[index].classList.add("landed");
            sum(index);
            say(`team:${index}:${steps[index].from}:${steps[index].to}`);
            column?.scrollTo({ top: column.scrollHeight, behavior: "smooth" });
        };

        let showing = false;
        let playing = false;
        const loop = async () => {
            playing = true;
            while (showing) {
                run.classList.remove("folded");
                run.classList.add("empty");
                letters.forEach((letter) => letter.classList.remove("landed"));
                column?.scrollTo({ top: 0 });
                say("team:reset");
                await wait(700);
                for (let index = 0; index < letters.length; index++) {
                    land(index);
                    await wait(1500);
                }
                await wait(1400);
                column?.scrollTo({ top: 0, behavior: "smooth" });
                run.classList.add("folded");
                await wait(4200);
            }
            playing = false;
        };
        new IntersectionObserver(
            ([entry]) => {
                showing = entry.isIntersecting;
                if (showing && !playing) loop();
            },
            { threshold: 0.35 },
        ).observe(run.closest(".app") ?? run);
    }
</script>
