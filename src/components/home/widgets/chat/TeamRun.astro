---
import AgentIcon from "../../../AgentIcon.astro";
import Letter from "./Letter.astro";
import AgentName from "../../../AgentName.astro";
import type { AgentIconId } from "../../../../lib/agents";

interface Props {
    messages: { from: string; name: string; agent: AgentIconId; to: string; text: string; when: string }[];
    took: string;
}

const { messages, took } = Astro.props;
const agents = [...new Map(messages.map((message) => [message.agent + message.name, message])).values()];
const last = messages[messages.length - 1];
---

<div class="team-run" data-team-run data-relay={JSON.stringify(messages.map(({ from, to }) => `${from}:${to}`))}>
    <p class="team-line">
        <svg class="chev" viewBox="0 0 24 24"><path d="m9 6 6 6-6 6"></path></svg>
        <span class="team-marks">
            {agents.slice(0, 4).map((agent) => <span class="mark" style={`color: var(--brand-${agent.agent})`}><AgentIcon agent={agent.agent} size={16} /></span>)}
            {agents.length > 4 && <span class="more">+{agents.length - 4}</span>}
        </span>
        <b class="count">{messages.length} messages</b>
        <span class="words"><span class="said-by"><AgentName name={last.name} /></span><span class="said">{last.text}</span></span>
        <span class="took">{took}</span>
    </p>
    <div class="team-open">
        <div class="team-letters">
            {
                messages.map((message) => (
                    <div class="team-letter" data-letter>
                        <Letter name={message.name} agent={message.agent} when={message.when}>
                            {message.text}
                        </Letter>
                    </div>
                ))
            }
        </div>
    </div>
</div>

<script>
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

    for (const run of document.querySelectorAll<HTMLElement>("[data-team-run]")) {
        const relay = JSON.parse(run.dataset.relay ?? "[]") as string[];
        const letters = [...run.querySelectorAll<HTMLElement>("[data-letter]")];
        const column = run.closest<HTMLElement>(".column");
        const say = (detail: string) => run.dispatchEvent(new CustomEvent("step", { detail, bubbles: true }));
        const land = (index: number) => {
            letters[index].classList.add("landed");
            say(`team:${index}:${relay[index]}`);
            column?.scrollTo({ top: column.scrollHeight, behavior: still ? "auto" : "smooth" });
        };

        if (still) {
            letters.forEach((_, index) => land(index));
            continue;
        }

        let showing = false;
        let playing = false;
        const loop = async () => {
            playing = true;
            while (showing) {
                run.classList.remove("folded");
                letters.forEach((letter) => letter.classList.remove("landed"));
                column?.scrollTo({ top: 0 });
                say("team:reset");
                await wait(700);
                for (let index = 0; index < letters.length; index++) {
                    land(index);
                    await wait(1500);
                }
                await wait(1400);
                column?.scrollTo({ top: 0, behavior: "smooth" });
                run.classList.add("folded");
                await wait(4200);
            }
            playing = false;
        };
        new IntersectionObserver(
            ([entry]) => {
                showing = entry.isIntersecting;
                if (showing && !playing) loop();
            },
            { threshold: 0.35 },
        ).observe(run.closest(".app") ?? run);
    }
</script>
