---
import "../../../styles/buddies.css";
import Head from "./chat/Head.astro";
import AgentRow, { type TreeLine } from "./chat/AgentRow.astro";
import TeamRun from "./chat/TeamRun.astro";
import { buddy } from "../../../lib/buddies";
import { TEAM as cast } from "../../../lib/showcase-buddies";
import type { AgentIconId } from "../../../lib/agents";
import "./app.css";

const relay = [
    { from: "otter", to: "heron", text: "The sign-in test fails in Safari. Heron, can you take it?", when: "14:31" },
    { from: "heron", to: "wren", text: "Fixed in session.ts. Wren, can you check it in your browser tab?", when: "14:38" },
    { from: "wren", to: "badger", text: "Works at phone size too. Badger, can you try it in the Simulator?", when: "14:41" },
    { from: "badger", to: "finch", text: "Taps through fine on iPhone. Finch, the release notes are yours.", when: "14:46" },
    { from: "finch", to: "lynx", text: "Written. Lynx, can you watch CI?", when: "14:49" },
    { from: "lynx", to: "otter", text: "CI is green. Otter, it's ready for your review.", when: "14:55" },
];
const open = "otter";
const depths: Record<string, number> = { otter: 1, heron: 2, wren: 2, badger: 1, finch: 0, lynx: 0 };
const recent: { title: string; agent: AgentIconId; age: string }[] = [
    { title: "Cart total rounds the wrong way", agent: "codex", age: "3h" },
    { title: "Speed up the product page", agent: "claude", age: "1d" },
    { title: "Tidy the README", agent: "pi", age: "4d" },
];

const levels = cast.map((agent) => depths[agent.id]);
const rows = cast.map((agent, index) => {
    const later = levels.slice(index + 1);
    const lines = Array.from({ length: levels[index] }, (_, level): TreeLine => {
        const sibling = later.find((depth) => depth <= level + 1) === level + 1;
        if (level + 1 === levels[index]) return sibling ? "tick" : "corner";
        return sibling ? "through" : "blank";
    });
    const state = agent.id === open ? "working" : "done";
    return { ...agent, lines, state, leads: (levels[index + 1] ?? 0) > levels[index], face: buddy(agent.pack, agent.shape, state) } as const;
});
const faces = Object.fromEntries(rows.map((row) => [row.id, row.face.markup]));
const messages = relay.map((line) => ({ ...line, name: rows.find((row) => row.id === line.from)!.name, face: faces[line.from] }));
---

<div class="app team" data-play data-team>
    <div class="split">
        <div class="stage">
            <Head title="Sign-in test fails in Safari" who="Otter" crumbs={["Chief"]} />
            <div class="column">
                <TeamRun messages={messages} />
            </div>
        </div>
        <div class="rail">
            <div class="rows">
                <AgentRow title="@Chief" detail="Chief of staff" open />
                {rows.map((row) => <AgentRow id={row.id} title={row.task} name={row.name} face={row.face.markup} motion={row.face.motion} state={row.state} chosen={row.id === open} lines={row.lines} open={row.leads} />)}
            </div>
            <div class="group">
                <p class="heading"><span class="caps">Recent</span><i></i><svg viewBox="0 0 24 24" width="11" height="11"><path d="m9 18 6-6-6-6"></path></svg></p>
                <div class="rows">
                    {recent.map((chat) => <AgentRow title={chat.title} agent={chat.agent} age={chat.age} />)}
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    type Pose = { motion: string; markup: string };
    let drawings: Promise<Record<string, Record<"working" | "done", Pose>>> | null = null;
    const load = () => (drawings ??= fetch("/buddies.json").then((response) => response.json()).then((data) => data.team));

    for (const box of document.querySelectorAll<HTMLElement>("[data-team]")) {
        const draw = (id: string, pose: Pose) => {
            for (const face of box.querySelectorAll<HTMLElement>(`[data-face="${id}"]`)) {
                face.innerHTML = pose.markup;
                if (pose.motion) face.dataset.motion = pose.motion;
                else delete face.dataset.motion;
            }
        };
        const rows = [...box.querySelectorAll<HTMLElement>("[data-row]")];
        const idle: Record<string, Pose> = {};
        for (const face of box.querySelectorAll<HTMLElement>(".agent-name .buddy")) {
            const id = face.closest(".agent-name")!.textContent!.trim().slice(1).toLowerCase();
            face.dataset.face = id;
            idle[id] ??= { motion: "", markup: face.innerHTML };
        }
        const head = box.querySelector<HTMLElement>(".head-mark .buddy");
        const chosen = rows.find((row) => "chosen" in row.dataset);
        if (head && chosen) head.dataset.face = chosen.dataset.row;
        const become = async (id: string, turn: "idle" | "working" | "done") => {
            const row = rows.find((candidate) => candidate.dataset.row === id);
            if (!row) return;
            // The app shows a finished turn as idle once it is seen, and the open chat's is seen at once.
            const state = turn === "done" && "chosen" in row.dataset ? "idle" : turn;
            row.dataset.state = state;
            draw(id, state === "idle" ? idle[id] : (await load())[id][state]);
        };
        const settle = async () => {
            const poses = await load();
            for (const row of rows) {
                const state = row.dataset.state as "idle" | "working" | "done";
                if (state !== "idle") draw(row.dataset.row!, poses[row.dataset.row!][state]);
            }
        };
        new IntersectionObserver(
            ([entry], observer) => {
                if (!entry.isIntersecting) return;
                observer.disconnect();
                settle();
            },
            { rootMargin: "800px 0px" },
        ).observe(box);
        box.addEventListener("step", (event) => {
            const step = (event as CustomEvent).detail as string;
            if (!step?.startsWith("team:")) return;
            if (step === "team:reset") {
                for (const row of rows) become(row.dataset.row!, "chosen" in row.dataset ? "working" : "idle");
                return;
            }
            const [, , from, to] = step.split(":");
            become(from, "done");
            become(to, "working");
        });
    }
</script>

<style>
    .team {
        max-width: 900px;
    }
    .split {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 288px;
    }
    .stage {
        min-width: 0;
    }
    .team .column {
        height: 546px;
        overflow: hidden;
    }
    .rail {
        padding: 14px 10px;
        border-left: 1px solid var(--line);
        overflow: hidden;
    }
    .rows {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }
    .group {
        margin-top: 16px;
    }
    .heading {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 4px 6px 6px 8px;
        border-radius: 5px;
        color: var(--text-tertiary);
    }
    .heading:hover {
        background: var(--surface-hover);
    }
    .caps {
        flex: none;
        font-size: 11px;
        font-weight: 500;
        line-height: 16px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
    }
    .heading i {
        flex: 1;
        height: 1px;
        background: var(--border);
    }
    .heading svg {
        flex: none;
        rotate: 90deg;
    }
    @media (max-width: 1220px) {
        .split {
            grid-template-columns: minmax(0, 1fr);
        }
        .team .column {
            height: 460px;
        }
        .rail {
            border-left: 0;
            border-top: 1px solid var(--line);
        }
        .group {
            display: none;
        }
    }
    @media (max-width: 860px) {
        .team :global(.pane-head .segmented),
        .team :global(.pane-head .head-rule),
        .team :global(.pane-head .icon-btn) {
            display: none;
        }
    }
    @media (max-width: 1220px) and (prefers-reduced-motion: reduce) {
        .team .column {
            height: auto;
        }
    }
</style>
