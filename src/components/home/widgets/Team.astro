---
import "../../../styles/buddies.css";
import Head from "./chat/Head.astro";
import AgentRow from "./chat/AgentRow.astro";
import TeamRun from "./chat/TeamRun.astro";
import { buddy } from "../../../lib/buddies";
import { TEAM as cast } from "../../../lib/showcase-buddies";
import "./app.css";

const relay = [
    { from: "otter", to: "heron", text: "The sign-in test fails in Safari. Heron, can you take it?", when: "2:31 PM" },
    { from: "heron", to: "wren", text: "Fixed in session.ts. Wren, can you check it in your browser tab?", when: "2:38 PM" },
    { from: "wren", to: "badger", text: "Works at phone size too. Badger, can you try it in the Simulator?", when: "2:41 PM" },
    { from: "badger", to: "finch", text: "Taps through fine on iPhone. Finch, the release notes are yours.", when: "2:46 PM" },
    { from: "finch", to: "lynx", text: "Written. Lynx, can you watch CI?", when: "2:49 PM" },
    { from: "lynx", to: "otter", text: "CI is green. Otter, it's ready for your review.", when: "2:55 PM" },
];
const named = Object.fromEntries(cast.map((agent) => [agent.id, agent]));
const messages = relay.map((line) => ({ ...line, name: named[line.from].name, agent: named[line.from].agent }));
const faces = cast.map((agent) => ({ ...agent, idle: buddy(agent.pack, agent.shape, "idle").markup }));
---

<div class="app team" data-play data-team>
    <Head title="Sign-in test fails in Safari" who="@Otter" />
    <div class="split">
        <div class="rail">
            <p class="label">Agents</p>
            {faces.map((agent, index) => <AgentRow id={agent.id} task={agent.task} age={`${24 - index * 4}m`} project="storefront" name={agent.name} agent={agent.agent} face={agent.idle} state={index === 0 ? "working" : "idle"} />)}
        </div>
        <div class="column">
            <TeamRun messages={messages} took="24m" />
        </div>
    </div>
</div>

<script>
    type Pose = { motion: string; markup: string };
    let drawings: Promise<Record<string, Record<"working" | "done", Pose>>> | null = null;
    const load = () => (drawings ??= fetch("/buddies.json").then((response) => response.json()).then((data) => data.team));

    for (const box of document.querySelectorAll<HTMLElement>("[data-team]")) {
        new IntersectionObserver(
            ([entry], observer) => {
                if (!entry.isIntersecting) return;
                observer.disconnect();
                load();
            },
            { rootMargin: "800px 0px" },
        ).observe(box);
        const pose = async (id: string, state: "working" | "done") => {
            const row = box.querySelector<HTMLElement>(`[data-row="${id}"]`);
            if (!row) return;
            row.dataset.state = state;
            const drawn = (await load())[id][state];
            const face = row.querySelector<HTMLElement>(".buddy")!;
            face.innerHTML = drawn.markup;
            if (drawn.motion) face.dataset.motion = drawn.motion;
            else delete face.dataset.motion;
        };
        box.addEventListener("step", (event) => {
            const step = (event as CustomEvent).detail as string;
            if (!step?.startsWith("team:") || step === "team:open") return;
            const [, , from, to] = step.split(":");
            pose(from, "done");
            pose(to, "working");
        });
    }
</script>

<style>
    .team {
        max-width: 900px;
    }
    .split {
        display: grid;
        grid-template-columns: 260px minmax(0, 1fr);
        border-top: 1px solid var(--line);
    }
    .rail {
        padding: 10px 8px;
        border-right: 1px solid var(--line);
        display: flex;
        flex-direction: column;
        gap: 2px;
    }
    .label {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0 6px 6px;
        font-size: 10.5px;
        font-weight: 500;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--quiet);
    }
    .label::after {
        content: "";
        flex: 1;
        height: 1px;
        background: var(--line);
    }
    .team .column {
        height: 520px;
        overflow: hidden;
    }
    @media (max-width: 760px) {
        .split {
            grid-template-columns: minmax(0, 1fr);
        }
        .rail {
            flex-direction: row;
            gap: 4px;
            overflow: hidden;
            border-right: 0;
            border-bottom: 1px solid var(--line);
        }
        .rail .label,
        .rail :global(.row-text),
        .rail :global(.row-name) {
            display: none;
        }
        .rail :global(.agent-row) {
            grid-template-columns: 22px 16px;
            gap: 2px;
            padding: 4px;
        }
        .team .column {
            height: 640px;
        }
    }
</style>
