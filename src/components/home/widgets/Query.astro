---
import AgentName from "../../AgentName.astro";
import "./app.css";

const rows = [
    ["48213", "maya@northwind.io", "129.00", "2026-11-13 09:38:12"],
    ["48207", "li.wei@fabrikam.com", "42.50", "2026-11-13 09:31:47"],
    ["48199", "sam@contoso.dev", "310.00", "2026-11-13 09:22:05"],
    ["48188", "priya@tailspin.app", "18.99", "2026-11-13 09:12:40"],
    ["48174", "jonas@lumen.studio", "76.20", "2026-11-13 08:58:19"],
];
---

<div class="app query" data-play data-query>
    <div class="pane-head">
        <svg class="db" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="8" ry="3"></ellipse><path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"></path></svg>
        <span class="title">shop</span> <span class="who">production · PostgreSQL 17</span>
        <span class="end"><span class="ro">Read only</span><button type="button" class="qbtn primary" data-run-query>Run</button></span>
    </div>
    <pre class="sql mono"><em>select</em> o.id, c.email, o.total_cents / 100.0 <em>as</em> total, o.status, o.created_at
<em>from</em> orders o <em>join</em> customers c <em>on</em> c.id = o.customer_id
<em>where</em> o.status = <s>'failed'</s>
<em>order by</em> o.created_at <em>desc</em>
<em>limit</em> 5;</pre>
    <div class="table">
        <table class="mono">
            <thead><tr><th>id</th><th>email</th><th class="r">total</th><th>status</th><th>created_at</th></tr></thead>
            <tbody>
                {rows.map((row) => <tr data-step data-wait="120"><td>{row[0]}</td><td>{row[1]}</td><td class="r">{row[2]}</td><td class="failed">failed</td><td>{row[3]}</td></tr>)}
            </tbody>
        </table>
    </div>
    <div class="foot">
        <span class="count mono" data-step data-wait="80">5 rows</span>
        <button type="button" class="qbtn" data-send><span data-unsent>Send to agent</span><span data-sent hidden>Sent to <AgentName name="Wren" /></span></button>
    </div>
</div>

<script>
    for (const box of document.querySelectorAll<HTMLElement>("[data-query]")) {
        const rows = [...box.querySelectorAll<HTMLElement>("tbody tr")];
        box.querySelector("[data-run-query]")!.addEventListener("click", async () => {
            for (const row of rows) row.classList.remove("on");
            for (const row of rows) {
                await new Promise((resolve) => setTimeout(resolve, 90));
                row.classList.add("on");
            }
        });
        const send = box.querySelector<HTMLButtonElement>("[data-send]")!;
        send.addEventListener("click", () => {
            send.querySelector<HTMLElement>("[data-unsent]")!.hidden = true;
            send.querySelector<HTMLElement>("[data-sent]")!.hidden = false;
            send.classList.add("sent");
        });
    }
</script>

<style>
    .query {
        max-width: 640px;
    }
    .query .pane-head {
        flex-wrap: wrap;
        row-gap: 4px;
        height: auto;
        min-height: 40px;
        padding-block: 6px;
    }
    .db {
        color: var(--quiet);
    }
    .end {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .ro {
        font-size: 10.5px;
        padding: 2px 7px;
        border: 1px solid var(--line);
        border-radius: 99px;
        color: var(--quiet);
    }
    .qbtn {
        display: inline-flex;
        align-items: center;
        height: 26px;
        padding: 0 10px;
        border-radius: 5px;
        border: 1px solid var(--strong);
        background: none;
        color: var(--ink);
        font: 500 12px "Figtree", var(--sans);
        cursor: pointer;
    }
    .qbtn.primary {
        border-color: var(--accent);
        background: var(--accent);
        color: var(--ground);
    }
    .sql {
        margin: 0;
        padding: 12px 14px;
        font: 400 11.5px/1.65 var(--mono);
        color: var(--ink);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        white-space: pre;
        overflow-x: auto;
        scrollbar-width: none;
        -webkit-mask-image: linear-gradient(90deg, #000 88%, transparent);
        mask-image: linear-gradient(90deg, #000 88%, transparent);
    }
    .sql em {
        font-style: normal;
        color: var(--accent);
    }
    .sql s {
        text-decoration: none;
        color: var(--added);
    }
    .table {
        overflow-x: auto;
        min-height: 190px;
        -webkit-mask-image: linear-gradient(90deg, #000 85%, transparent);
        mask-image: linear-gradient(90deg, #000 85%, transparent);
    }
    table {
        width: 100%;
        border-collapse: collapse;
        font: 400 11.5px var(--mono);
    }
    th {
        text-align: left;
        font-weight: 500;
        color: var(--ink);
        padding: 7px 12px;
        background: var(--raised);
        border-bottom: 1px solid var(--line);
    }
    td {
        padding: 6px 12px;
        color: var(--secondary);
        border-bottom: 1px solid var(--line);
        white-space: nowrap;
    }
    .r {
        text-align: right;
    }
    .failed {
        color: var(--deleted);
    }
    .foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 14px;
    }
    .count {
        color: var(--quiet);
        font: 400 11px var(--mono);
    }
    .sent {
        color: var(--added);
        border-color: var(--added);
    }
</style>
