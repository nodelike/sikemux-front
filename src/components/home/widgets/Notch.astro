---
import "../../../styles/buddies.css";
import AgentIcon from "../../AgentIcon.astro";
import { buddy, type BuddyState } from "../../../lib/buddies";
import { faceOf } from "../../../lib/showcase-buddies";
import "./app.css";

const task = "Add dark mode to settings";
const command = "pnpm test src/settings";
const project = "acme-shop";
const finished = "Fix the login form";

const face = (name: string, state: BuddyState, more = "") => {
    const { pack, shape } = faceOf(name)!;
    const { motion, markup } = buddy(pack, shape, state);
    return `<span class="${["buddy", more].filter(Boolean).join(" ")}"${motion ? ` data-motion="${motion}"` : ""}>${markup}</span>`;
};

const shield = "M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z";
const drawings = {
    chevron: `<path d="m9 18 6-6-6-6"/>`,
    more: `<circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/>`,
    shield: `<path d="${shield}"/>`,
    shieldBolt: `<path d="${shield}"/><path d="M13 7.5 9 13h3l-1 4.5 4-5.5h-3z" fill="currentColor" stroke="none"/>`,
    stack: `<path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"/><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"/><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"/>`,
    plus: `<path d="M5 12h14"/><path d="M12 5v14"/>`,
    gauge: `<path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/>`,
    folder: `<path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/>`,
    git: `<path d="M15 6a9 9 0 0 0-9 9V3"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/>`,
    command: `<path d="M12 19h8"/><path d="m4 17 6-6-6-6"/>`,
};
const icon = (name: keyof typeof drawings, size: number) =>
    `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${drawings[name]}</svg>`;

const twinkles = [
    [0.9, 0],
    [1.24, -0.52],
    [1.58, -1.04],
    [1.07, -0.39],
    [1.41, -0.91],
    [0.9, -0.26],
    [1.24, -0.78],
    [1.58, -0.13],
    [1.07, -0.65],
];
---

<div class="pair" data-notch data-phase="working" aria-label={`The island over the notch asks to run ${command} and Allow is pressed, while the phone shows the same request as a permission card`}>
    <div class="laptop-crop">
    <div class="laptop" data-laptop>
    <div class="mac">
        <div class="screen">
            <div class="desk">
            <div class="menubar">
                <span class="left"><svg width="14" height="16" viewBox="0 0 814 1000" fill="currentColor" aria-hidden="true"><path d="M788 341c-6 4-108 62-108 190 0 149 130 201 134 203-1 3-21 72-69 142-43 62-88 123-156 123s-85-40-164-40c-76 0-104 41-166 41s-105-57-155-127C47 791 0 663 0 542c0-194 126-298 251-298 66 0 121 44 163 44 39 0 101-46 176-46 29 0 131 3 198 99zM554 159c31-37 53-88 53-139 0-7-1-14-2-20-51 2-111 34-147 76-29 32-55 84-55 135 0 8 1 15 2 18 3 0 8 1 13 1 46 0 103-31 136-71z"></path></svg><b>Figma</b><span>File</span><span>Edit</span><span>View</span></span>
                <span class="right"><span class="clock">Thu 2:51 PM</span></span>
            </div>
            <div class="window" aria-hidden="true">
                <div class="chrome"><i></i><i></i><i></i><span>Onboarding — Figma</span></div>
                <div class="canvas"><span class="panel"></span><span class="frames"><span class="frame"></span><span class="frame"></span><span class="frame"></span></span><span class="panel r"></span></div>
            </div>
            <span class="island" aria-hidden="true">
                <span class="shape">
                    <span class="band wings">
                        <span class="wing l">
                            <Fragment set:html={face("Otter", "working")} />
                            <Fragment set:html={face("Heron", "working")} />
                            <Fragment set:html={face("Wren", "working", "as-working")} />
                            <Fragment set:html={face("Wren", "done", "as-done")} />
                        </span>
                        <span class="wing r">
                            <span class="group"><span class="count"><span class="as-working">3</span><span class="as-done">2</span></span><span class="st"><span class="grid">{twinkles.map(([period, offset]) => <i style={`--p:${period}s;--o:${offset}s`}></i>)}</span></span></span>
                            <span class="group as-done"><span class="st finished"><span class="dot"></span></span></span>
                        </span>
                    </span>
                    <span class="band head">
                        <span class="side"><Fragment set:html={face("Otter", "waiting")} /><span class="lead">Otter</span></span>
                        <span class="side r"><span class="trail">Needs you</span><span class="st blocked"><span class="ping"></span><span class="ping"></span><span class="dot"></span></span></span>
                    </span>
                    <span class="body">
                        <span class="title">{task}</span>
                        <span class="sub"><span class="faint" set:html={icon("folder", 11)} /><span>{project}</span><span class="faint">·</span><span>Needs your permission</span></span>
                        <span class="cmd"><span class="faint">$</span><span>{command}</span></span>
                        <span class="actions"><span class="nbtn">Deny</span><span class="nbtn">Always allow</span><span class="nbtn primary">Allow</span></span>
                    </span>
                    <span class="band done">
                        <span class="side dl"><Fragment set:html={face("Wren", "done")} /><span class="lead small">Finished</span></span>
                        <span class="side dr"><span class="what">{finished}</span><span class="st finished"><span class="dot"></span></span></span>
                    </span>
                </span>
            </span>
            <svg class="pointer away" width="18" height="24" viewBox="0 0 18 24" aria-hidden="true"><path d="M1 1v19l5-5 3.5 7.5 3-1.4L9 13.8h7z" fill="#000" stroke="#fff" stroke-width="1.4" stroke-linejoin="round"></path></svg>
            </div>
        </div>
    </div>
    <div class="base"><span class="lip"></span></div>
    </div>
    </div>

    <div class="phone">
        <div class="glass app">
            <div class="p-screen">
            <div class="status"><span>2:51</span><span class="island-cut"></span><span class="sig"><i></i><i></i><i></i><i></i></span></div>
            <div class="p-nav">
                <span class="p-back" set:html={icon("chevron", 18)} />
                <span class="p-heading">
                    <Fragment set:html={face("Otter", "working", "p-turn-working")} />
                    <Fragment set:html={face("Otter", "waiting", "p-turn-asking")} />
                    <span class="p-title">{task}</span>
                    <span class="p-at">@Otter</span>
                </span>
                <span class="p-more" set:html={icon("more", 16)} />
            </div>
            <div class="p-feed">
                <div class="p-rows">
                    <div class="p-mine">
                        <p class="p-bubble">Add a dark mode switch to the settings page. It should remember the choice.</p>
                        <span class="p-sent">14:50</span>
                    </div>
                    <p class="p-reply">I added a <b>Dark mode</b> switch under Appearance. It saves the choice, so the page opens the same way next time.</p>
                    <div class="p-group">
                        <p class="p-group-head"><span>2 tool calls</span><span class="p-took">3s</span><span class="p-fold" set:html={icon("chevron", 11)} /></p>
                    </div>
                    <p class="p-reply">Now I want to run the settings tests to make sure nothing else broke.</p>
                    <div class="p-group p-asked">
                        <p class="p-group-head"><span class="p-said p-shimmer">Run the settings tests</span><span class="p-took" data-call-time>2s</span><span class="p-fold open" set:html={icon("chevron", 11)} /></p>
                        <p class="p-call">
                            <svg class="p-spine" width="10" height="22" viewBox="0 0 10 22" fill="none" aria-hidden="true"><path d="M0.5 0V7Q0.5 11 4.5 11H10"></path></svg>
                            <span class="p-kind-icon" set:html={icon("command", 12)} />
                            <span class="p-kind">run</span>
                            <span class="p-target"><span class="p-shimmer">{command}</span></span>
                            <span class="p-call-end"><span data-call-time>2s</span><span class="p-open" set:html={icon("chevron", 10)} /></span>
                        </p>
                    </div>
                    <div class="p-foot">
                        <p class="p-doing">
                            <Fragment set:html={face("Otter", "idle")} />
                            <span class="p-verb p-shimmer p-when-thinking">Thinking</span>
                            <span class="p-verb p-shimmer p-when-running">Running</span>
                            <span class="p-what p-when-running">{command}</span>
                            <span class="p-since" data-turn-time>38s</span>
                        </p>
                        <p class="p-needs">
                            <Fragment set:html={face("Otter", "waiting")} />
                            <span class="p-words"><span class="p-needs-you">Needs you</span><span class="p-sep">·</span><span class="p-question">{command}</span><span class="p-sep">·</span><span class="p-age">1 min</span></span>
                            <span class="p-look">Look</span>
                        </p>
                    </div>
                </div>
            </div>
            <div class="p-dock">
                <div class="p-perm">
                    <div class="p-perm-top">
                        <Fragment set:html={icon("shieldBolt", 16)} />
                        <p><b>Run a command?</b><span>Claude needs permission to continue</span></p>
                    </div>
                    <p class="p-perm-cmd"><span>$ </span>{command}</p>
                    <div class="p-answers"><span class="p-answer no">No</span><span class="p-answer">Yes, and don't ask again for `pnpm test` commands</span><span class="p-answer go">Yes</span></div>
                </div>
                <div class="p-box">
                    <p class="p-input">Send to steer this turn</p>
                    <div class="p-bar">
                        <span class="p-plus" set:html={icon("plus", 17)} />
                        <span class="p-stash" set:html={icon("stack", 16)} />
                        <span class="p-safe"><Fragment set:html={icon("shield", 13)} />SAFE</span>
                        <span class="p-model">
                            <span class="p-brand"><AgentIcon agent="claude" size={16} /></span>
                            <span class="p-model-name">Opus 5.5</span>
                            <span class="p-quiet">·</span>
                            <span class="p-quiet" set:html={icon("gauge", 13)} />
                            <span class="p-quiet">High</span>
                            <span class="p-down" set:html={icon("chevron", 10)} />
                        </span>
                        <span class="p-ring"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><circle class="p-ring-track" cx="7" cy="7" r="6.1"></circle><circle class="p-ring-used" cx="7" cy="7" r="6.1" pathLength="100" stroke-dasharray="18 100" transform="rotate(-90 7 7)"></circle></svg></span>
                        <span class="p-stop"><i></i></span>
                    </div>
                </div>
                <p class="p-place">
                    <span class="p-place-part"><span class="p-live" set:html={icon("folder", 12)} /><span class="p-project">{project}</span></span>
                    <span class="p-slash">/</span>
                    <span class="p-place-part"><span class="p-branch-icon" set:html={icon("git", 11)} /><span class="p-branch">main</span></span>
                </p>
            </div>
            <span class="home"></span>
            </div>
        </div>
    </div>
</div>

<script>
    const outline = (from: number, to: number, height: number, top: number, bottom: number) =>
        `path("M ${from} 0 Q ${from + top} 0 ${from + top} ${top} L ${from + top} ${height - bottom} Q ${from + top} ${height} ${from + top + bottom} ${height} L ${to - top - bottom} ${height} Q ${to - top} ${height} ${to - top} ${height - bottom} L ${to - top} ${top} Q ${to - top} 0 ${to} 0 Z")`;
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const LOOP = 11000;
    const MIDDLE = 260;
    const CAMERA = 100;
    const BAND = 37;

    for (const box of document.querySelectorAll<HTMLElement>("[data-notch]")) {
        const laptop = box.querySelector<HTMLElement>("[data-laptop]")!;
        const scale = () => {
            const narrow = box.clientWidth < 680;
            const room = narrow ? box.clientWidth - 24 : box.clientWidth - 290;
            laptop.style.setProperty("--s", String(Math.min(narrow ? 1 : 0.58, room / (narrow ? 760 : 1368))));
            box.style.setProperty("--s", laptop.style.getPropertyValue("--s"));
        };
        new ResizeObserver(scale).observe(box);
        scale();
        const screen = box.querySelector<HTMLElement>(".screen")!;
        const island = box.querySelector<HTMLElement>(".island")!;
        const shape = island.querySelector<HTMLElement>(".shape")!;
        const left = island.querySelector<HTMLElement>(".wing.l")!;
        const right = island.querySelector<HTMLElement>(".wing.r")!;
        const ask = island.querySelector<HTMLElement>(".body")!;
        const pointer = box.querySelector<SVGElement>(".pointer")!;
        const allow = island.querySelector<HTMLElement>(".nbtn.primary")!;
        const turnTimes = [...box.querySelectorAll<HTMLElement>("[data-turn-time]")];
        const callTimes = [...box.querySelectorAll<HTMLElement>("[data-call-time]")];

        const zoomed = () => screen.getBoundingClientRect().width / screen.offsetWidth || 1;
        const mode = (name: "closed" | "ask" | "done") => {
            island.dataset.mode = name;
            if (name === "ask") {
                shape.style.clipPath = outline(MIDDLE - 230, MIDDLE + 230, BAND + ask.offsetHeight, 14, 22);
            } else if (name === "done") {
                shape.style.clipPath = outline(MIDDLE - CAMERA - 150, MIDDLE + CAMERA + 150, BAND, 6, 14);
            } else {
                const by = zoomed();
                const from = MIDDLE - CAMERA - left.getBoundingClientRect().width / by;
                const to = MIDDLE + CAMERA + right.getBoundingClientRect().width / by;
                shape.style.clipPath = outline(from, to, BAND, 6, 14);
            }
        };
        const point = (to: "rest" | "allow") => {
            const area = screen.getBoundingClientRect();
            const target = to === "allow" ? allow.getBoundingClientRect() : { left: area.left + area.width * 0.42, top: area.top + 250, width: 0, height: 0 };
            const ratio = area.width / screen.offsetWidth || 1;
            pointer.style.translate = `${(target.left - area.left + target.width * 0.55) / ratio}px ${(target.top - area.top + target.height * 0.45) / ratio}px`;
        };
        const phase = (name: "working" | "asking" | "running") => (box.dataset.phase = name);

        let began = 0;
        const tell = () => {
            const seconds = (performance.now() - began) / 1000;
            for (const time of turnTimes) time.textContent = `${38 + Math.floor(seconds)}s`;
            for (const time of callTimes) time.textContent = `${Math.max(0, Math.floor(seconds - 1.5))}s`;
        };
        const reset = () => {
            box.classList.remove("pressing", "wren-done");
            phase("working");
            pointer.classList.add("away");
            point("rest");
            mode("closed");
            began = performance.now();
            tell();
        };

        const beats: [number, () => void][] = [
            [0, reset],
            [1500, () => {
                phase("asking");
                mode("ask");
            }],
            [2600, () => {
                pointer.classList.remove("away");
                point("rest");
            }],
            [2700, () => point("allow")],
            [3800, () => box.classList.add("pressing")],
            [4050, () => {
                box.classList.remove("pressing");
                phase("running");
                mode("closed");
                point("rest");
            }],
            [4600, () => pointer.classList.add("away")],
            [5600, () => {
                box.classList.add("wren-done");
                mode("done");
            }],
            [8600, () => mode("closed")],
        ];

        let timers: number[] = [];
        let loop = 0;
        let clock = 0;
        const run = () => {
            for (const [at, beat] of beats) timers.push(window.setTimeout(beat, at));
        };
        const start = () => {
            if (loop) return;
            run();
            loop = window.setInterval(run, LOOP);
            clock = window.setInterval(tell, 250);
        };
        const stop = () => {
            clearInterval(loop);
            clearInterval(clock);
            loop = 0;
            for (const timer of timers) clearTimeout(timer);
            timers = [];
            reset();
        };

        document.fonts.ready.then(() => {
            if (still) {
                phase("asking");
                mode("ask");
                return;
            }
            reset();
            new IntersectionObserver(([entry]) => (entry.isIntersecting ? start() : stop()), { threshold: 0.35 }).observe(box);
        });
    }
</script>

<style>
    .pair {
        position: relative;
        width: 100%;
        max-width: 1100px;
        min-height: 640px;
        display: grid;
        align-items: end;
        --open: linear(0, 0.103, 0.311, 0.526, 0.705, 0.836, 0.922, 0.974, 1.001, 1.012, 1.015, 1.014, 1.01, 1.007, 1.004, 1.002, 1.001, 1, 1, 1, 1);
        --settle: linear(0, 0.078, 0.235, 0.401, 0.549, 0.669, 0.762, 0.831, 0.882, 0.918, 0.944, 0.962, 0.974, 0.982, 0.988, 0.992, 0.995, 0.996, 0.998, 0.998, 1);
    }
    .pair :global(.buddy svg *) {
        animation: none;
    }
    .laptop {
        width: 1312px;
        zoom: var(--s, 1);
        justify-self: start;
    }
    .mac {
        padding: 16px 16px 22px;
        background: #000;
        border-radius: 30px 30px 6px 6px;
        box-shadow: 0 0 0 2px #2a2a30 inset;
    }
    .screen {
        position: relative;
        width: 1280px;
        aspect-ratio: 1280 / 832;
        border-radius: 16px 16px 0 0;
        overflow: hidden;
        background:
            radial-gradient(1200px 700px at 30% 120%, #c9b8ff 0%, transparent 60%),
            radial-gradient(900px 600px at 85% 10%, #cfe0ff 0%, transparent 60%),
            linear-gradient(160deg, #f1ecff, #e6eefc);
    }
    :global(:root[data-theme="dark"]) .screen {
        background:
            radial-gradient(1200px 700px at 30% 120%, #5b3bb8 0%, transparent 60%),
            radial-gradient(900px 600px at 85% 10%, #33307a 0%, transparent 60%),
            linear-gradient(160deg, #1d1736, #151229);
    }
    .desk {
        position: absolute;
        top: 0;
        left: 0;
        width: 1280px;
        height: 832px;
        zoom: calc(1 / var(--s, 1));
        transform: scale(var(--s, 1));
        transform-origin: 0 0;
    }
    .base {
        position: relative;
        height: 26px;
        margin: 0 -28px;
        border-radius: 3px 3px 22px 22px;
        background: linear-gradient(#d9d6df, #a9a5b2 70%, #8d8996);
        box-shadow: 9px 9px 0 var(--cast);
    }
    .lip {
        position: absolute;
        left: 50%;
        top: 0;
        translate: -50% 0;
        width: 200px;
        height: 10px;
        border-radius: 0 0 12px 12px;
        background: #8d8996;
    }
    .menubar {
        position: absolute;
        inset: 0 0 auto;
        height: 37px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 14px 0 18px;
        font: 400 13px -apple-system, "SF Pro Text", system-ui, sans-serif;
        color: #1d1b22;
        background: rgba(255, 255, 255, 0.55);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
    }
    :global(:root[data-theme="dark"]) .menubar {
        color: #fff;
        background: rgba(0, 0, 0, 0.2);
        text-shadow: 0 0 6px rgba(0, 0, 0, 0.35);
    }
    .menubar .left {
        display: flex;
        align-items: center;
        gap: 19px;
    }
    .menubar b {
        font-weight: 700;
    }

    .window {
        position: absolute;
        left: 9%;
        right: 9%;
        top: 96px;
        bottom: 64px;
        border-radius: 12px;
        overflow: hidden;
        background: #f4f2f8;
        box-shadow: 0 20px 50px -20px rgba(20, 10, 40, 0.45), 0 0 0 1px rgba(0, 0, 0, 0.08);
        opacity: 0.78;
    }
    :global(:root[data-theme="dark"]) .window {
        background: #18152a;
        box-shadow: 0 20px 50px -20px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.06);
    }
    .chrome {
        display: flex;
        align-items: center;
        gap: 7px;
        height: 30px;
        padding: 0 12px;
        font: 500 11.5px -apple-system, system-ui, sans-serif;
        color: #8a8496;
        border-bottom: 1px solid rgba(0, 0, 0, 0.07);
    }
    .chrome i {
        width: 11px;
        height: 11px;
        border-radius: 50%;
        background: #d8d3e0;
    }
    :global(:root[data-theme="dark"]) .chrome i {
        background: #3a3644;
    }
    .chrome span {
        margin: 0 auto;
        translate: -24px 0;
    }
    .canvas {
        position: absolute;
        inset: 30px 0 0;
        display: grid;
        grid-template-columns: 220px minmax(0, 1fr) 240px;
        background: radial-gradient(rgba(120, 110, 140, 0.18) 1px, transparent 1.4px) 0 0 / 16px 16px;
    }
    .panel {
        background: rgba(255, 255, 255, 0.6);
        border-right: 1px solid rgba(0, 0, 0, 0.06);
    }
    :global(:root[data-theme="dark"]) .panel {
        background: rgba(255, 255, 255, 0.03);
        border-color: rgba(255, 255, 255, 0.05);
    }
    .panel.r {
        grid-column: 3;
        grid-row: 1;
        border-right: 0;
        border-left: 1px solid rgba(0, 0, 0, 0.06);
    }
    .frames {
        grid-column: 2;
        grid-row: 1;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        gap: 28px;
        padding-top: 56px;
    }
    .frame {
        width: 210px;
        height: 380px;
        border-radius: 6px;
        background: #fff;
        box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.07);
    }
    :global(:root[data-theme="dark"]) .frame {
        background: #231f3a;
        box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.07);
    }

    .island {
        --n-ink: #e7e5ef;
        --n-dim: #8b8898;
        --n-faint: #736f80;
        --n-live: #61ffca;
        --n-warn: #ffca85;
        --n-accent: #a277ff;
        --n-on-accent: #100e16;
        --run: 660ms;
        --curve: var(--settle);
        position: absolute;
        z-index: 2;
        top: 0;
        left: 50%;
        width: 520px;
        height: 240px;
        margin-left: -260px;
        white-space: nowrap;
        font: 400 13px/1.2 "Figtree", var(--sans);
        color: var(--n-ink);
        pointer-events: none;
        filter: drop-shadow(0 0 12px rgb(0 0 0 / 0));
        transition: filter var(--run) var(--curve);
    }
    .island:not([data-mode]) {
        visibility: hidden;
    }
    .island[data-mode="ask"],
    .island[data-mode="done"] {
        --run: 700ms;
        --curve: var(--open);
        filter: drop-shadow(0 0 12px rgb(0 0 0 / 0.7));
    }
    .shape {
        position: absolute;
        inset: 0;
        background: #000;
        transition: clip-path var(--run) var(--curve);
    }
    .island :global(.buddy) {
        width: 20px;
        height: 20px;
    }
    .band {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 37px;
        align-items: center;
        opacity: 0;
        filter: blur(20px);
        transition:
            opacity var(--run) var(--curve),
            filter var(--run) var(--curve);
    }
    [data-mode="closed"] .wings,
    [data-mode="ask"] .head,
    [data-mode="done"] .done {
        opacity: 1;
        filter: blur(0);
    }
    .wings {
        display: grid;
        grid-template-columns: 1fr 200px 1fr;
    }
    .wing {
        display: flex;
        align-items: center;
        height: 37px;
    }
    .wing.l {
        grid-column: 1;
        justify-self: end;
        padding: 0 10px 0 14px;
    }
    .wing.l :global(.buddy + .buddy) {
        margin-left: -3px;
    }
    .wing.r {
        grid-column: 3;
        justify-self: start;
        gap: 12px;
        padding: 0 14px 0 10px;
    }
    .pair:not(.wren-done) :global(.as-done),
    .pair.wren-done :global(.as-working) {
        display: none;
    }
    .group {
        display: flex;
        align-items: center;
        gap: 3px;
    }
    .count {
        width: 7.5px;
        text-align: center;
        font-size: 12px;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
    }
    .st {
        position: relative;
        flex: none;
        width: 16px;
        height: 16px;
        display: grid;
        place-items: center;
    }
    .st.blocked {
        color: var(--n-warn);
    }
    .st.finished {
        color: var(--n-accent);
    }
    .dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: currentColor;
    }
    .ping {
        position: absolute;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        border: 1.5px solid;
        opacity: 0;
    }
    [data-mode="ask"] .ping {
        animation: ping 520ms cubic-bezier(0.2, 0.6, 0.3, 1) both;
    }
    [data-mode="ask"] .ping + .ping {
        animation-delay: 380ms;
    }
    @keyframes ping {
        from {
            transform: scale(0.6);
            opacity: 0.9;
        }
        to {
            transform: scale(2.4);
            opacity: 0;
        }
    }
    .grid {
        display: grid;
        grid-template-columns: repeat(3, 2.5px);
        gap: 1.5px;
    }
    .grid i {
        width: 2.5px;
        height: 2.5px;
        border-radius: 0.5px;
        background: var(--n-live);
        animation: twinkle var(--p) ease-in-out var(--o) infinite;
    }
    @keyframes twinkle {
        0%,
        100% {
            opacity: 0.2;
        }
        40% {
            opacity: 1;
        }
    }
    .head {
        left: 52px;
        right: 52px;
        display: flex;
        justify-content: space-between;
    }
    .side {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .side.r,
    .side.dr {
        gap: 6px;
    }
    .lead {
        font-size: 13px;
        font-weight: 600;
    }
    .lead.small {
        font-size: 12.5px;
    }
    .trail {
        font-size: 12px;
        font-weight: 600;
        color: var(--n-warn);
    }
    .body {
        position: absolute;
        top: 37px;
        left: 52px;
        width: 416px;
        padding: 8px 0 16px;
        transform-origin: 50% 0;
        opacity: 0;
        transform: scale(0.8);
        transition:
            opacity 235ms var(--settle),
            transform 0s 235ms;
    }
    [data-mode="ask"] .body {
        opacity: 1;
        transform: scale(1);
        transition:
            opacity 510ms var(--settle),
            transform 510ms var(--settle);
    }
    .faint {
        display: flex;
        color: var(--n-faint);
    }
    .title {
        display: block;
        font-size: 13px;
        font-weight: 600;
    }
    .sub {
        display: flex;
        align-items: center;
        gap: 4px;
        margin-top: 2px;
        font-size: 11.5px;
        color: var(--n-dim);
    }
    .cmd {
        display: flex;
        gap: 8px;
        margin-top: 10px;
        padding: 9px 12px;
        border-radius: 10px;
        background: rgb(255 255 255 / 0.06);
        font: 400 12px/1.2 ui-monospace, "SF Mono", Menlo, monospace;
    }
    .actions {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
        margin-top: 10px;
    }
    .nbtn {
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        font-size: 12.5px;
        font-weight: 600;
        background: rgb(255 255 255 / 0.1);
    }
    .nbtn.primary {
        background: var(--n-accent);
        color: var(--n-on-accent);
        transition:
            transform 120ms,
            filter 120ms;
    }
    .pressing .nbtn.primary {
        filter: brightness(1.15);
        transform: scale(0.96);
    }
    .done {
        display: grid;
        grid-template-columns: 150px 200px 150px;
        justify-content: center;
    }
    .dl {
        grid-column: 1;
        padding-left: 14px;
    }
    .dr {
        grid-column: 3;
        min-width: 0;
        justify-content: flex-end;
        padding-right: 14px;
    }
    .what {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        font-size: 12.5px;
        font-weight: 500;
        color: var(--n-dim);
    }
    .pointer {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 3;
        transition: translate 900ms cubic-bezier(0.45, 0, 0.2, 1), opacity 300ms;
        filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.4));
    }
    .pointer.away {
        opacity: 0;
    }

    .phone {
        --pw: 290;
        --s: calc(var(--pw) * 0.952 / 402);
        position: absolute;
        right: 0;
        bottom: 0;
        z-index: 2;
        width: calc(var(--pw) * 1px);
        padding: calc(var(--pw) * 0.024px);
        display: grid;
        place-items: center;
        border-radius: calc(var(--pw) * 0.154px);
        background: #0b0b0e;
        box-shadow: 0 0 0 1px #2a2a30 inset, 10px 10px 0 var(--cast);
