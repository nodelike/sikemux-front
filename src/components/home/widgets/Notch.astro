    .pair[data-phase="working"] .p-asked,
    .pair[data-phase="asking"] .p-doing,
    .pair:not([data-phase="asking"]) .p-needs,
    .pair:not([data-phase="asking"]) .p-perm,
    .pair[data-phase="running"] .p-when-thinking,
