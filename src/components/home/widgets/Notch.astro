    @media (max-width: 680px) {
        .laptop-crop {
            position: relative;
            justify-self: center;
            width: calc(760px * var(--s, 0.4));
            height: calc(420px * var(--s, 0.4));
            overflow: hidden;
            border-radius: calc(30px * var(--s, 0.4)) calc(30px * var(--s, 0.4)) 0 0;
