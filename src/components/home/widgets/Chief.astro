---
import Head from "./chat/Head.astro";
import Bubble from "./chat/Bubble.astro";
import Run, { type Call as ToolCall } from "./chat/Run.astro";
import Prose from "./chat/Prose.astro";
import TurnLine from "./chat/TurnLine.astro";
import Composer from "./chat/Composer.astro";
import Decided from "./chief/Decided.astro";
import Docked from "./chief/Docked.astro";
import Tasks from "./chief/Tasks.astro";
import "./app.css";

const workers = [
    { name: "Otter", title: "Setup checklist", model: "Opus 5.5", took: 1.2 },
    { name: "Heron", title: "Invite step", model: "GPT-5.5", took: 1.1 },
    { name: "Wren", title: "Empty states", model: "Opus 5.5", took: 1 },
    { name: "Badger", title: "Sign-up tests", model: "Sonnet 5.5", took: 1.3 },
    { name: "Finch", title: "New flow docs", model: "Sonnet 5.5", took: 1.1 },
];
const plan: ToolCall[] = [
    { verb: "read", kind: "looked", icon: "file", target: "onboarding.md", took: 0.4, file: true },
    ...workers.map(({ name, title, model, took }): ToolCall => ({ verb: "start", kind: "ran", icon: "square-plus", target: title, took, starts: { name, title, model } })),
];
const question = "Sign-up: magic links or passwords?";
---

<div class="desk" data-play data-chief>
    <div class="app chief">
        <Head title="@Chief" agent="chief" fact="acme-shop" />
        <div class="pane">
            <div class="said">
                <Bubble>Ship the new onboarding by Friday.</Bubble>
                <Run calls={plan} wait={400} folds />
            </div>
            <div class="reply">
                <Prose wait={500}>Five on it. I'll settle what I can and ask you only what I can't.</Prose>
            </div>
            <div class="lines">
                <div data-step data-wait="1500"><Decided decision="No tour on first run" why="the checklist covers it" /></div>
                <div data-step data-wait="1300"><Decided decision="Kept the sign-up copy" why="no test asks for new" /></div>
            </div>
            <div class="tail">
                <div data-step data-wait="1300"><Docked asker="Chief" question={question} age="38m" /></div>
                <TurnLine agent="chief" word="Waiting on" tint="cmd" waitingOn={["Heron", "Badger"]} more={1} said="64 min" wait={300} />
            </div>
        </div>
        <Composer model="Opus 5.5" project="acme-shop" placeholder="Tell @Chief what you want, or type / for commands" />
    </div>
    <div class="side">
        <Tasks
            forYou={[{ mark: "call", title: question, fact: "2 choices", holder: "Chief", age: "38m" }]}
            finished={[
                { mark: "commit", title: "Setup checklist", fact: "landed 3f9c2a1 · CI green", holder: "Otter", age: "12m" },
                { mark: "commit", title: "Empty states", fact: "landed 8b41d0e · CI green", holder: "Wren", age: "6m" },
            ]}
        />
    </div>
</div>

<script>
    for (const box of document.querySelectorAll<HTMLElement>("[data-chief]")) {
        const room = box.parentElement!;
        const style = getComputedStyle(box);
        const size = (name: string) => Number(style.getPropertyValue(name));
        const fit = () => box.style.setProperty("--fit", String(Math.min(1, room.clientWidth / (size("--least") * size("--scale")))));
        new ResizeObserver(fit).observe(room);
        fit();
    }
</script>

<style>
    /* The app's one-line rows cut their text in a window narrower than --least, so a smaller one is the same picture scaled down. */
    .desk {
        --scale: 1.12;
        --least: 484;
        width: max(calc(100% / var(--scale)), calc(var(--least) * 1px));
        zoom: calc(var(--scale) * var(--fit, 1));
    }
    @media (min-width: 901px) {
        .desk {
            width: 100%;
        }
    }
    @media (max-width: 600px) {
        .desk {
            --scale: 1;
            --least: 400;
        }
    }
    .desk > .app {
        width: 100%;
    }
    .pane {
        display: flex;
        flex-direction: column;
        padding-top: 52px;
    }
    .said {
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        gap: 14px;
        height: 79px;
        padding: 0 22px;
    }
    .reply {
        padding: 14px 22px 4px;
    }
    .lines {
        display: flex;
        flex-direction: column;
        padding: 4px 10px;
    }
    .tail {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 10px 22px 22px;
    }
    .tail :global(.buttons:empty) {
        display: none;
    }
    .side {
        position: relative;
        z-index: 1;
        width: 88%;
        margin: -22px 0 0 auto;
        transform: translateX(8%);
    }
    .side > :global(.app) {
        width: 100%;
        box-shadow: 0 18px 48px rgb(0 0 0 / 0.18);
    }
</style>
