---
import Head from "./chat/Head.astro";
import Bubble from "./chat/Bubble.astro";
import Run, { type Call } from "./chat/Run.astro";
import AgentRow from "./chat/AgentRow.astro";
import "./app.css";

const workers = [
    { name: "Otter", agent: "claude", task: "Welcome checklist", age: "1m" },
    { name: "Heron", agent: "codex", task: "Invite step, and a review of Otter's diff", age: "1m" },
    { name: "Wren", agent: "claude", task: "Empty states for new projects", age: "1m" },
    { name: "Badger", agent: "pi", task: "Sign-up tests on iPhone", age: "1m" },
    { name: "Finch", agent: "hermes", task: "Docs for the new flow", age: "1m" },
] as const;
const plan: Call[] = [
    { verb: "read", kind: "looked", icon: "file", target: "onboarding.md", took: 0.4, file: true },
    { verb: "start", kind: "ran", icon: "square-plus", target: "claude agent", took: 1.2 },
    { verb: "start", kind: "ran", icon: "square-plus", target: "codex agent", took: 1.1 },
    { verb: "start", kind: "ran", icon: "square-plus", target: "claude agent", took: 1 },
    { verb: "start", kind: "ran", icon: "square-plus", target: "pi agent", took: 1.3 },
    { verb: "start", kind: "ran", icon: "square-plus", target: "hermes agent", took: 1.1 },
];
---

<div class="app chief" data-play data-chief>
    <Head title="New onboarding" who="@Chief" agent="chief" />
    <div class="beats">
        <div class="beat ask">
            <Bubble when="2:47 PM">Ship the new onboarding by Friday.</Bubble>
            <Run calls={plan} wait={400} />
        </div>

        <div class="beat crew" data-step="crew" data-wait="300">
            <p class="label">Agents</p>
            {workers.map((worker, index) => <AgentRow id={String(index)} task={worker.task} age={worker.age} project="acme-shop" name={worker.name} agent={worker.agent} state="working" />)}
        </div>

        <div class="beat away" data-step="away" data-wait="3600">
            <p class="by"><img src="/brand/mark-purple.svg" alt="" width="14" height="14" /><b>@Chief</b><span>while you were away</span></p>
            <div class="report">
                <p class="line"><span><b>4 landed.</b> Checklist, invite step, empty states and docs are on main.</span><span class="btn">Try it</span></p>
                <p class="line"><span>@Heron kept the old copy on step 2.</span><span class="btn">Overrule</span></p>
                <div class="call">
                    <p class="q">Sign-up: magic links or passwords?</p>
                    <div class="opts">
                        <p class="opt picked"><i class="radio"></i>Magic links<span class="pick"><img src="/brand/mark-purple.svg" alt="" width="11" height="11" />pick</span></p>
                        <p class="opt"><i class="radio"></i>Passwords</p>
                    </div>
                    <p class="go"><span class="btn primary">Go with this</span></p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const box of document.querySelectorAll<HTMLElement>("[data-chief]")) {
        const agents = [...box.querySelectorAll<HTMLElement>("[data-row]")];
        const finish = (agent: HTMLElement) => (agent.dataset.state = "done");
        box.addEventListener("step", (event) => {
            if ((event as CustomEvent).detail !== "crew") return;
            if (still) return agents.forEach(finish);
            agents.forEach((agent, index) => setTimeout(() => finish(agent), 1300 + index * 480));
        });
    }
</script>

<style>
    .beats {
        display: flex;
        flex-direction: column;
        gap: 14px;
        padding: 6px 22px 18px;
    }
    .ask {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    .crew {
        border-top: 1px solid var(--line);
        padding-top: 12px;
    }
    .label {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 4px;
        font-size: 10.5px;
        font-weight: 500;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--quiet);
    }
    .label::after {
        content: "";
        flex: 1;
        height: 1px;
        background: var(--line);
    }
    .away {
        display: flex;
        flex-direction: column;
        gap: 6px;
        border-top: 1px solid var(--line);
        padding-top: 12px;
    }
    .by {
        display: flex;
        align-items: center;
        gap: 8px;
        height: 22px;
        font-size: 12.5px;
        color: var(--quiet);
    }
    .by b {
        font-weight: 600;
        color: var(--ink);
    }
    .by span {
        margin-left: auto;
        font-size: 11.5px;
        color: var(--faint);
    }
    .report {
        display: flex;
        flex-direction: column;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: var(--raised);
        overflow: hidden;
    }
    .line {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 14px;
        border-bottom: 1px solid var(--line);
        font-size: 13.5px;
        line-height: 1.45;
    }
    .line > span:first-child {
        flex: 1;
    }
    .line b {
        font-weight: 600;
    }
    .btn {
        flex: none;
        display: inline-flex;
        align-items: center;
        height: 26px;
        padding: 0 10px;
        border-radius: 5px;
        border: 1px solid var(--strong);
        font-size: 12px;
        font-weight: 500;
        color: var(--ink);
    }
    .btn.primary {
        border-color: var(--accent);
        background: var(--accent);
        color: var(--ground);
    }
    .call {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 12px 14px 14px;
    }
    .q {
        font-size: 13.5px;
        font-weight: 600;
    }
    .opts {
        border: 1px solid var(--line);
        border-radius: 10px;
        overflow: hidden;
    }
    .opt {
        display: flex;
        align-items: center;
        gap: 10px;
        height: 32px;
        padding: 0 12px;
        font-size: 13px;
    }
    .opt + .opt {
        border-top: 1px solid var(--line);
    }
    .picked {
        background: var(--hover);
    }
    .radio {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        border: 1.5px solid var(--quiet);
    }
    .picked .radio {
        border: 3.5px solid var(--accent);
    }
    .pick {
        margin-left: auto;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 11.5px;
        color: var(--quiet);
    }
    .go {
        display: flex;
        justify-content: flex-end;
    }
</style>
