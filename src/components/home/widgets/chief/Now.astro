---
import Mark from "../chat/Mark.astro";

interface Row {
    name: string;
    fact: string;
    age: string;
}

interface Props {
    moving: Row[];
    later: { you: number; ready: number; moving: number; unsure: number };
}

const { moving, later } = Astro.props;
const shown = moving.slice(0, 4);
const rest = moving.slice(4);
const counts = [
    { tint: "mine", count: later.you },
    { tint: "ready", count: later.ready },
    { tint: "moving", count: later.moving },
    { tint: "unsure", count: later.unsure },
];
const chevron = '<path d="m9 18 6-6-6-6"/>';
---

<div class="now" data-step="now" data-wait="300">
    <div class="face open">
        <p class="head">
            <Mark agent="chief" size={14} />
            <b>Now</b>
            <span class="agents">· {moving.length} agents</span>
            <i class="grow"></i>
            <span class="chevron"><svg viewBox="0 0 24 24" set:html={chevron} /></span>
        </p>
        <div class="body">
            <div class="group">
                <p class="label"><span class="caps">Moving</span><span class="count">{moving.length}</span><i class="hair"></i></p>
                {
                    shown.map((row) => (
                        <p class="line">
                            <Mark who={row.name} size={12.5} />
                            <span class="name">@{row.name}</span>
                            <span class="fact">{row.fact}</span>
                            <span class="age">{row.age}</span>
                        </p>
                    ))
                }
                {
                    rest.length > 0 && (
                        <p class="line">
                            <span class="marks">
                                {rest.slice(0, 4).map((row) => (
                                    <span class="tile">
                                        <Mark who={row.name} size={11} />
                                    </span>
                                ))}
                            </span>
                            <span class="fact">{rest.map((row) => `@${row.name}`).join(", ")}</span>
                        </p>
                    )
                }
            </div>
        </div>
    </div>
    <p class="face folded">
        {
            counts.map(({ tint, count }) => (
                <span class:list={["tally", tint, { none: count === 0 }]}>
                    <i class="dot" />
                    {count}
                </span>
            ))
        }
        <span class="chevron"><svg viewBox="0 0 24 24" set:html={chevron} /></span>
    </p>
</div>

<style>
    .now {
        position: absolute;
        top: 12px;
        right: 16px;
        z-index: 1;
        max-width: calc(100% - 32px);
    }
    .face {
        border: 1px solid var(--border);
        background: var(--surface-raised);
        box-shadow:
            0 8px 16px -8px rgb(0 0 0 / 0.44),
            0 28px 64px -16px rgb(0 0 0 / 0.62);
    }
    .open {
        display: flex;
        flex-direction: column;
        width: 356px;
        max-width: 100%;
        border-radius: 14px;
        overflow: hidden;
    }
    .folded {
        display: none;
        align-items: center;
        gap: 2px;
        height: 34px;
        padding: 0 4px 0 5px;
        border-radius: 999px;
    }
    :global(.app.chief:has([data-step="away"].on)) .open {
        display: none;
    }
    :global(.app.chief:has([data-step="away"].on)) .folded {
        display: flex;
    }
    .head {
        display: flex;
        align-items: center;
        gap: 8px;
        height: 44px;
        padding: 0 8px 0 16px;
        border-bottom: 1px solid var(--line-soft);
        white-space: nowrap;
    }
    .head b {
        font-size: 13px;
        font-weight: 600;
        color: var(--text-primary);
    }
    .agents {
        font-size: 12px;
        color: var(--text-tertiary);
    }
    .grow {
        flex: 1;
    }
    .chevron {
        flex: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 24px;
        height: 24px;
        color: var(--text-tertiary);
    }
    .chevron svg {
        width: 10px;
        height: 10px;
        rotate: 90deg;
    }
    .open .chevron svg {
        rotate: -90deg;
    }
    .body {
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 6px 8px 10px;
    }
    .group {
        display: flex;
        flex-direction: column;
    }
    .label {
        display: flex;
        align-items: center;
        gap: 8px;
        height: 24px;
        padding: 0 10px;
    }
    .caps {
        flex: none;
        font-size: 11px;
        font-weight: 500;
        line-height: 16px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--text-tertiary);
    }
    .count {
        flex: none;
        font-size: 11px;
        font-variant-numeric: tabular-nums;
        color: var(--text-tertiary);
    }
    .hair {
        flex: 1;
        height: 1px;
        background: var(--border);
    }
    .line {
        display: flex;
        align-items: center;
        gap: 10px;
        height: 30px;
        padding: 0 10px;
        border-radius: 5px;
        white-space: nowrap;
    }
    .name {
        flex: none;
        width: 84px;
        overflow: hidden;
        text-overflow: ellipsis;
        font-size: 12.5px;
        font-weight: 500;
        color: var(--text-primary);
    }
    .fact {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        font-size: 12.5px;
        color: var(--text-secondary);
    }
    .age {
        flex: none;
        min-width: 28px;
        text-align: right;
        font-size: 11px;
        font-variant-numeric: tabular-nums;
        color: var(--text-tertiary);
    }
    .marks {
        flex: none;
        display: inline-flex;
        align-items: center;
    }
    .tile {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 18px;
        height: 18px;
        border: 2px solid var(--surface-raised);
        border-radius: 5px;
        background: var(--surface-active);
    }
    .tile + .tile {
        margin-left: -4px;
    }
    .tally {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        height: 24px;
        padding: 0 9px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
        color: var(--text-secondary);
    }
    .tally.none {
        color: var(--text-disabled);
    }
    .tally.mine:not(.none) {
        background: color-mix(in srgb, var(--accent) 16%, transparent);
        color: var(--accent);
    }
    .dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
    }
    .mine .dot {
        background: var(--accent);
    }
    .ready .dot {
        background: var(--live);
    }
    .moving .dot {
        background: var(--text-tertiary);
    }
    .unsure .dot {
        background: var(--warn);
    }
</style>
