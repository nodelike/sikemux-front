---
import AgentName from "../../../AgentName.astro";
import Mark from "../chat/Mark.astro";

interface Decided {
    decision: string;
    after: string;
}

interface Landed {
    name: string;
    title: string;
    change: string;
    dels: number;
    adds: number;
    tryIt?: boolean;
}

interface Props {
    gone: string;
    needs: number;
    decided: Decided[];
    landed: Landed[];
}

const { gone, needs, decided, landed } = Astro.props;
---

<div class="away">
    <p class="head"><Mark agent="chief" size={16} /><b>While you were away</b><span>· {gone}</span></p>
    <p class="section"><span class="caps">Needs you</span><span class="count">{needs}</span><i class="hair"></i></p>
    <div class="queue"><slot /></div>
    <p class="section"><span class="caps">Decided for you</span><span class="count">{decided.length}</span><i class="hair"></i></p>
    {
        decided.map((row) => (
            <p class="line">
                <span class="tick">
                    <svg viewBox="0 0 24 24">
                        <path d="M20 6 9 17l-5-5" />
                    </svg>
                </span>
                <span class="what">{row.decision}</span>
                <span class="after">· {row.after}</span>
                <span class="overrule">Overrule</span>
            </p>
        ))
    }
    <p class="section"><span class="caps">Landed</span><span class="count">{landed.length}</span><i class="hair"></i></p>
    {
        landed.map((row) => (
            <p class="line">
                <AgentName name={row.name} chip />
                <span class="what">{row.title}</span>
                <span class="change">· {row.change}</span>
                <span class="lines">
                    <i class="dels">−{row.dels}</i>
                    <i class="adds">+{row.adds}</i>
                </span>
                <i class="grow" />
                {row.tryIt && <span class="try">Try it</span>}
            </p>
        ))
    }
</div>

<style>
    .away {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 12px;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: var(--surface-raised);
        container-type: inline-size;
    }
    .head {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        line-height: 21px;
        white-space: nowrap;
    }
    .head b {
        font-weight: 600;
        color: var(--text-primary);
    }
    .head span:last-child {
        font-size: 11.5px;
        color: var(--text-tertiary);
    }
    .section {
        display: flex;
        align-items: center;
        gap: 8px;
        padding-top: 4px;
    }
    .caps {
        flex: none;
        font-size: 11px;
        font-weight: 500;
        line-height: 16px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--text-tertiary);
    }
    .count {
        flex: none;
        font-size: 11px;
        color: var(--text-tertiary);
    }
    .hair {
        flex: 1;
        height: 1px;
        background: var(--line);
    }
    .queue {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    .line {
        display: flex;
        align-items: center;
        gap: 9px;
        height: 30px;
        padding-left: 8px;
        font-size: 13px;
        color: var(--text-primary);
        white-space: nowrap;
    }
    .line :global(.agent-chip) {
        font-size: 12px;
    }
    .tick {
        flex: none;
        display: inline-flex;
        justify-content: center;
        width: 20px;
        color: var(--text-tertiary);
    }
    .tick svg {
        width: 12px;
        height: 12px;
    }
    .what {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .after {
        flex: 1;
        min-width: 80px;
        overflow: hidden;
        text-overflow: ellipsis;
        color: var(--text-tertiary);
    }
    .overrule {
        flex: none;
        padding-right: 8px;
        font-size: 12px;
        color: var(--text-secondary);
    }
    .change {
        flex-shrink: 1000;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        color: var(--text-tertiary);
    }
    @media (max-width: 600px) {
        @container (max-width: 410px) {
            .change {
                display: none;
            }
        }
    }
    .lines {
        flex: none;
        display: inline-flex;
        gap: 5px;
    }
    .lines i {
        font-style: normal;
    }
    .dels {
        color: var(--git-deleted);
    }
    .adds {
        color: var(--git-added);
    }
    .grow {
        flex: 1;
        min-width: 8px;
    }
    .try {
        flex: none;
        display: inline-flex;
        align-items: center;
        height: 22px;
        padding: 0 10px;
        border-radius: 4.4px;
        background: var(--accent);
        font-size: 12px;
        font-weight: 600;
        color: var(--on-accent);
    }
</style>
