---
import AgentName from "../../../AgentName.astro";

interface Props {
    asker: string;
    age: string;
    question: string;
    options: string[];
    pick: string;
}

const { asker, age, question, options, pick } = Astro.props;
---

<div class="panel">
    <div class="card">
        <p class="who"><AgentName name={asker} chip /><i>·</i><span>{age}</span></p>
        <p class="question">{question}</p>
        <div class="options">
            {
                options.map((option) => (
                    <p class:list={["option", { chosen: option === pick }]}>
                        <i class="radio" />
                        {option}
                        {option === pick && (
                            <span class="pick">
                                <span class="pick-mark"><img src="/brand/mark-purple.svg" alt="" width="17" height="17" /></span>
                                pick
                            </span>
                        )}
                    </p>
                ))
            }
            <p class="note">
                <svg viewBox="0 0 24 24"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path><path d="m15 5 4 4"></path></svg>
                Add a note…
            </p>
        </div>
        <p class="foot"><span class="go">Go with this</span></p>
    </div>
</div>

<style>
    .panel {
        padding: 6px;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: var(--surface-overlay);
        box-shadow:
            0 2px 4px rgb(0 0 0 / 0.35),
            0 14px 40px rgb(0 0 0 / 0.45);
    }
    .card {
        display: flex;
        flex-direction: column;
        padding: 10px;
    }
    .who {
        display: flex;
        align-items: center;
        gap: 7px;
        height: 20px;
        font-size: 12px;
        color: var(--text-tertiary);
    }
    .who i {
        font-style: normal;
        color: var(--text-disabled);
    }
    .question {
        margin: 8px 0 15px;
        font-size: 15px;
        font-weight: 600;
        line-height: 1.35;
        color: var(--text-primary);
    }
    .options {
        display: flex;
        flex-direction: column;
        border: 1px solid var(--line);
        border-radius: 8px;
        overflow: hidden;
    }
    .option {
        display: flex;
        align-items: center;
        gap: 10px;
        min-height: 34px;
        padding: 7px 12px;
        font-size: 13px;
        line-height: 1.5;
        color: var(--text-primary);
    }
    .option + .option {
        border-top: 1px solid var(--line);
    }
    .chosen {
        background: var(--surface-chosen);
    }
    .radio {
        flex: none;
        width: 13px;
        height: 13px;
        border-radius: 50%;
        border: 1.5px solid var(--text-disabled);
    }
    .chosen .radio {
        border: 4px solid var(--accent);
        background: var(--on-accent);
    }
    .pick {
        flex: none;
        margin-left: auto;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding-left: 8px;
        font-size: 11px;
        color: var(--text-tertiary);
    }
    .pick-mark {
        flex: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 12px;
        height: 12px;
    }
    .pick-mark img {
        flex: none;
        width: 17px;
        height: 17px;
        max-width: none;
    }
    .note {
        display: flex;
        align-items: center;
        gap: 10px;
        height: 34px;
        padding: 0 12px;
        border-top: 1px solid var(--line);
        background: var(--surface-sunken);
        font-size: 13px;
        color: var(--text-disabled);
    }
    .note svg {
        flex: none;
        width: 11px;
        height: 11px;
    }
    .foot {
        display: flex;
        justify-content: flex-end;
        gap: 4px;
        margin-top: 14px;
    }
    .go {
        display: inline-flex;
        align-items: center;
        height: 26px;
        padding: 0 11px;
        border-radius: 5.2px;
        background: var(--accent);
        font-size: 12px;
        font-weight: 600;
        color: var(--on-accent);
    }
</style>
