---
interface Props {
    label: string;
}

const { label } = Astro.props;
---

<section class="frame bento" aria-label={label}>
    <slot />
</section>

<style>
    .bento {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1px;
        border-top: 1px solid var(--rule);
        background: var(--rule);
    }
    .bento :global(.board .app:not(.part)) {
        width: 100%;
        zoom: 1;
        border-radius: 14px;
        border-color: var(--edge);
        box-shadow:
            0 1px 2px rgba(18, 16, 23, 0.06),
            0 20px 34px -22px color-mix(in srgb, var(--violet-ink) 60%, transparent);
    }
    .bento :global(.sizes .foot) {
        display: none;
    }
    @media (max-width: 900px) {
        .bento {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
