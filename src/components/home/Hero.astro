---
import type { ImageMetadata } from "astro";
import { Image, getImage } from "astro:assets";
import hero from "../../assets/hero/hero.png";
import day from "../../assets/hero/day.jpg";
import dayTall from "../../assets/hero/day-tall.jpg";
import night from "../../assets/hero/night.jpg";
import nightTall from "../../assets/hero/night-tall.jpg";
import Install from "./Install.astro";
import Icon from "../Icon.astro";
import { REPO_URL, formatSize, type Release } from "../../lib/release";

interface Props {
    release: Release;
}

const { release } = Astro.props;
const size = release.dmgBytes === null ? "about 25 MB" : formatSize(release.dmgBytes);
const points = [
    { icon: "M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20M12 2a10 10 0 1 1 0 20 10 10 0 0 1 0-20", title: "Your subscriptions.", body: "Claude Code, Codex and five more, on the subscriptions you already have." },
    { icon: "M13 2 3 14h9l-1 8 10-12h-9z", title: "Native, not Electron.", body: `Drawn on the GPU. The whole app downloads at ${size}.` },
    { icon: "M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z", title: "Agents that talk.", body: "They message each other, hand off work and ask only what's yours to decide." },
    { icon: "M5 2h14a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1zM10 18h4", title: "Answer from anywhere.", body: "The MacBook notch asks for you. Away from the desk, your phone does." },
];

const painting = async (wide: ImageMetadata, tall: ImageMetadata) => ({
    wide: await getImage({ src: wide, format: "avif", quality: 55 }),
    tall: await getImage({ src: tall, format: "avif", quality: 55 }),
});
const skies = [
    { theme: "day", shownFirst: true, ...(await painting(day, dayTall)) },
    { theme: "night", shownFirst: false, ...(await painting(night, nightTall)) },
];
---

<section class="hero">
    <div class="art">
        {
            skies.map((sky) => (
                <picture class:list={["sky", sky.theme]}>
                    <source media="(max-width: 999px)" srcset={sky.tall.src} />
                    <img src={sky.wide.src} alt="" decoding="async" loading={sky.shownFirst ? "eager" : "lazy"} fetchpriority={sky.shownFirst ? "high" : "auto"} />
                </picture>
            ))
        }
        <div class="stage">
            <div class="copy">
                <h1><span class="line">A whole team of AI</span> <span class="line">coders, <span class="chip">in one window.</span></span></h1>
                <p class="lede">
                    Claude Code, Codex and more, side by side in one native app. See who’s working, who’s stuck and who needs you.
                </p>
                <div class="row">
                    <Install />
                    <a class="btn solid" href={release.dmgUrl} data-release-dmg>
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.4 12.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8 1.6 0 2 .8 3.4.8 1.4 0 2.3-1.3 3.1-2.5 1-1.4 1.4-2.8 1.4-2.9-.1 0-2.7-1-2.7-4.1zM13.9 5.1c.7-.9 1.2-2 1-3.2-1 0-2.3.7-3 1.6-.7.8-1.2 2-1.1 3.1 1.1.1 2.3-.6 3.1-1.5z"></path></svg>
                        Download for Mac
                    </a>
                    <a class="btn ghost" href={REPO_URL}><Icon name="github" size={18} />Star</a>
                </div>
                <p class="fine mono"><span>Apple Silicon Mac and Linux</span><span class="sep"> · </span><span><span data-release-size>{size}</span> · free, MIT</span></p>
            </div>
            <figure class="shot window">
                <Image src={hero} alt="Sikemux with Claude Code fixing a checkout bug, its browser tab open on the shop's cart page and the project's other agents listed on the right" widths={[828, 1560, 2340, 3120]} sizes="(min-width: 1000px) 50vw, 100vw" format="avif" quality={72} loading="eager" />
            </figure>
        </div>
    </div>

    <ul class="frame points">
        {
            points.map((point) => (
                <li>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d={point.icon} /></svg>
                    <p><b>{point.title}</b> {point.body}</p>
                </li>
            ))
        }
    </ul>
</section>

<style>
    .art {
        --side: max(24px, (100% - 1240px) / 2);
        position: relative;
        isolation: isolate;
        overflow: clip;
        margin-top: calc(-1 * var(--nav));
        border-bottom: 1px solid var(--rule);
        background: var(--paper);
    }
    .sky {
        position: absolute;
        inset: 0;
        z-index: -1;
    }
    .sky img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 100% 100%;
    }
    .night,
    :global(:root[data-theme="dark"]) .day {
        display: none;
    }
    :global(:root[data-theme="dark"]) .night {
        display: block;
    }
    .stage {
        display: grid;
        grid-template-columns: min-content minmax(0, 1fr);
        column-gap: 40px;
        min-height: clamp(600px, 100svh, min(62vw, 1040px));
        margin-left: calc(var(--side) + 20px);
        margin-right: max(32px, var(--side) - 200px);
        padding: calc(var(--nav) + 28px) 0 48px;
    }
    .copy {
        grid-area: 1 / 1;
        align-self: end;
        display: grid;
        gap: 18px;
        justify-items: start;
    }
    .window {
        --lift: clamp(8px, 0.8vw, 12px);
        grid-area: 1 / 2;
        align-self: start;
        justify-self: end;
        width: min(100%, 1000px);
        margin: 0;
        border-color: var(--cast-edge);
        box-shadow: var(--lift) var(--lift) 0 var(--violet);
    }
    h1 {
        font-size: clamp(34px, 3.45vw, 56px);
    }
    .line {
        display: block;
        white-space: nowrap;
    }
    .lede {
        font-size: 18px;
        line-height: 1.5;
        color: var(--ink-2);
        max-width: 30em;
    }
    .row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        width: 100%;
        min-width: 0;
    }
    .row :global(.install) {
        flex: 1 1 100%;
    }
    .row .btn.ghost {
        background: color-mix(in srgb, var(--paper) 50%, transparent);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }
    .row .btn.ghost:hover {
        background: var(--ink);
    }
    .fine {
        font-size: 12px;
        color: var(--ink-2);
    }
    .fine span {
        white-space: nowrap;
    }

    .points {
        list-style: none;
        margin: 0 auto;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .points li {
        padding: 28px 20px 34px;
        border-right: 1px solid var(--rule);
        display: grid;
        gap: 16px;
        align-content: start;
    }
    .points li:last-child {
        border-right: 0;
    }
    .points svg {
        width: 22px;
        height: 22px;
        fill: none;
        stroke: var(--ink);
        stroke-width: 1.6;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .points p {
        font-size: 15px;
        line-height: 1.5;
        color: var(--ink-2);
    }
    .points b {
        color: var(--ink);
        font-weight: 500;
    }

    @media (max-width: 999px) {
        .sky img {
            object-position: 30% 100%;
        }
        .stage {
            grid-template-columns: minmax(0, 1fr);
            row-gap: clamp(28px, 6vw, 44px);
            min-height: 0;
            margin-inline: var(--side);
            padding: calc(var(--nav) + clamp(48px, 13vw, 96px)) 0 max(250px, 48vw);
        }
        .copy,
        .window {
            grid-area: auto;
        }
        .copy {
            max-width: 560px;
        }
        .window {
            width: 100%;
        }
        h1 {
            font-size: clamp(30px, 8.4vw, 52px);
        }
        .line {
            display: inline;
            white-space: normal;
        }
    }
    @media (max-width: 900px) {
        .points {
            grid-template-columns: 1fr 1fr;
        }
        .points li:nth-child(2) {
            border-right: 0;
        }
        .points li:nth-child(-n + 2) {
            border-bottom: 1px solid var(--rule);
        }
    }
    @media (max-width: 600px) {
        .lede {
            font-size: 16px;
        }
        .fine .sep {
            display: block;
            height: 0;
            overflow: hidden;
        }
    }
    @media (max-width: 520px) {
        .points {
            grid-template-columns: 1fr;
        }
        .points li {
            border-right: 0;
            border-bottom: 1px solid var(--rule);
        }
    }
</style>
