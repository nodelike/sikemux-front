---
import Scene from "./Scene.astro";
import { ANDROID, APPLE, LINUX } from "../../lib/marks";
import { APP_STORE_URL, BREW_COMMAND, INSTALL_COMMAND, RELEASES_URL, formatSize, type Release } from "../../lib/release";
import gateDay from "../../assets/art/gate-day.jpg";
import gateNight from "../../assets/art/gate-night.jpg";
import { copyFor } from "../../i18n";

interface Props {
    release: Release;
}

const { release } = Astro.props;
const copy = copyFor(Astro.currentLocale);
const t = copy.downloads;

const commands = [
    { note: t.commands.brew, command: BREW_COMMAND },
    { note: t.commands.curl, command: INSTALL_COMMAND },
    { note: t.commands.host, command: `${INSTALL_COMMAND} -s -- --host` },
];
const computers = [
    { name: "macOS", mark: APPLE, needs: t.needs.macOS },
    { name: "Linux", mark: LINUX, needs: t.needs.linux },
];
const phones = [
    { name: "iPhone", mark: APPLE, needs: t.needs.iPhone, label: t.appStore, href: APP_STORE_URL, arrow: "M7 17 17 7M8 7h9v9" },
    { name: "Android", mark: ANDROID, needs: t.needs.android, label: t.joinTest, href: "/phone", arrow: "M5 12h14M13 6l6 6-6 6" },
];
---

<Scene tag={t.tag} id="download" ground={0.21} stacked={0.3} art={{ day: gateDay, night: gateNight, subject: 0.36 }}>
    <Fragment slot="title">{t.title.lead}<span class="chip">{t.title.chip}</span></Fragment>
    <p>{t.body}</p>
    <p class="fine mono">
        v<span data-release-version>{release.version}</span> · <a href="/changelog">{t.whatsNew}</a> · <a href={RELEASES_URL}>{t.everyRelease}</a>
    </p>

    <div class="term" slot="media" data-term data-copy-label={copy.install.copy} data-copied-label={copy.install.copied}>
        <div class="bar mono">
            <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
            {t.terminal}
        </div>
        <ul>
            {
                commands.map((entry) => (
                    <li>
                        <span class="note mono"># {entry.note}</span>
                        <code class="mono">{entry.command}</code>
                        <button type="button" class="copy mono" data-copy={entry.command} aria-label={t.copyFor(entry.note)}>
                            {copy.install.copy}
                        </button>
                    </li>
                ))
            }
        </ul>
        <p class="idle mono" aria-hidden="true"><span class="caret"></span></p>
    </div>

    <ul class="platforms" slot="below">
        {
            computers.map((computer) => (
                <li>
                    <svg class="mark" viewBox={computer.mark.viewBox} aria-hidden="true">
                        <path d={computer.mark.path} />
                    </svg>
                    <h3>{computer.name}</h3>
                    <p class="needs mono">{computer.needs}</p>
                    <div class="gets">
                        {release.builds
                            .filter((build) => build.system === computer.name)
                            .map((build) => (
                                <a class:list={["btn", { solid: build.system === "macOS" }]} href={build.url} data-release-build={build.suffix}>
                                    <svg class="glyph" viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 20h14" />
                                    </svg>
                                    {build.system === "macOS" ? copy.hero.download : build.label}
                                    {build.bytes !== null && (
                                        <span class="size mono" data-release-build-size={build.suffix}>
                                            {formatSize(build.bytes)}
                                        </span>
                                    )}
                                </a>
                            ))}
                    </div>
                </li>
            ))
        }
        {
            phones.map((phone) => (
                <li>
                    <svg class="mark" viewBox={phone.mark.viewBox} aria-hidden="true">
                        <path d={phone.mark.path} />
                    </svg>
                    <h3>{phone.name}</h3>
                    <p class="needs mono">{phone.needs}</p>
                    <div class="gets">
                        <a class="btn" href={phone.href}>
                            {phone.label}
                            <svg class="glyph end" viewBox="0 0 24 24" aria-hidden="true">
                                <path d={phone.arrow} />
                            </svg>
                        </a>
                    </div>
                </li>
            ))
        }
    </ul>
</Scene>

<script>
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-term] [data-copy]")) {
        const { copyLabel, copiedLabel } = button.closest<HTMLElement>("[data-term]")!.dataset;
        button.addEventListener("click", async () => {
            await navigator.clipboard.writeText(button.dataset.copy!);
            button.textContent = copiedLabel!;
            setTimeout(() => (button.textContent = copyLabel!), 1400);
        });
    }
</script>

<style>
    .fine {
        font-size: 12px;
        color: var(--ink-2);
    }
    .fine a {
        text-underline-offset: 3px;
    }
    .fine a:hover {
        color: var(--ink);
    }

    .term {
        --dim: #a7a2b6;
        --hair: #ffffff1f;
        width: min(100%, 600px);
        background: var(--night);
        color: var(--on-night);
        border: 1px solid var(--cast-edge);
        box-shadow: 9px 9px 0 var(--cast);
    }
    .bar {
        display: flex;
        align-items: center;
        gap: 12px;
        height: 34px;
        padding: 0 12px;
        font-size: 12px;
        color: var(--dim);
        border-bottom: 1px solid var(--hair);
    }
    .lights {
        display: flex;
        gap: 6px;
    }
    .lights i {
        width: 9px;
        height: 9px;
        border: 1px solid #ffffff47;
    }
    .term ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }
    .term li {
        display: grid;
        grid-template: "note note" auto "code copy" auto / minmax(0, 1fr) auto;
        gap: 8px 12px;
        padding: 14px 12px 14px 14px;
        border-bottom: 1px solid var(--hair);
    }
    .note {
        grid-area: note;
        font-size: 12px;
        line-height: 1.4;
        color: var(--dim);
    }
    code {
        grid-area: code;
        padding-left: 2ch;
        text-indent: -2ch;
        font-size: 13.5px;
        line-height: 1.5;
        overflow-wrap: anywhere;
    }
    code::before,
    .idle::before {
        content: "$ ";
        color: var(--violet);
    }
    .copy {
        grid-area: copy;
        align-self: start;
        margin-top: -3px;
        padding: 6px 9px;
        font-size: 12px;
        line-height: 1;
        color: var(--dim);
        background: none;
        border: 1px solid var(--hair);
        cursor: pointer;
    }
    .copy:hover {
        color: #fff;
        border-color: #ffffff66;
    }
    .idle {
        padding: 14px;
        font-size: 13.5px;
        line-height: 1.5;
    }
    .caret {
        display: inline-block;
        width: 7px;
        height: 1.05em;
        vertical-align: -0.15em;
        background: var(--violet);
        animation: w-blink 1s steps(1) infinite;
    }

    .platforms {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        border-top: 1px solid var(--rule);
        background: var(--paper);
    }
    .platforms li {
        display: grid;
        grid-template-rows: auto auto auto 1fr;
        gap: 10px;
        padding: 26px 20px 28px;
        border-right: 1px solid var(--rule);
    }
    .platforms li:last-child {
        border-right: 0;
    }
    .mark {
        width: 22px;
        height: 22px;
        margin-bottom: 8px;
        fill: var(--ink);
    }
    h3 {
        font-size: clamp(22px, 2vw, 28px);
        line-height: 1.05;
    }
    .needs {
        font-size: 12.5px;
        line-height: 1.4;
        color: var(--ink-2);
    }
    .gets {
        display: grid;
        gap: 8px;
        align-content: end;
        margin-top: 14px;
    }
    .gets .btn {
        height: 44px;
        padding: 0 14px;
    }
    .glyph {
        flex: none;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .size,
    .glyph.end {
        margin-left: auto;
    }
    .size {
        font-size: 12px;
        opacity: 0.72;
    }

    @media (max-width: 1100px) {
        .platforms {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .platforms li:nth-child(2) {
            border-right: 0;
        }
        .platforms li:nth-child(-n + 2) {
            border-bottom: 1px solid var(--rule);
        }
    }
    @media (max-width: 560px) {
        .term li {
            grid-template-areas: "note copy" "code code";
            align-items: center;
        }
        .copy {
            align-self: center;
            margin-top: 0;
        }
        code,
        .idle {
            font-size: 12.5px;
        }
        .platforms {
            grid-template-columns: minmax(0, 1fr);
        }
        .platforms li {
            grid-template: auto auto auto / auto minmax(0, 1fr);
            align-items: center;
            gap: 8px 12px;
            padding: 20px 16px 22px;
            border-right: 0;
            border-bottom: 1px solid var(--rule);
        }
        .platforms li:last-child {
            border-bottom: 0;
        }
        .mark {
            margin-bottom: 0;
        }
        .needs,
        .gets {
            grid-column: 1 / -1;
        }
        .gets {
            margin-top: 8px;
        }
    }
</style>
