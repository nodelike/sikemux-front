---
import Scene from "./Scene.astro";
import Bento from "./Bento.astro";
import Cell from "./Cell.astro";
import Tools from "./Tools.astro";
import AgentName from "../AgentName.astro";
import Chat from "./widgets/Chat.astro";
import Chief from "./widgets/Chief.astro";
import Team from "./widgets/Team.astro";
import Sizes from "./widgets/Sizes.astro";
import Notch from "./widgets/Notch.astro";
import Review from "./widgets/Review.astro";
import Mentions from "./elements/Mentions.astro";
import Limits from "./elements/Limits.astro";
import Stash from "./elements/Stash.astro";
import Moods from "./elements/Moods.astro";
import Sketch from "./elements/Sketch.astro";
import handoffDay from "../../assets/art/handoff-day.jpg";
import handoffNight from "../../assets/art/handoff-night.jpg";
import chiefDay from "../../assets/art/chief-day.jpg";
import chiefNight from "../../assets/art/chief-night.jpg";
import signalsDay from "../../assets/art/signals-day.jpg";
import signalsNight from "../../assets/art/signals-night.jpg";
import jettyDay from "../../assets/art/jetty-day.jpg";
import jettyNight from "../../assets/art/jetty-night.jpg";
import doveDay from "../../assets/art/dove-day.jpg";
import doveNight from "../../assets/art/dove-night.jpg";
import { copyFor } from "../../i18n";

const t = copyFor(Astro.currentLocale).features;
const { more, cells } = t;
---

<Scene tag={t.carryOn.tag} id="carry-on" art={{ day: handoffDay, night: handoffNight, subject: 0.2 }}>
    <Fragment slot="title">{t.carryOn.title.lead}<br /><span class="chip">{t.carryOn.title.chip}</span></Fragment>
    <p>{t.carryOn.body}</p>
    <Chat slot="media" />
</Scene>

<Bento label={more.label}>
    <Cell tag={more.mentions.tag} small>
        <Mentions slot="board" />
        <p>{more.mentions.body}</p>
    </Cell>
    <Cell tag={more.limits.tag} small>
        <Limits slot="board" />
        <p>{more.limits.body}</p>
    </Cell>
    <Cell tag={more.stash.tag} small>
        <Stash slot="board" />
        <p>{more.stash.body}</p>
    </Cell>
</Bento>

<Scene tag={t.chief.tag} id="chief" flip stacked={0.36} art={{ day: chiefDay, night: chiefNight, subject: 0.68 }}>
    <Fragment slot="title">{t.chief.title.lead}<br /><span class="chip">{t.chief.title.chip}</span></Fragment>
    <p>{t.chief.ask.before}<AgentName name="Chief" />{t.chief.ask.after}</p>
    <p>{t.chief.back}</p>
    <Chief slot="media" />
</Scene>

<Scene tag={t.teammates.tag} id="teammates" wide ground={0.19} art={{ day: signalsDay, night: signalsNight }}>
    <Fragment slot="title">{t.teammates.title.lead}<br /><span class="chip">{t.teammates.title.chip}</span></Fragment>
    <p>{t.teammates.body}</p>
    <Team slot="media" />
</Scene>

<Bento label={cells.label}>
    <Cell tag={cells.buddies.tag} id="buddies" ground="violet">
        <Moods slot="board" />
        <Fragment slot="title">{cells.buddies.title.lead}<br /><span class="chip">{cells.buddies.title.chip}</span></Fragment>
        <p>{cells.buddies.body}</p>
    </Cell>
    <Cell tag={cells.browser.tag} id="browser">
        <Sizes slot="board" />
        <Fragment slot="title">{cells.browser.title.lead}<br /><span class="chip">{cells.browser.title.chip}</span></Fragment>
        <p>{cells.browser.body}</p>
    </Cell>
    <Cell tag={cells.answers.tag} id="answers">
        <Sketch slot="board" />
        <Fragment slot="title">{cells.answers.title.lead}<br /><span class="chip">{cells.answers.title.chip}</span></Fragment>
        <p>{cells.answers.body}</p>
    </Cell>
</Bento>

<Scene tag={t.review.tag} id="review" wide ground={0.3} art={{ day: jettyDay, night: jettyNight, subject: 0.42 }}>
    <Fragment slot="title">{t.review.title.lead}<br /><span class="chip">{t.review.title.chip}</span></Fragment>
    {t.review.body.map((paragraph) => <p>{paragraph}</p>)}
    <Review slot="media" />
</Scene>

<Tools />

<Scene tag={t.notch.tag} id="notch" wide ground={0.29} art={{ day: doveDay, night: doveNight, subject: 0.76 }}>
    <Fragment slot="title">{t.notch.title.lead}<br /><span class="chip">{t.notch.title.chip}</span></Fragment>
    {t.notch.body.map((paragraph) => <p>{paragraph}</p>)}
    <Notch slot="media" />
</Scene>
