---
import { DISCORD_URL, REPO_URL, X_URL, type Release } from "../../lib/release";
import { copyFor } from "../../i18n";

interface Props {
    release: Release;
}

const { release } = Astro.props;
const { nav, footer: t } = copyFor(Astro.currentLocale);
---

<footer class="footer">
    <div class="frame cols">
        <div class="brand">
            <img class="on-light" src="/brand/lockup-black.svg" alt="Sikemux" />
            <img class="on-dark" src="/brand/lockup-white.svg" alt="" />
            <p>{t.tagline}</p>
        </div>
        <nav aria-label={t.product}>
            <h3>{t.product}</h3>
            <a href="/agents">{nav.agents}</a>
            <a href="/vs">{nav.compare}</a>
            <a href="/changelog">{nav.changelog}</a>
            <a href="/phone">{t.phone}</a>
        </nav>
        <nav aria-label={t.help}>
            <h3>{t.help}</h3>
            <a href="https://docs.sikemux.com">{nav.docs}</a>
            <a href={DISCORD_URL}>Discord</a>
            <a href={REPO_URL}>GitHub</a>
        </nav>
        <nav aria-label={t.company}>
            <h3>Sikemux</h3>
            <a href="/brand">{t.brand}</a>
            <a href="/privacy">{t.privacy}</a>
            <a href="/terms">{t.terms}</a>
            <a href="/refunds">{t.refunds}</a>
            <a href="mailto:contact@nodelike.com">{t.contact}</a>
            <a href={X_URL}>X</a>
        </nav>
    </div>
    <div class="frame bar mono">
        <p>v<span data-release-version>{release.version}</span> · {t.free}</p>
        <p>© nodelike</p>
    </div>
</footer>

<style>
    .footer {
        border-top: 1px solid var(--rule);
    }
    .cols {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1fr;
        font-size: 14.5px;
    }
    .cols > * {
        padding: 36px 20px 40px;
    }
    .cols > * + * {
        border-left: 1px solid var(--rule);
    }
    .brand {
        display: grid;
        gap: 18px;
        align-content: start;
    }
    .brand img {
        width: min(100%, 250px);
        height: auto;
    }
    .brand p {
        color: var(--ink-2);
        max-width: 18em;
    }
    .on-dark,
    :global(:root[data-theme="dark"]) .brand .on-light {
        display: none;
    }
    :global(:root[data-theme="dark"]) .brand .on-dark {
        display: block;
    }
    nav {
        display: grid;
        gap: 9px;
        align-content: start;
    }
    h3 {
        margin-bottom: 6px;
        font: 500 11.5px/1 var(--mono);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--ink-3);
    }
    nav a {
        justify-self: start;
        text-decoration: none;
        color: var(--ink-2);
    }
    nav a:hover {
        color: var(--ink);
        text-decoration: underline;
        text-decoration-color: var(--violet);
        text-underline-offset: 3px;
    }
    .bar {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        padding: 14px 20px;
        border-top: 1px solid var(--rule);
        font-size: 12px;
        color: var(--ink-3);
    }
    @media (max-width: 900px) {
        .cols {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
        .brand {
            grid-column: 1 / -1;
            border-bottom: 1px solid var(--rule);
        }
        .cols > nav:first-of-type {
            border-left: 0;
        }
        .cols > * {
            padding: 28px 16px;
        }
    }
</style>
