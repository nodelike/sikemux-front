---
import { DISCORD_URL, REPO_URL, X_URL, type Release } from "../../lib/release";

interface Props {
    release: Release;
}

const { release } = Astro.props;
---

<footer class="footer">
    <div class="frame cols">
        <div class="brand">
            <img class="on-light" src="/brand/lockup-black.svg" alt="Sikemux" />
            <img class="on-dark" src="/brand/lockup-white.svg" alt="" />
            <p>A whole team of AI coders, in one window.</p>
        </div>
        <nav aria-label="Product">
            <h3>Product</h3>
            <a href="/agents">Agents</a>
            <a href="/vs">Compare</a>
            <a href="/changelog">Changelog</a>
            <a href="/phone">Phone app</a>
        </nav>
        <nav aria-label="Help">
            <h3>Help</h3>
            <a href="https://docs.sikemux.com">Docs</a>
            <a href={DISCORD_URL}>Discord</a>
            <a href={REPO_URL}>GitHub</a>
        </nav>
        <nav aria-label="Company">
            <h3>Sikemux</h3>
            <a href="/brand">Brand</a>
            <a href="/privacy">Privacy</a>
            <a href="/terms">Terms</a>
            <a href={X_URL}>X</a>
        </nav>
    </div>
    <div class="frame bar mono">
        <p>v<span data-release-version>{release.version}</span> · free and MIT</p>
        <p>© nodelike</p>
    </div>
</footer>

<style>
    .footer {
        border-top: 1px solid var(--rule);
    }
    .cols {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1fr;
        font-size: 14.5px;
    }
    .cols > * {
        padding: 36px 20px 40px;
    }
    .cols > * + * {
        border-left: 1px solid var(--rule);
    }
    .brand {
        display: grid;
        gap: 18px;
        align-content: start;
    }
    .brand img {
        width: min(100%, 250px);
        height: auto;
    }
    .brand p {
        color: var(--ink-2);
        max-width: 18em;
    }
    .on-dark,
    :global(:root[data-theme="dark"]) .brand .on-light {
        display: none;
    }
    :global(:root[data-theme="dark"]) .brand .on-dark {
        display: block;
    }
    nav {
        display: grid;
        gap: 9px;
        align-content: start;
    }
    h3 {
        margin-bottom: 6px;
        font: 500 11.5px/1 var(--mono);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--ink-3);
    }
    nav a {
        justify-self: start;
        text-decoration: none;
        color: var(--ink-2);
    }
    nav a:hover {
        color: var(--ink);
        text-decoration: underline;
        text-decoration-color: var(--violet);
        text-underline-offset: 3px;
    }
    .bar {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        padding: 14px 20px;
        border-top: 1px solid var(--rule);
        font-size: 12px;
        color: var(--ink-3);
    }
    @media (max-width: 900px) {
        .cols {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
        .brand {
            grid-column: 1 / -1;
            border-bottom: 1px solid var(--rule);
        }
        .cols > nav:first-of-type {
            border-left: 0;
        }
        .cols > * {
            padding: 28px 16px;
        }
    }
</style>
