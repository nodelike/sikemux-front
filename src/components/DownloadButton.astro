---
import { APPLE } from "../lib/marks";
import type { Release } from "../lib/release";

interface Props {
    release: Release;
}

const { release } = Astro.props;
---

<a class="download" href={release.dmgUrl} data-download data-dmg={release.dmgUrl} data-appimage={release.appImageUrl}>
    <svg width="16" height="19" viewBox={APPLE.viewBox} fill="currentColor" aria-hidden="true"><path d={APPLE.path}></path></svg>
    <span>Download for Mac</span>
</a>

<script>
    import { pointDownloads } from "../lib/download";

    pointDownloads();
</script>
<style>
    .download {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        height: 44px;
        padding-inline: 18px 20px;
        border: 1px solid color-mix(in oklab, var(--acc) 70%, var(--bg-dim));
        border-radius: var(--radius-2);
        background: linear-gradient(to bottom, color-mix(in oklab, var(--acc) 88%, var(--ink)), var(--acc));
        box-shadow: inset 0 1px 0 color-mix(in oklab, var(--ink) 45%, transparent);
        font-size: 15px;
        font-weight: 600;
        letter-spacing: -0.01em;
        color: var(--on-accent);
        transition:
            filter var(--dur-2) var(--ease-out),
            transform var(--dur-1) var(--ease-out);
    }

    .download:hover {
        filter: brightness(1.08);
    }

    .download:active {
        transform: translateY(1px);
    }

    svg {
        flex: none;
        margin-top: -2px;
    }
</style>
