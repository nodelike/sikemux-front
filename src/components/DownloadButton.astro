---
interface Props {
    href: string;
}

const { href } = Astro.props;
---

<a class="download" href={href}>
    <svg width="16" height="19" viewBox="0 0 814 1000" fill="currentColor" aria-hidden="true">
        <path
            d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"
        ></path>
    </svg>
    <span>Download for Mac</span>
</a>

<style>
    .download {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        height: 44px;
        padding-inline: 18px 20px;
        border: 1px solid color-mix(in oklab, var(--acc) 70%, var(--bg-dim));
        border-radius: var(--radius-2);
        background: linear-gradient(to bottom, color-mix(in oklab, var(--acc) 88%, var(--ink)), var(--acc));
        box-shadow: inset 0 1px 0 color-mix(in oklab, var(--ink) 45%, transparent);
        font-size: 15px;
        font-weight: 600;
        letter-spacing: -0.01em;
        color: var(--on-accent);
        transition:
            filter var(--dur-2) var(--ease-out),
            transform var(--dur-1) var(--ease-out);
    }

    .download:hover {
        filter: brightness(1.08);
    }

    .download:active {
        transform: translateY(1px);
    }

    svg {
        flex: none;
        margin-top: -2px;
    }
</style>
