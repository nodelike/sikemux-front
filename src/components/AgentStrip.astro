---
import AgentIcon from "./AgentIcon.astro";
import Icon from "./Icon.astro";

const agents = [
    { id: "claude", name: "Claude Code", color: "var(--brand-claude)" },
    { id: "codex", name: "Codex", color: "var(--brand-codex)" },
    { id: "hermes", name: "Hermes", color: "var(--brand-hermes)" },
    { id: "pi", name: "Pi", color: "var(--brand-pi)" },
    { id: "opencode", name: "OpenCode", color: "var(--brand-opencode)" },
] as const;

const facts = [
    { icon: "shield", text: "No API key, no bundled model" },
    { icon: "command", text: "Native Rust PTYs, not Electron" },
    { icon: "globe", text: "Every agent gets its own browser" },
    { icon: "plug", text: "Agents run your tasks over MCP" },
] as const;
---

<section class="strip" id="agents">
    <div class="page row">
        <div class="top">
            <p class="label">Runs the agents already on your PATH</p>
            <ul>
                {
                    agents.map((agent) => (
                        <li style={`color: ${agent.color}`}>
                            <AgentIcon agent={agent.id} size={22} />
                            <span>{agent.name}</span>
                        </li>
                    ))
                }
            </ul>
        </div>
        <ul class="facts">
            {
                facts.map((fact) => (
                    <li>
                        <Icon name={fact.icon} size={15} />
                        <span>{fact.text}</span>
                    </li>
                ))
            }
        </ul>
    </div>
</section>

<style>
    .strip {
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        background: var(--surface);
    }

    .row {
        display: grid;
        gap: 20px;
        padding-block: 28px;
    }

    .top {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px 40px;
    }

    ul:not(.facts) {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 8px 28px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    li {
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

    ul:not(.facts) li span {
        font-size: 15px;
        font-weight: 500;
        color: var(--text-primary);
    }

    .facts {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px 24px;
        margin: 0;
        padding: 20px 0 0;
        border-top: 1px solid var(--gray-200);
        list-style: none;
        font-size: 14px;
        color: var(--text-tertiary);
    }

    .facts li {
        gap: 10px;
    }

    @media (max-width: 960px) {
        .facts {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 520px) {
        .facts {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
