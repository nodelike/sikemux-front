---
import { Image } from "astro:assets";
import hero from "../assets/hero/hero.png";
import Dither from "./Dither.astro";
import GithubStars from "./GithubStars.astro";
import DownloadButton from "./DownloadButton.astro";
import { formatSize, type Release } from "../lib/release";

interface Props {
    release: Release;
    stars: number | null;
}

const { release, stars } = Astro.props;
---

<section class="hero">
    <Dither class="grain" />
    <div class="page">
        <div class="copy">
            <a class="news" href="#new">
                <span class="tag mono">New in 0.5</span>
                <span>Your agents on your phone and in the notch</span>
                <span class="arrow" aria-hidden="true">→</span>
            </a>
            <h1>The IDE for you and your coding agents.</h1>
            <p class="lede">
                Ask Claude Code or Codex to fix a bug, then watch it edit your code, run your tests and try your app in a real browser. Review
                what it changed and ship, all in one window.
            </p>
            <div class="actions">
                <DownloadButton href={release.dmgUrl} />
                <GithubStars stars={stars} label="Star on GitHub" size="large" count={false} />
            </div>
            <p class="meta mono">
                <span>v<span data-release-version>{release.version}</span></span>
                {release.dmgBytes !== null && <span><span data-release-size>{formatSize(release.dmgBytes)}</span></span>}
                <span>Mac, Apple Silicon</span>
                <span>free</span>
            </p>
            <p class="also">Also on your phone: <a href="/phone">Android, in testing</a> · iPhone soon</p>
        </div>
    </div>
    <div class="stage-wrap">
        <figure class="shot-frame">
            <Image
                src={hero}
                alt="A Claude Code agent fixing a bug on the Sikemux site, with the page open in its own browser tab"
                widths={[1440, 2160, 2880]}
                sizes="(min-width: 1520px) 1440px, 100vw"
                format="avif"
                quality={72}
                loading="eager"
                fetchpriority="high"
            />
        </figure>
    </div>
</section>

<style>
    .hero {
        position: relative;
        padding-block: clamp(48px, 7vw, 88px) clamp(64px, 8vw, 96px);
        isolation: isolate;
    }

    .hero :global(.grain) {
        inset: 0 0 30%;
        mask-image: radial-gradient(ellipse 70% 90% at 50% 0%, #000 10%, transparent 70%);
        -webkit-mask-image: radial-gradient(ellipse 70% 90% at 50% 0%, #000 10%, transparent 70%);
    }

    .copy {
        display: grid;
        justify-items: center;
        gap: 22px;
        max-width: 860px;
        margin: 0 auto clamp(40px, 5vw, 56px);
        text-align: center;
    }

    .news {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        height: 32px;
        padding: 0 12px 0 4px;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: color-mix(in oklab, var(--surface) 70%, transparent);
        font-size: 13.5px;
        color: var(--text-secondary);
        transition: border-color var(--dur-2) var(--ease-out);
    }

    .news:hover {
        border-color: var(--border-strong);
        color: var(--text-primary);
    }

    .news .tag {
        padding: 3px 9px;
        border: 1px solid var(--border-selected);
        border-radius: 999px;
        background: var(--surface-selected);
        font-size: 11px;
        letter-spacing: 0.04em;
        color: var(--text-primary);
    }

    .news .arrow {
        color: var(--text-tertiary);
    }

    .also {
        margin-top: -10px;
        font-size: 13px;
        color: var(--text-tertiary);
    }

    .also a {
        color: var(--text-secondary);
        text-decoration: underline;
        text-decoration-color: var(--border-strong);
        text-underline-offset: 3px;
    }

    .shot-frame {
        margin: 0;
        border: 1px solid var(--border);
        border-radius: var(--radius-4);
        overflow: hidden;
        background: var(--surface-sunken);
        aspect-ratio: 1440 / 900;
    }

    .shot-frame :global(img) {
        display: block;
        width: 100%;
        height: auto;
    }

    .stage-wrap {
        position: relative;
        isolation: isolate;
        width: min(100% - 2 * var(--gutter), 1440px);
        margin-inline: auto;
    }

    .stage-wrap::before {
        content: "";
        position: absolute;
        inset: 8% 6% -6%;
        z-index: -1;
        background: radial-gradient(60% 55% at 50% 40%, color-mix(in oklab, var(--acc) 38%, transparent), transparent 70%);
        filter: blur(40px);
        opacity: 0.55;
    }

    h1 {
        max-width: 16ch;
        font-size: clamp(40px, 5.8vw, 78px);
        line-height: 1;
        letter-spacing: -0.05em;
    }

    .lede {
        font-size: 18px;
        line-height: 1.55;
        max-width: 58ch;
    }

    .actions {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .meta {
        --sep: 32px;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        row-gap: 6px;
        margin-left: calc(-1 * var(--sep));
        clip-path: inset(0 0 0 var(--sep));
        font-size: 12px;
        color: var(--text-tertiary);
    }

    .meta > span {
        position: relative;
        margin-left: var(--sep);
    }

    /* The dot before the first item on each line falls in the clipped strip, so a wrapped line never starts with one. */
    .meta > span::before {
        content: "·";
        position: absolute;
        left: calc(-1 * var(--sep));
        width: var(--sep);
        text-align: center;
        color: var(--gray-500);
    }

</style>
