---
import { Image, Picture } from "astro:assets";
import hero from "../assets/hero/hero.png";
import art from "../assets/art/hero-observatory.jpg";
import GithubStars from "./GithubStars.astro";
import DownloadButton from "./DownloadButton.astro";
import InstallCommand from "./InstallCommand.astro";
import { formatSize, type Release } from "../lib/release";

interface Props {
    release: Release;
    stars: number | null;
}

const { release, stars } = Astro.props;

const tasks = [
    { task: "Cart totals a cent off", agent: "Wren", state: "working", x: 60, y: 16 },
    { task: "Tax rules per country", agent: "Crusch", state: "waiting", x: 80, y: 30 },
    { task: "Stripe webhook retries", agent: "Suzuha", state: "waiting", x: 62, y: 44 },
    { task: "Pre-push hook tests", agent: "Takamura", state: "working", x: 74, y: 58 },
];
---

<section class="hero">
    <div class="sky">
        <Picture class="art" src={art} alt="" formats={["avif", "webp"]} widths={[828, 1280, 1600]} sizes="100vw" quality={62} loading="eager" fetchpriority="high" />
        <ul class="tasks" aria-hidden="true">
            {
                tasks.map((task, index) => (
                    <li class="mono" style={`left: ${task.x}%; top: ${task.y}%; animation-delay: ${index * -1.5}s`}>
                        <span class:list={["dot", task.state]} />
                        {task.task}
                        <span class="who">@{task.agent}</span>
                    </li>
                ))
            }
        </ul>
    </div>
    <div class="page">
        <div class="copy">
            <a class="news" href="/changelog#v0.6.0">
                <span class="tag mono">New in 0.6</span>
                <span class="what">A new native app, drawn on the GPU and lighter on memory</span>
                <span class="arrow" aria-hidden="true">→</span>
            </a>
            <h1>The IDE for you<br /><em>and your coding agents.</em></h1>
            <p class="lede">
                Bring Claude Code, Codex or OpenCode. Sikemux gives them your shell, browser, logs and deploys, in one native app.
            </p>
            <div class="actions">
                <DownloadButton release={release} />
                <GithubStars stars={stars} label="Star on GitHub" size="large" />
            </div>
            <InstallCommand />
            <p class="meta mono">
                <span>v<span data-release-version>{release.version}</span></span>
                {release.dmgBytes !== null && <span data-release-size>{formatSize(release.dmgBytes)}</span>}
                <span>Mac and Linux</span>
                <span>free</span>
            </p>
        </div>
    </div>
    <div class="stage">
        <figure class="window">
            <Image
                src={hero}
                alt="Claude Code fixing a checkout bug in a shop project, with the project's other agents listed beside it"
                widths={[828, 1170, 1560, 2340, 3120]}
                sizes="(min-width: 1360px) 1280px, 100vw"
                format="avif"
                quality={72}
                loading="eager"
                fetchpriority="high"
            />
        </figure>
    </div>
</section>

<style>
    .hero {
        position: relative;
        padding-block: clamp(96px, 12vw, 150px) clamp(32px, 4vw, 56px);
        isolation: isolate;
    }

    .sky {
        position: absolute;
        inset: 0 0 calc(min(100vw - 2 * var(--gutter), 1280px) * 0.3 + clamp(32px, 4vw, 56px));
        z-index: -1;
        overflow: hidden;
    }

    .sky :global(.art) {
        width: 100%;
        height: calc(100% - 12px);
        object-fit: cover;
        object-position: right 30%;
    }

    .sky::before,
    .sky::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
    }

    .sky::before {
        z-index: 1;
        background: linear-gradient(90deg, color-mix(in oklab, var(--bg-dim) 86%, transparent) 0%, color-mix(in oklab, var(--bg-dim) 60%, transparent) 34%, transparent 58%);
    }

    .sky::after {
        z-index: 1;
        background: linear-gradient(transparent 55%, var(--bg-dim) calc(100% - 40px));
    }

    .tasks {
        position: absolute;
        inset: 0;
        z-index: 2;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .tasks li {
        position: absolute;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 7px 11px;
        border: 1px solid color-mix(in oklab, var(--ink) 10%, transparent);
        border-radius: var(--radius-2);
        background: color-mix(in oklab, var(--bg-dim) 84%, transparent);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        font-size: 12.5px;
        color: var(--text-primary);
        white-space: nowrap;
        animation: bob 6s ease-in-out infinite;
    }

    .who {
        color: var(--acc-soft);
    }

    .dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--live);
    }

    .dot.waiting {
        background: #fbbf24;
    }

    @keyframes bob {
        50% {
            transform: translateY(-6px);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .tasks li {
            animation: none;
        }
    }

    .copy {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        justify-items: start;
        gap: 24px;
        max-width: 760px;
        margin: 0 0 clamp(56px, 7vw, 96px);
    }

    .news {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        height: 32px;
        max-width: 100%;
        padding: 0 12px 0 4px;
        border: 1px solid var(--border);
        border-radius: var(--radius-pill);
        background: color-mix(in oklab, var(--surface) 70%, transparent);
        font-size: 13.5px;
        color: var(--text-secondary);
        transition: border-color var(--dur-2) var(--ease-out);
    }

    .news:hover {
        border-color: var(--border-strong);
        color: var(--text-primary);
    }

    .news .tag {
        flex: none;
        padding: 3px 9px;
        border: 1px solid var(--border);
        border-radius: var(--radius-pill);
        background: var(--gray-200);
        font-size: 11px;
        letter-spacing: 0.04em;
        color: var(--text-primary);
    }

    .news .what {
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .news .arrow {
        flex: none;
        color: var(--text-tertiary);
    }

    h1 {
        font-family: var(--serif);
        font-size: clamp(50px, 6.4vw, 88px);
        font-weight: 400;
        line-height: 0.95;
        letter-spacing: -0.01em;
        text-shadow: 0 2px 24px color-mix(in oklab, var(--bg-dim) 60%, transparent);
    }

    h1 em {
        color: var(--acc-soft);
    }

    .lede {
        max-width: 46ch;
        font-size: clamp(17px, 1.6vw, 19px);
        line-height: 1.55;
        color: color-mix(in oklab, var(--ink) 88%, transparent);
        text-shadow: 0 1px 12px var(--bg-dim);
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .meta {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 18px;
        font-size: 12px;
        color: var(--text-tertiary);
    }

    .stage {
        position: relative;
        width: min(100% - 2 * var(--gutter), 1280px);
        margin-inline: auto;
    }

    .stage::before {
        content: "";
        position: absolute;
        inset: 8% 6% -6%;
        z-index: -1;
        background: radial-gradient(60% 55% at 50% 40%, color-mix(in oklab, var(--acc) 38%, transparent), transparent 70%);
        filter: blur(40px);
        opacity: 0.55;
    }

    .window {
        margin: 0;
        border: 1px solid var(--border);
        border-radius: var(--radius-4);
        overflow: hidden;
        background: var(--surface-sunken);
        aspect-ratio: 3520 / 1800;
    }

    .window :global(img) {
        width: 100%;
        height: auto;
    }

    @media (max-width: 960px) {
        .tasks {
            display: none;
        }

        .sky::before {
            background: linear-gradient(90deg, color-mix(in oklab, var(--bg-dim) 80%, transparent), color-mix(in oklab, var(--bg-dim) 45%, transparent));
        }
    }

    @media (max-width: 520px) {
        .actions {
            display: grid;
            grid-template-columns: minmax(0, 1fr);
            width: min(100%, 340px);
        }

        .actions > :global(*) {
            width: 100%;
            justify-content: center;
        }
    }
</style>
