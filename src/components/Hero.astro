---
import { Image } from "astro:assets";
import hero from "../assets/hero/hero.png";
import Dither from "./Dither.astro";
import GithubStars from "./GithubStars.astro";
import DownloadButton from "./DownloadButton.astro";
import InstallCommand from "./InstallCommand.astro";
import { formatSize, type Release } from "../lib/release";

interface Props {
    release: Release;
    stars: number | null;
}

const { release, stars } = Astro.props;
---

<section class="hero">
    <Dither class="grain" />
    <div class="page">
        <div class="copy">
            <a class="news" href="/changelog#v0.6.0">
                <span class="tag mono">New in 0.6</span>
                <span class="what">A new native app, drawn on the GPU and lighter on memory</span>
                <span class="arrow" aria-hidden="true">→</span>
            </a>
            <h1>The IDE for you and your coding agents.</h1>
            <p class="lede">
                Bring Claude Code, Codex or OpenCode. Sikemux gives them your shell, browser, logs and deploys, in one native app.
            </p>
            <div class="actions">
                <DownloadButton href={release.dmgUrl} />
                <GithubStars stars={stars} label="Star on GitHub" size="large" />
            </div>
            <InstallCommand />
            <p class="meta mono">
                <span>v<span data-release-version>{release.version}</span></span>
                {release.dmgBytes !== null && <span data-release-size>{formatSize(release.dmgBytes)}</span>}
                <span>Mac and Linux</span>
                <span>free</span>
            </p>
        </div>
    </div>
    <div class="stage">
        <figure class="window">
            <Image
                src={hero}
                alt="A Claude Code agent beside its own browser tab, open on vercel.com"
                widths={[828, 1170, 1560, 2340, 3120]}
                sizes="(min-width: 1360px) 1280px, 100vw"
                format="avif"
                quality={72}
                loading="eager"
                fetchpriority="high"
            />
        </figure>
    </div>
</section>

<style>
    .hero {
        position: relative;
        padding-block: clamp(56px, 8vw, 104px) clamp(64px, 8vw, 96px);
        isolation: isolate;
    }

    .hero :global(.grain) {
        inset: 0 0 35%;
        mask-image: radial-gradient(ellipse 70% 90% at 50% 0%, #000 10%, transparent 70%);
        -webkit-mask-image: radial-gradient(ellipse 70% 90% at 50% 0%, #000 10%, transparent 70%);
    }

    .copy {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        justify-items: center;
        gap: 24px;
        max-width: 980px;
        margin: 0 auto clamp(40px, 5vw, 56px);
        text-align: center;
    }

    .news {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        height: 32px;
        max-width: 100%;
        padding: 0 12px 0 4px;
        border: 1px solid var(--border);
        border-radius: var(--radius-pill);
        background: color-mix(in oklab, var(--surface) 70%, transparent);
        font-size: 13.5px;
        color: var(--text-secondary);
        transition: border-color var(--dur-2) var(--ease-out);
    }

    .news:hover {
        border-color: var(--border-strong);
        color: var(--text-primary);
    }

    .news .tag {
        flex: none;
        padding: 3px 9px;
        border: 1px solid var(--border);
        border-radius: var(--radius-pill);
        background: var(--gray-200);
        font-size: 11px;
        letter-spacing: 0.04em;
        color: var(--text-primary);
    }

    .news .what {
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .news .arrow {
        flex: none;
        color: var(--text-tertiary);
    }

    h1 {
        max-width: 15ch;
        font-size: clamp(46px, 7.4vw, 100px);
        font-weight: 500;
        line-height: 0.96;
        letter-spacing: -0.055em;
    }

    .lede {
        max-width: 50ch;
        font-size: clamp(17px, 1.6vw, 20px);
        line-height: 1.55;
    }

    .actions {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .meta {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 4px 18px;
        font-size: 12px;
        color: var(--text-tertiary);
    }

    .stage {
        position: relative;
        width: min(100% - 2 * var(--gutter), 1280px);
        margin-inline: auto;
    }

    .stage::before {
        content: "";
        position: absolute;
        inset: 8% 6% -6%;
        z-index: -1;
        background: radial-gradient(60% 55% at 50% 40%, color-mix(in oklab, var(--acc) 38%, transparent), transparent 70%);
        filter: blur(40px);
        opacity: 0.55;
    }

    .window {
        margin: 0;
        border: 1px solid var(--border);
        border-radius: var(--radius-4);
        overflow: hidden;
        background: var(--surface-sunken);
        aspect-ratio: 3520 / 1800;
    }

    .window :global(img) {
        width: 100%;
        height: auto;
    }

    @media (max-width: 520px) {
        .actions {
            display: grid;
            grid-template-columns: minmax(0, 1fr);
            width: min(100%, 340px);
        }

        .actions > :global(*) {
            width: 100%;
            justify-content: center;
        }
    }
</style>
