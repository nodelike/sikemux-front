---
import { Image, Picture } from "astro:assets";
import hero from "../assets/hero/hero.png";
import art from "../assets/art/hero-scholar.jpg";
import GithubStars from "./GithubStars.astro";
import DownloadButton from "./DownloadButton.astro";
import PlatformWaitlist from "./PlatformWaitlist.astro";
import { formatSize, REPO_URL, type Release } from "../lib/release";

interface Props {
    release: Release;
    stars: number | null;
}

const { release, stars } = Astro.props;

---

<section class="hero">
    <div class="sky">
        <Picture class="art" src={art} alt="" formats={["avif", "webp"]} widths={[828, 1280, 1600]} sizes="100vw" quality={62} loading="eager" fetchpriority="high" />
    </div>
    <div class="page">
        <div class="copy">
            <a class="news mono" href={`${REPO_URL}/blob/main/LICENSE`}>Now open source under MIT <span aria-hidden="true">→</span></a>
            <h1>Out of Claude?<br /><em>The chat carries on in Codex.</em></h1>
            <p class="second">And see which agent needs you, on your Mac, the notch or your phone.</p>
            <p class="lede">A native app, not Electron, about 25 MB. Claude Code, Codex and more on the plans you already pay for, working as one team.</p>
            <div class="actions">
                <DownloadButton release={release} />
                <GithubStars stars={stars} label="Star on GitHub" size="large" count={false} />
            </div>
            <div class="where">
                <p class="meta mono">
                    <span class="install">$ curl -fsSL https://sikemux.com/install | sh</span>
                    <span>Apple Silicon Mac and Linux</span>
                    {release.dmgBytes !== null && <span data-release-size>{formatSize(release.dmgBytes)}</span>}
                    <span>free · MIT</span>
                </p>
                <PlatformWaitlist />
            </div>
        </div>
    </div>
    <div class="stage">
        <figure class="window">
            <Image
                src={hero}
                alt="Claude Code fixing a checkout bug in a shop project, with the project's other agents listed beside it"
                widths={[828, 1170, 1560, 2340, 3120]}
                sizes="(min-width: 1360px) 1280px, 100vw"
                format="avif"
                quality={72}
                loading="eager"
                fetchpriority="high"
            />
        </figure>
    </div>
</section>

<style>
    .hero {
        position: relative;
        padding-block: clamp(96px, 12vw, 150px) clamp(32px, 4vw, 56px);
        isolation: isolate;
    }

    .sky {
        position: absolute;
        inset: 0 0 calc(min(100vw - 2 * var(--gutter), 1280px) * 0.3 + clamp(32px, 4vw, 56px));
        z-index: -1;
        overflow: hidden;
    }

    .sky {
        background: linear-gradient(#151932, #23273f);
    }

    .sky :global(.art) {
        position: absolute;
        top: 0;
        right: 0;
        width: auto;
        height: calc(100% - min(100vw - 2 * var(--gutter), 1280px) * 0.24);
        max-width: none;
        -webkit-mask-image: linear-gradient(90deg, transparent, #000 18%), linear-gradient(#000 78%, transparent 99%);
        -webkit-mask-composite: source-in;
        mask-image: linear-gradient(90deg, transparent, #000 18%), linear-gradient(#000 78%, transparent 99%);
        mask-composite: intersect;
    }

    .sky::before,
    .sky::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
    }

    .sky::before {
        z-index: 1;
        background: linear-gradient(90deg, color-mix(in oklab, var(--bg-dim) 55%, transparent) 0%, color-mix(in oklab, var(--bg-dim) 25%, transparent) 40%, transparent 60%);
    }

    .sky::after {
        z-index: 1;
        background: linear-gradient(transparent 55%, var(--bg-dim) calc(100% - 40px));
    }

    .copy {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        justify-items: start;
        gap: 22px;
        max-width: 900px;
        margin: 0 0 clamp(56px, 7vw, 96px);
    }

    .news {
        font-size: 11px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--acc-soft);
        transition: color var(--dur-2) var(--ease-out);
    }

    .news:hover {
        color: var(--text-primary);
    }

    h1 {
        font-family: var(--serif);
        font-size: clamp(44px, 5.4vw, 76px);
        font-weight: 400;
        line-height: 0.95;
        letter-spacing: -0.01em;
        text-shadow: 0 2px 24px color-mix(in oklab, var(--bg-dim) 60%, transparent);
    }

    h1 em {
        color: var(--acc-soft);
    }

    .second {
        max-width: 36ch;
        margin-top: -8px;
        font-size: clamp(20px, 2.1vw, 26px);
        line-height: 1.3;
        color: var(--ink);
        text-shadow: 0 1px 12px var(--bg-dim);
    }

    .where {
        display: grid;
        gap: 10px;
    }

    .lede {
        max-width: 50ch;
        font-size: clamp(17px, 1.6vw, 19px);
        line-height: 1.55;
        color: color-mix(in oklab, var(--ink) 88%, transparent);
        text-shadow: 0 1px 12px var(--bg-dim);
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .meta {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 18px;
        font-size: 12.5px;
        color: var(--text-tertiary);
    }

    .meta .install {
        color: var(--text-secondary);
        user-select: all;
    }

    .stage {
        position: relative;
        width: min(100% - 2 * var(--gutter), 1280px);
        margin-inline: auto;
    }

    .stage::before {
        content: "";
        position: absolute;
        inset: 8% 6% -6%;
        z-index: -1;
        background: radial-gradient(60% 55% at 50% 40%, color-mix(in oklab, var(--acc) 38%, transparent), transparent 70%);
        filter: blur(40px);
        opacity: 0.55;
    }

    .window {
        margin: 0;
        border: 1px solid var(--border);
        border-radius: var(--radius-4);
        overflow: hidden;
        background: var(--surface-sunken);
        aspect-ratio: 3520 / 1800;
    }

    .window :global(img) {
        width: 100%;
        height: auto;
    }

    @media (max-width: 960px) {
        .sky::before {
            background: linear-gradient(90deg, color-mix(in oklab, var(--bg-dim) 80%, transparent), color-mix(in oklab, var(--bg-dim) 45%, transparent));
        }
    }

    @media (max-width: 520px) {
        .actions {
            display: grid;
            grid-template-columns: minmax(0, 1fr);
            width: min(100%, 340px);
        }

        .actions > :global(*) {
            width: 100%;
            justify-content: center;
        }
    }
</style>
