---
import Stage from "./Stage.astro";
import Dither from "./Dither.astro";
import AgentIcon from "./AgentIcon.astro";
import GithubStars from "./GithubStars.astro";
import DownloadButton from "./DownloadButton.astro";
import { formatSize, type Release } from "../lib/release";

interface Props {
    release: Release;
    stars: number | null;
}

const { release, stars } = Astro.props;

const agents = [
    { id: "claude", name: "Claude Code", color: "var(--brand-claude)" },
    { id: "codex", name: "Codex", color: "var(--brand-codex)" },
    { id: "hermes", name: "Hermes", color: "var(--brand-hermes)" },
    { id: "pi", name: "Pi", color: "var(--brand-pi)" },
    { id: "opencode", name: "OpenCode", color: "var(--brand-opencode)" },
    { id: "omp", name: "OMP", color: "var(--brand-omp)" },
    { id: "grok", name: "Grok", color: "var(--brand-grok)" },
] as const;
---

<section class="hero">
    <Dither class="grain" />
    <div class="page">
        <div class="copy">
            <h1>The IDE for you and your coding agents.</h1>
            <p class="lede">
                Ask Claude Code or Codex to fix a bug, then watch it edit your code, run your tests and try your app in a real browser. Review
                what it changed and ship, all in one window.
            </p>
            <div class="actions">
                <DownloadButton href={release.dmgUrl} />
                <GithubStars stars={stars} label="Star on GitHub" size="large" count={false} />
            </div>
            <p class="meta mono">
                <span>v<span data-release-version>{release.version}</span></span>
                {release.dmgBytes !== null && <span><span data-release-size>{formatSize(release.dmgBytes)}</span></span>}
                <span>Mac, Apple Silicon</span>
                <span>free</span>
            </p>
            <div class="works">
                <span class="label">Works with the agents you already use</span>
                <ul>
                    {
                        agents.map((agent) => (
                            <li style={`--brand: ${agent.color}`}>
                                <AgentIcon agent={agent.id} size={16} />
                                <span>{agent.name}</span>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
        <div class="stage-wrap">
            <Stage />
        </div>
    </div>
</section>

<style>
    .hero {
        position: relative;
        padding-block: clamp(56px, 9vw, 112px) clamp(64px, 8vw, 96px);
        isolation: isolate;
    }

    .hero :global(.grain) {
        inset: 0 0 30%;
        mask-image: radial-gradient(ellipse 70% 90% at 50% 0%, #000 10%, transparent 70%);
        -webkit-mask-image: radial-gradient(ellipse 70% 90% at 50% 0%, #000 10%, transparent 70%);
    }

    .copy {
        display: grid;
        justify-items: center;
        gap: 22px;
        max-width: 860px;
        margin: 0 auto clamp(48px, 7vw, 72px);
        text-align: center;
    }

    .works {
        display: grid;
        justify-items: center;
        gap: 12px;
        margin-top: 18px;
    }

    .works ul {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 6px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .works li {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        height: 32px;
        padding: 0 11px 0 9px;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: color-mix(in oklab, var(--brand) 7%, var(--surface));
        color: var(--brand);
        font-size: 13px;
        transition: border-color var(--dur-2) var(--ease-out);
    }

    .works li:hover {
        border-color: color-mix(in oklab, var(--brand) 45%, var(--border));
    }

    .works li span {
        color: var(--text-primary);
    }

    .stage-wrap {
        position: relative;
        isolation: isolate;
    }

    .stage-wrap::before {
        content: "";
        position: absolute;
        inset: 8% 6% -6%;
        z-index: -1;
        background: radial-gradient(60% 55% at 50% 40%, color-mix(in oklab, var(--acc) 38%, transparent), transparent 70%);
        filter: blur(40px);
        opacity: 0.55;
    }

    h1 {
        max-width: 16ch;
        font-size: clamp(38px, 5.4vw, 72px);
        line-height: 1.02;
        letter-spacing: -0.045em;
    }

    .lede {
        font-size: 18px;
        line-height: 1.55;
        max-width: 58ch;
    }

    .actions {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .meta {
        --sep: 32px;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        row-gap: 6px;
        margin-left: calc(-1 * var(--sep));
        clip-path: inset(0 0 0 var(--sep));
        font-size: 12px;
        color: var(--text-tertiary);
    }

    .meta > span {
        position: relative;
        margin-left: var(--sep);
    }

    /* The dot before the first item on each line falls in the clipped strip, so a wrapped line never starts with one. */
    .meta > span::before {
        content: "·";
        position: absolute;
        left: calc(-1 * var(--sep));
        width: var(--sep);
        text-align: center;
        color: var(--gray-500);
    }

</style>
