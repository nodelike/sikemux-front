---
import { REPO_URL } from "../lib/release";

interface Props {
    stars: number | null;
    label?: string;
    size?: "small" | "large";
    count?: boolean;
}

const { stars, label = "Star", size = "small", count = true } = Astro.props;
---

<a class:list={["btn", "stars", size]} href={REPO_URL} aria-label={!count || stars === null ? `${label} Sikemux on GitHub` : `${label} Sikemux on GitHub, ${stars} stars`}>
    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
        ></path>
    </svg>
    <span>{label}</span>
    {
        count && (
            <span class="count mono" data-stars hidden={stars === null}>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"></path>
                </svg>
                <span data-star-count>{stars ?? ""}</span>
            </span>
        )
    }
</a>

<script>
    const CACHE_KEY = "sikemux-stars";

    async function freshStars(): Promise<number | null> {
        const cached = sessionStorage.getItem(CACHE_KEY);
        if (cached !== null) return Number(cached);
        try {
            const response = await fetch("https://api.github.com/repos/nodelike/sikemux");
            if (!response.ok) return null;
            const { stargazers_count } = (await response.json()) as { stargazers_count: number };
            sessionStorage.setItem(CACHE_KEY, String(stargazers_count));
            return stargazers_count;
        } catch {
            return null;
        }
    }

    freshStars().then((stars) => {
        if (stars === null) return;
        for (const badge of document.querySelectorAll<HTMLElement>("[data-stars]")) {
            badge.hidden = false;
            const count = badge.querySelector("[data-star-count]");
            if (count) count.textContent = stars.toLocaleString("en");
        }
    });
</script>

<style>
    .stars {
        flex: none;
        gap: 8px;
        white-space: nowrap;
    }

    .small {
        height: 34px;
        padding-inline: 12px;
        font-size: 13px;
    }

    .large {
        height: 44px;
        padding-inline: 16px;
    }

    .count {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        margin-left: 2px;
        padding-left: 10px;
        border-left: 1px solid var(--border);
        font-size: 12px;
        color: var(--text-secondary);
    }

    .count[hidden] {
        display: none;
    }
</style>
