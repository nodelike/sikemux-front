---
import Band from "./Band.astro";
import art from "../assets/art/platforms-traveler.jpg";
import { ANDROID, APPLE, LINUX } from "../lib/marks";
import { APP_STORE_URL, RELEASES_URL, type Release } from "../lib/release";

interface Props {
    release: Release;
}

const { release } = Astro.props;
---

<section class="platforms" id="download">
    <Band art={art} label="Download" focus="center 60%">
        <Fragment slot="title">On your Mac.<br /><em>In your pocket.</em></Fragment>
        <Fragment slot="lede">Run your agents on a Mac or a Linux box, then answer them from your phone wherever you are.</Fragment>
        <div class="tiles" data-reveal>
            <a class="tile main" href={release.dmgUrl} data-release-dmg>
                <span class="state mono live">Available</span>
                <svg class="logo" width="44" height="54" viewBox={APPLE.viewBox} fill="currentColor" aria-hidden="true"><path d={APPLE.path} /></svg>
                <span class="name">macOS</span>
                <span class="detail mono">Apple Silicon · macOS 11+ · notarized</span>
                <span class="go">Download for Mac ↓</span>
            </a>
            <a class="tile" href={RELEASES_URL}>
                <span class="state mono live">Available</span>
                <svg class="logo" width="48" height="48" viewBox={LINUX.viewBox} fill="currentColor" aria-hidden="true"><path d={LINUX.path} /></svg>
                <span class="name">Linux</span>
                <span class="detail mono">x86_64 · .deb, .rpm, AppImage</span>
                <span class="go">Get it on GitHub ↗</span>
            </a>
            <a class="tile" href="/phone">
                <span class="state mono">In testing</span>
                <svg class="logo" width="48" height="48" viewBox={ANDROID.viewBox} fill="currentColor" aria-hidden="true"><path d={ANDROID.path} /></svg>
                <span class="name">Android</span>
                <span class="detail mono">Google Play · talks to your computer</span>
                <span class="go">Get the app →</span>
            </a>
            <a class="tile" href={APP_STORE_URL}>
                <span class="state mono live">Available</span>
                <svg class="logo" width="44" height="54" viewBox={APPLE.viewBox} fill="currentColor" aria-hidden="true"><path d={APPLE.path} /></svg>
                <span class="name">iPhone</span>
                <span class="detail mono">App Store · iOS 17+</span>
                <span class="go">Download on the App Store ↗</span>
            </a>
        </div>
    </Band>
</section>

<style>
    .platforms {
        padding-block: 0 clamp(24px, 3vw, 40px);
    }

    .tiles {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
    }

    .tile {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 6px;
        min-height: 280px;
        padding: 112px 24px 24px;
        border: 1px solid var(--border);
        border-radius: var(--radius-4);
        background: linear-gradient(to bottom, var(--gray-100), var(--surface-sunken));
        color: var(--text-primary);
        transition: border-color var(--dur-2) var(--ease-out);
    }

    .tile:hover {
        border-color: var(--border-strong);
    }

    .tile.main {
        border-color: var(--border-selected);
        background:
            radial-gradient(80% 60% at 50% 0%, color-mix(in oklab, var(--acc) 18%, transparent), transparent),
            linear-gradient(to bottom, var(--gray-100), var(--surface-sunken));
    }

    .logo {
        position: absolute;
        top: 24px;
        left: 24px;
        display: grid;
        color: var(--text-secondary);
    }

    .main .logo {
        color: var(--acc);
    }

    .state {
        position: absolute;
        top: 24px;
        right: 24px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 11px;
        color: var(--text-tertiary);
    }

    .state.live::before {
        content: "";
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--live);
    }

    .name {
        font-size: clamp(26px, 2.6vw, 34px);
        font-weight: 500;
        line-height: 1;
        letter-spacing: -0.04em;
    }

    .detail {
        font-size: 11.5px;
        color: var(--text-tertiary);
    }

    .go {
        margin-top: auto;
        padding-top: 14px;
        font-size: 14px;
        font-weight: 500;
        color: var(--text-secondary);
    }

    .main .go {
        color: var(--acc);
    }

    @media (max-width: 1000px) {
        .tiles {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 560px) {
        .tiles {
            grid-template-columns: minmax(0, 1fr);
        }

        .tile {
            min-height: 220px;
        }
    }
</style>
