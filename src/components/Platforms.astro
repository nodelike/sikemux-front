---
import Icon from "./Icon.astro";
import { DISCORD_URL, RELEASES_URL, type Release } from "../lib/release";

interface Props {
    release: Release;
}

const { release } = Astro.props;
---

<section class="platforms" id="download">
    <div class="page">
        <div class="statement" data-reveal>
            <p class="label">Download</p>
            <h2 class="display">On your Mac. In your pocket.</h2>
            <p>Run your agents on a Mac or a Linux box, then answer them from your phone wherever you are.</p>
        </div>
        <div class="tiles" data-reveal>
            <a class="tile main" href={release.dmgUrl} data-release-dmg>
                <span class="state mono live">Available</span>
                <svg class="logo" width="44" height="54" viewBox="0 0 814 1000" fill="currentColor" aria-hidden="true">
                    <path d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z" />
                </svg>
                <span class="name">macOS</span>
                <span class="detail mono">Apple Silicon · macOS 11+ · notarized</span>
                <span class="go">Download for Mac ↓</span>
            </a>
            <a class="tile" href={RELEASES_URL}>
                <span class="state mono live">Available</span>
                <span class="logo"><Icon name="command" size={48} /></span>
                <span class="name">Linux</span>
                <span class="detail mono">x86_64 · .deb, .rpm, AppImage</span>
                <span class="go">Get it on GitHub ↗</span>
            </a>
            <a class="tile" href="/phone">
                <span class="state mono">In testing</span>
                <span class="logo"><Icon name="phone" size={48} /></span>
                <span class="name">Android</span>
                <span class="detail mono">Google Play · talks to your computer</span>
                <span class="go">Get the app →</span>
            </a>
            <a class="tile" href={DISCORD_URL}>
                <span class="state mono">Soon</span>
                <span class="logo"><Icon name="phone" size={48} /></span>
                <span class="name">iPhone</span>
                <span class="detail mono">Hear first on Discord</span>
                <span class="go">Join the Discord ↗</span>
            </a>
        </div>
    </div>
</section>

<style>
    .platforms {
        padding-block: clamp(80px, 10vw, 136px);
    }

    .tiles {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
    }

    .tile {
        position: relative;
        display: grid;
        align-content: end;
        gap: 6px;
        min-height: 280px;
        padding: 24px;
        border: 1px solid var(--border);
        border-radius: var(--radius-4);
        background: linear-gradient(to bottom, var(--gray-100), var(--surface-sunken));
        color: var(--text-primary);
        transition: border-color var(--dur-2) var(--ease-out);
    }

    .tile:hover {
        border-color: var(--border-strong);
    }

    .tile.main {
        border-color: var(--border-selected);
        background:
            radial-gradient(80% 60% at 50% 0%, color-mix(in oklab, var(--acc) 18%, transparent), transparent),
            linear-gradient(to bottom, var(--gray-100), var(--surface-sunken));
    }

    .logo {
        position: absolute;
        top: 24px;
        left: 24px;
        display: grid;
        color: var(--text-secondary);
    }

    .main .logo {
        color: var(--acc);
    }

    .state {
        position: absolute;
        top: 24px;
        right: 24px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 11px;
        color: var(--text-tertiary);
    }

    .state.live::before {
        content: "";
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--live);
    }

    .name {
        font-size: clamp(26px, 2.6vw, 34px);
        font-weight: 500;
        line-height: 1;
        letter-spacing: -0.04em;
    }

    .detail {
        font-size: 11.5px;
        color: var(--text-tertiary);
    }

    .go {
        margin-top: 14px;
        font-size: 14px;
        font-weight: 500;
        color: var(--text-secondary);
    }

    .main .go {
        color: var(--acc);
    }

    @media (max-width: 1000px) {
        .tiles {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 560px) {
        .tiles {
            grid-template-columns: minmax(0, 1fr);
        }

        .tile {
            min-height: 220px;
        }
    }
</style>
