---
import Footer from "./Footer.astro";
import Buddy from "./Buddy.astro";
import { Picture } from "astro:assets";
import art from "../assets/art/closing-dawn.jpg";
import DownloadButton from "./DownloadButton.astro";
import InstallCommand from "./InstallCommand.astro";
import { REPO_URL, type Release } from "../lib/release";
import type { BuddyState } from "../lib/buddies";

interface Props {
    release: Release;
}

const { release } = Astro.props;

const crowd: { pack: string; shape: string; state: BuddyState }[] = [
    { pack: "buddies", shape: "ghostie", state: "idle" },
    { pack: "screens", shape: "laptop", state: "working" },
    { pack: "japan", shape: "daruma", state: "idle" },
    { pack: "googly", shape: "specs", state: "idle" },
    { pack: "chibi", shape: "hood", state: "working" },
    { pack: "soot", shape: "konpeito", state: "idle" },
    { pack: "peekers", shape: "frog", state: "idle" },
    { pack: "buddies", shape: "onigiri", state: "done" },
    { pack: "cyclops", shape: "drop", state: "idle" },
    { pack: "personas", shape: "engineer", state: "working" },
    { pack: "buddies", shape: "star", state: "idle" },
    { pack: "screens", shape: "boombox", state: "working" },
    { pack: "personas", shape: "security", state: "idle" },
    { pack: "japan", shape: "kitsune", state: "idle" },
    { pack: "screens", shape: "arcade", state: "waiting" },
    { pack: "buddies", shape: "penguin", state: "idle" },
    { pack: "screens", shape: "pet", state: "working" },
    { pack: "buddies", shape: "pudding", state: "idle" },
    { pack: "cyclops", shape: "squish", state: "idle" },
    { pack: "personas", shape: "designer", state: "idle" },
    { pack: "peekers", shape: "owl", state: "idle" },
    { pack: "chibi", shape: "buns", state: "done" },
    { pack: "buddies", shape: "slime", state: "idle" },
    { pack: "chibi", shape: "spiky", state: "working" },
    { pack: "soot", shape: "puff", state: "idle" },
    { pack: "japan", shape: "teru", state: "done" },
    { pack: "buddies", shape: "heart", state: "idle" },
];
---

<section class="closing">
    <Picture class="art" src={art} alt="" formats={["avif", "webp"]} widths={[640, 960, 1280]} sizes="100vw" quality={55} loading="lazy" decoding="async" />
    <div class="page">
        <div class="panel">
            <div class="cta" data-reveal>
                <p class="label">Every agent gets a buddy</p>
                <h2 class="display">Open a project.<br /><em>Keep it open.</em></h2>
                <p>Bring the agents you already use. Sikemux gives them the rest of your tools, and each one a buddy you can spot from across the room.</p>
                <div class="actions">
                    <DownloadButton release={release} />
                    <a class="btn notes" href={`/changelog#v${release.version}`}><span>What's new in v<span data-release-version>{release.version}</span></span></a>
                </div>
                <InstallCommand />
                <p class="source">Or build it yourself: <a href={REPO_URL}>clone it from GitHub</a>. Needs Rust, Node 22 and pnpm.</p>
            </div>
            <ul class="crowd" aria-hidden="true">
                {
                    crowd.map((member, index) => (
                        <li style={`--lift: ${(index % 3) * 6}px`}>
                            <Buddy pack={member.pack} shape={member.shape} state={member.state} size={52} />
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</section>

<Footer />

<style>
    .closing {
        --dusk: #ece8f4;
        position: relative;
        padding-block: clamp(160px, 16vw, 220px) 0;
        overflow: hidden;
        isolation: isolate;
    }

    .closing :global(.art) {
        position: absolute;
        inset: 0 0 12px;
        z-index: -1;
        width: 100%;
        height: calc(100% - 12px);
        object-fit: cover;
        object-position: right 40%;
        mask-image: linear-gradient(transparent, #000 26%, #000 80%, transparent 97%);
        -webkit-mask-image: linear-gradient(transparent, #000 26%, #000 80%, transparent 97%);
    }

    .panel {
        display: grid;
        gap: 56px;
    }

    .cta {
        display: grid;
        justify-items: start;
        gap: 20px;
        max-width: 560px;
        color: color-mix(in oklab, var(--dusk) 86%, transparent);
    }

    .cta .label {
        font-weight: 700;
        color: color-mix(in oklab, var(--dusk) 80%, transparent);
    }

    .cta .display {
        color: var(--dusk);
        text-shadow: none;
    }

    .cta .display em {
        color: #c9b3ff;
    }

    .cta > p:not(.label) {
        font-size: 17px;
        font-weight: 500;
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .notes {
        height: 44px;
        border-color: color-mix(in oklab, var(--dusk) 20%, transparent);
        background: color-mix(in oklab, #0b0a12 60%, transparent);
        color: var(--dusk);
    }

    .notes:hover {
        background: color-mix(in oklab, #0b0a12 80%, transparent);
        border-color: color-mix(in oklab, var(--dusk) 35%, transparent);
    }

    .cta > .source {
        font-size: 13px;
        color: color-mix(in oklab, var(--dusk) 75%, transparent);
    }

    .source a {
        color: var(--dusk);
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    .crowd {
        display: flex;
        justify-content: center;
        align-items: flex-end;
        gap: clamp(6px, 1.4vw, 18px);
        width: 100%;
        margin: 0;
        padding: 0 16px;
        list-style: none;
        overflow: hidden;
    }

    .crowd li {
        flex: none;
        margin-bottom: calc(-8px - var(--lift));
    }

    @media (max-width: 720px) {
        .closing::after {
            content: "";
            position: absolute;
            inset: 0;
            z-index: -1;
            background: linear-gradient(transparent 6%, color-mix(in oklab, #0b0a12 66%, transparent) 22%, color-mix(in oklab, #0b0a12 60%, transparent) 80%, transparent 94%);
        }

        .closing :global(.art) {
            mask-image: linear-gradient(transparent, #000 20%, #000 88%, transparent);
            -webkit-mask-image: linear-gradient(transparent, #000 20%, #000 88%, transparent);
        }
    }

    @media (max-width: 680px) {
        .crowd {
            --buddy-size: 40px;
            justify-content: flex-start;
        }
    }
</style>
