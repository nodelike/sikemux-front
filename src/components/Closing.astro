---
import Logo from "./Logo.astro";
import Dither from "./Dither.astro";
import DownloadButton from "./DownloadButton.astro";
import Shipping from "./Shipping.astro";
import { formatSize, REPO_URL, RELEASES_URL, type Release, type ReleaseNote } from "../lib/release";

interface Props {
    release: Release;
    releases: ReleaseNote[];
}

const { release, releases } = Astro.props;
---

<section class="section closing">
    <div class="page">
      <Shipping releases={releases} />
      <div class="panel grid">
        <Dither class="grain" />
        <div class="cta">
            <span class="mark"><Logo size={40} /></span>
            <h2>Open a project.<br />Keep it open.</h2>
            <div class="actions">
                <DownloadButton href={release.dmgUrl} />
                <a class="btn notes" href={RELEASES_URL}><span>What's new in v<span data-release-version>{release.version}</span></span></a>
            </div>
            <p class="facts mono">
                {release.dmgBytes !== null && <><span data-release-size>{formatSize(release.dmgBytes)}</span> · </>}Apple Silicon, macOS 11+ · FSL · <a href="#size">How it stays small</a>
            </p>
        </div>
        <div class="source">
            <p class="label">Or build it yourself</p>
            <pre><code><span class="prompt">$</span> git clone https://github.com/nodelike/sikemux
<span class="prompt">$</span> cd sikemux && pnpm install
<span class="prompt">$</span> make dev</code></pre>
            <p class="small">Needs Rust, Node 22 and pnpm. <a href={`${REPO_URL}/blob/main/CONTRIBUTING.md`}>Contributing guide</a></p>
        </div>
      </div>
    </div>
</section>

<footer class="footer">
    <div class="page row">
        <span class="brand">
            <Logo size={14} />
            <span class="mono"><code>sike</code> + <code>mux</code>, built by <a href="https://github.com/nodelike">@nodelike</a></span>
        </span>
        <nav aria-label="Footer">
            <a href={REPO_URL}>GitHub</a>
            <a href="https://discord.gg/UKfmHpF9kX">Discord</a>
            <a href={RELEASES_URL}>Releases</a>
            <a href={`${REPO_URL}/blob/main/LICENSE`}>License</a>
            <a href="/privacy">Privacy</a>
            <a href="/terms">Terms</a>
        </nav>
    </div>
</footer>

<style>
    .closing {
        padding-top: 0;
        border-top: 0;
    }

    .panel {
        position: relative;
        overflow: hidden;
        padding: clamp(32px, 5vw, 64px);
        border: 1px solid var(--border);
        border-radius: 20px;
        background:
            radial-gradient(70% 90% at 15% 0%, color-mix(in oklab, var(--acc) 22%, transparent), transparent 65%),
            radial-gradient(60% 80% at 100% 100%, color-mix(in oklab, var(--live) 8%, transparent), transparent 70%),
            var(--surface);
        isolation: isolate;
    }

    .panel :global(.grain) {
        inset: 0;
        mask-image: radial-gradient(ellipse 60% 80% at 15% 0%, #000, transparent 70%);
        -webkit-mask-image: radial-gradient(ellipse 60% 80% at 15% 0%, #000, transparent 70%);
    }

    .grid {
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
        align-items: end;
        gap: clamp(32px, 5vw, 72px);
    }

    .mark {
        display: block;
        margin-bottom: 4px;
        color: var(--acc);
    }

    .cta {
        display: grid;
        gap: 28px;
    }

    .cta h2 {
        font-size: clamp(34px, 5vw, 56px);
        line-height: 1.02;
        letter-spacing: -0.04em;
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .facts {
        margin-top: -12px;
        font-size: 12px;
        color: var(--text-tertiary);
    }

    .facts a {
        color: inherit;
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    .notes {
        height: 44px;
        padding-inline: 18px;
    }

    .source {
        display: grid;
        gap: 12px;
    }

    pre {
        margin: 0;
        padding: 18px 20px;
        border: 1px solid var(--border);
        border-radius: var(--radius-3);
        background: var(--surface);
        overflow-x: auto;
        font-size: 13px;
        line-height: 1.8;
        color: var(--text-primary);
    }

    pre code {
        font-size: inherit;
    }

    .prompt {
        color: var(--live);
        user-select: none;
    }

    .small {
        font-size: 13px;
        color: var(--text-tertiary);
    }

    .small a,
    .footer a {
        color: var(--text-secondary);
        text-decoration: underline;
        text-decoration-color: var(--border-strong);
        text-underline-offset: 3px;
    }

    .small a:hover,
    .footer a:hover {
        color: var(--text-primary);
    }

    .footer {
        border-top: 1px solid var(--border);
    }

    .row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding-block: 28px;
        font-size: 13px;
        color: var(--text-tertiary);
    }

    .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

    .brand .mono {
        font-size: 12px;
    }

    .brand code {
        font-size: inherit;
        color: var(--text-secondary);
    }

    nav {
        display: flex;
        gap: 20px;
    }

    @media (max-width: 860px) {
        .grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
