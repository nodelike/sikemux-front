---
interface Props {
    class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["dither", className]} data-dither aria-hidden="true"></div>

<script>
    const FRAMES_PER_SECOND = 30;
    const STILL_FRAME = 2500;
    const SPEED = 0.5;

    type Mount = { setFrame(frame: number): void; setMaxPixelCount(count: number): void; dispose(): void };

    const hosts = [...document.querySelectorAll<HTMLElement>("[data-dither]")];
    const visible = new Set<HTMLElement>();
    const mounts = new Map<HTMLElement, Mount>();
    const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const epoch = performance.now();
    let timer: number | null = null;

    function pixelCap(host: HTMLElement): number {
        const rect = host.getBoundingClientRect();
        return Math.max(1, Math.round(rect.width) * Math.round(rect.height));
    }

    function tick() {
        timer = null;
        const frame = (performance.now() - epoch) * SPEED;
        for (const host of visible) mounts.get(host)?.setFrame(frame);
        schedule();
    }

    function schedule() {
        if (still || timer !== null || document.hidden || visible.size === 0) return;
        timer = window.setTimeout(tick, 1000 / FRAMES_PER_SECOND);
    }

    async function start() {
        if (hosts.length === 0 || typeof WebGL2RenderingContext === "undefined") return;
        const { ShaderMount, ditheringFragmentShader, DitheringShapes, DitheringTypes, ShaderFitOptions, getShaderColorFromString } =
            await import("@paper-design/shaders");
        for (const host of hosts) {
            const dot = getComputedStyle(host).getPropertyValue("--dither-dot").trim() || "#19191e";
            try {
                const mount = new ShaderMount(
                    host,
                    ditheringFragmentShader,
                    {
                        u_colorBack: [0, 0, 0, 0],
                        u_colorFront: getShaderColorFromString(dot),
                        u_shape: DitheringShapes.simplex,
                        u_type: DitheringTypes["8x8"],
                        u_pxSize: 3,
                        u_fit: ShaderFitOptions.none,
                        u_scale: 2.4,
                        u_rotation: 0,
                        u_offsetX: 0,
                        u_offsetY: 0,
                        u_originX: 0.5,
                        u_originY: 0.5,
                        u_worldWidth: 0,
                        u_worldHeight: 0,
                    },
                    { antialias: false },
                    0,
                    still ? STILL_FRAME : (performance.now() - epoch) * SPEED,
                    1,
                    pixelCap(host),
                ) as unknown as Mount;
                mounts.set(host, mount);
                new ResizeObserver(() => mount.setMaxPixelCount(pixelCap(host))).observe(host);
            } catch {
                continue;
            }
        }
        const watcher = new IntersectionObserver((entries) => {
            for (const entry of entries) {
                const host = entry.target as HTMLElement;
                if (entry.isIntersecting) visible.add(host);
                else visible.delete(host);
            }
            schedule();
        });
        for (const host of mounts.keys()) watcher.observe(host);
        document.addEventListener("visibilitychange", schedule);
    }

    if ("requestIdleCallback" in window) requestIdleCallback(() => void start());
    else setTimeout(() => void start(), 200);
</script>

<style>
    .dither {
        position: absolute;
        z-index: -1;
        pointer-events: none;
    }
</style>
