---
import { Image } from "astro:assets";
import Kbd from "./Kbd.astro";
import Icon from "./Icon.astro";
import Plugins from "./Plugins.astro";
import editor from "../assets/shots/files-focus.png";
import term from "../assets/shots/terminals-focus.png";
import git from "../assets/shots/git-focus.png";
import agents from "../assets/shots/agents-focus.png";
import activity from "../assets/shots/activity-page.png";

const features = [
    {
        label: "Files",
        icon: "editor",
        keys: ["⌥1", "⌘P"],
        title: "An editor that knows which project it's in.",
        body: "CodeMirror 6 with LSP hover, go to definition and peek. Problems and Outline cover the whole project, not just the open file. Side-by-side diffs, a three-way merge view, and a file tree that watches the disk.",
        image: editor,
        alt: "The file tree beside a TypeScript file in the editor",
    },
    {
        label: "Term",
        icon: "command",
        keys: ["⌥2", "⌥\\"],
        title: "Native shells, split as far as you like.",
        body: "Every terminal is a real PTY owned by Rust. Split, tab, and drag a path in from the tree. Tasks from sikemux.json run in their own terminals and keep running when you close the view.",
        image: term,
        alt: "A terminal split showing 50 passing tests",
    },
    {
        label: "Git",
        icon: "git",
        keys: ["⌥3"],
        title: "Stage, commit, push. Let your CLI write the message.",
        body: "Branches, worktrees, merges, pull and push. Commit messages stream in from the Claude, Codex or Hermes CLI you already have, using its login. Sikemux never calls a model itself.",
        image: git,
        alt: "A commit message drafted by Hermes above the staged and unstaged files",
    },
    {
        label: "Agents",
        icon: "agent",
        keys: ["⌥4", "⌥N", "⌥Y"],
        title: "Several agents on one repo, each in its own pane.",
        body: "Pick an agent with ⌥N and it starts in a real terminal. Resume its saved sessions, and flip Normal or YOLO with ⌥Y. ⌘T opens a browser tab that belongs to the session and keeps its sign-ins. The agent can drive it, and you can take over at any time.",
        image: agents,
        alt: "Codex running the terminal test suite and committing its fix",
    },
    {
        label: "Activity",
        icon: "activity",
        keys: [],
        title: "See what your agents got done.",
        body: "Agent time, sessions, tokens and commits, day by day, split by agent and by project. It counts only what runs inside Sikemux, and it stays on your Mac.",
        image: activity,
        alt: "The Activity page: totals, a year of daily activity, and breakdowns by agent and by project",
    },
] as const;

---

<section class="section" id="features">
    <div class="page">
        <div class="section-head">
            <p class="label">Inside a project</p>
            <h2>Five views, one working directory.</h2>
            <p>Files, Term, Git, Agents and Search all start in the project folder. Switching between them is a key, not a window hunt.</p>
        </div>

        <div class="features">
            {
                features.map((feature, index) => (
                    <article class:list={["feature", { flip: index % 2 === 1 }]}>
                        <div class="text">
                            <p class="tag">
                                <span class="label name">
                                    <Icon name={feature.icon} size={14} />
                                    {feature.label}
                                </span>
                                <span class="keys">
                                    {feature.keys.map((keys) => (
                                        <Kbd keys={keys} />
                                    ))}
                                </span>
                            </p>
                            <h3>{feature.title}</h3>
                            <p>{feature.body}</p>
                        </div>
                        <div class="shot frame" style={`--natural: ${feature.image.width / 2}px`}>
                            <Image src={feature.image} alt={feature.alt} format="avif" quality={80} widths={[760, 1140, 1520]} sizes="(min-width: 1240px) 760px, 100vw" />
                        </div>
                    </article>
                ))
            }
        </div>

        <Plugins />
    </div>
</section>

<style>
    .features {
        display: grid;
        gap: clamp(56px, 8vw, 96px);
    }

    .feature {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
        align-items: start;
        gap: clamp(24px, 4vw, 64px);
    }

    .feature.flip {
        grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    }

    .feature.flip .text {
        order: 2;
    }

    .feature.flip .frame {
        justify-self: end;
    }

    .text {
        position: sticky;
        top: 96px;
        display: grid;
        gap: 16px;
        padding-top: 8px;
    }

    .text p {
        font-size: 15.5px;
        line-height: 1.65;
    }

    .frame {
        position: relative;
        justify-self: start;
        width: fit-content;
        max-width: 100%;
        padding: 10px;
        border: 1px solid var(--border);
        border-radius: var(--radius-4);
        background:
            radial-gradient(90% 60% at 50% 0%, color-mix(in oklab, var(--acc) 10%, transparent), transparent 70%),
            var(--surface);
        overflow: visible;
    }

    .frame :global(img) {
        width: var(--natural);
        max-width: 100%;
        border: 1px solid var(--border);
        border-radius: var(--radius-3);
    }

    .tag {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--border);
    }

    .name {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--text-secondary);
    }

    .op-title {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .keys {
        display: inline-flex;
        gap: 4px;
    }

    h3 {
        font-size: 24px;
        line-height: 1.2;
        letter-spacing: -0.025em;
    }


    @media (max-width: 860px) {
        .feature,
        .feature.flip {
            grid-template-columns: minmax(0, 1fr);
        }

        .feature.flip .text {
            order: 0;
        }

        .text {
            position: static;
        }
    }
</style>
