---
import { Image } from "astro:assets";
import Kbd from "./Kbd.astro";
import Icon from "./Icon.astro";
import editor from "../assets/shots/files-editor.png";
import term from "../assets/shots/terminals-stage.png";
import git from "../assets/shots/git-stage.png";
import agents from "../assets/shots/agents-chat.png";
import awsLogs from "../assets/shots/aws-ecs-logs-stage.png";
import rundeck from "../assets/shots/rundeck-deploy-stage.png";
import bruno from "../assets/shots/bruno-stage.png";

const features = [
    {
        label: "Files",
        icon: "editor",
        keys: ["⌥1", "⌘P"],
        title: "An editor that knows which project it's in.",
        body: "CodeMirror 6 with LSP hover, go to definition and peek. Problems and Outline cover the whole project, not just the open file. Side-by-side diffs, a three-way merge view, and a file tree that watches the disk.",
        image: editor,
        alt: "The editor with a TypeScript file open",
    },
    {
        label: "Term",
        icon: "command",
        keys: ["⌥2", "⌥\\"],
        title: "Native shells, split as far as you like.",
        body: "Every terminal is a real PTY owned by Rust. Split, tab, and drag a path in from the tree. Tasks from sikemux.json run in their own terminals and keep running when you close the view.",
        image: term,
        alt: "Three terminal splits running a dev server, tests, and git",
    },
    {
        label: "Git",
        icon: "git",
        keys: ["⌥3"],
        title: "Stage, commit, push. Let your CLI write the message.",
        body: "Branches, worktrees, merges, pull and push. Commit messages stream in from the Claude, Codex or Hermes CLI you already have, using its login. Sikemux never calls a model itself.",
        image: git,
        alt: "Staged and unstaged files, a drafted commit message, and the commit graph",
    },
    {
        label: "Agents",
        icon: "agent",
        keys: ["⌥4", "⌥N", "⌥Y"],
        title: "Several agents on one repo, each in its own pane.",
        body: "Pick an agent with ⌥N and it starts in a real terminal. Resume its saved sessions, and flip Normal or YOLO with ⌥Y. ⌘T opens a browser tab that belongs to the session and keeps its sign-ins. The agent can drive it, and you can take over at any time.",
        image: agents,
        alt: "Codex in YOLO mode running the test suite and committing its fix",
    },
] as const;

const ops = [
    { image: awsLogs, icon: "aws", title: "AWS", body: "Cost, ECS tasks with live CloudWatch logs, EC2, Lambda, S3 and SQS.", alt: "CloudWatch logs tailing for an ECS service" },
    { image: rundeck, icon: "rundeck", title: "Rundeck", body: "Start a job from the palette and follow every deploy step as it runs.", alt: "A Rundeck deploy with its steps and live output" },
    { image: bruno, icon: "bruno", title: "Bruno", body: "Open a collection as a session. ⌘P for requests, ⌘↵ to send.", alt: "A Bruno request and its response" },
] as const;
---

<section class="section" id="features">
    <div class="page">
        <div class="section-head">
            <p class="label">Inside a project</p>
            <h2>Five views, one working directory.</h2>
            <p>Files, Term, Git, Agents and Search all start in the project folder. Switching between them is a key, not a window hunt.</p>
        </div>

        <div class="features">
            {
                features.map((feature, index) => (
                    <article class:list={["feature", { flip: index % 2 === 1 }]}>
                        <div class="text">
                            <p class="tag">
                                <span class="label name">
                                    <Icon name={feature.icon} size={14} />
                                    {feature.label}
                                </span>
                                <span class="keys">
                                    {feature.keys.map((keys) => (
                                        <Kbd keys={keys} />
                                    ))}
                                </span>
                            </p>
                            <h3>{feature.title}</h3>
                            <p>{feature.body}</p>
                        </div>
                        <div class="shot">
                            <Image src={feature.image} alt={feature.alt} format="avif" quality={80} widths={[960, 1440, 2048]} sizes="(min-width: 1240px) 760px, 100vw" />
                        </div>
                    </article>
                ))
            }
        </div>

        <div class="ops">
            <div class="section-head">
                <p class="label">On the rail</p>
                <h2>Deploys and APIs sit next to the code.</h2>
                <p>
                    AWS, Rundeck and Bruno are built-in plugins. Turn on the ones you use, and they open beside the project like any other
                    view.
                </p>
            </div>
            <div class="ops-grid">
                {
                    ops.map((op) => (
                        <article>
                            <div class="shot">
                                <Image src={op.image} alt={op.alt} format="avif" quality={80} widths={[640, 960, 1280]} sizes="(min-width: 1240px) 390px, 100vw" />
                            </div>
                            <h3 class="op-title">
                                <Icon name={op.icon} size={16} />
                                {op.title}
                            </h3>
                            <p>{op.body}</p>
                        </article>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<style>
    .features {
        display: grid;
        gap: clamp(56px, 8vw, 96px);
    }

    .feature {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
        align-items: center;
        gap: clamp(24px, 4vw, 56px);
    }

    .feature.flip {
        grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    }

    .feature.flip .text {
        order: 2;
    }

    .text {
        display: grid;
        gap: 14px;
    }

    .tag {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--border);
    }

    .name {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--text-secondary);
    }

    .op-title {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .keys {
        display: inline-flex;
        gap: 4px;
    }

    h3 {
        font-size: 21px;
        letter-spacing: -0.02em;
    }

    .ops {
        margin-top: clamp(88px, 12vw, 144px);
    }

    .ops-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 24px;
    }

    .ops-grid article {
        display: grid;
        gap: 10px;
        align-content: start;
    }

    .ops-grid .shot {
        margin-bottom: 8px;
    }

    .ops-grid h3 {
        font-size: 16px;
    }

    .ops-grid p {
        font-size: 14px;
    }

    @media (max-width: 860px) {
        .feature,
        .feature.flip {
            grid-template-columns: minmax(0, 1fr);
        }

        .feature.flip .text {
            order: 0;
        }

        .ops-grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
