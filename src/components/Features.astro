---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import Plugins from "./Plugins.astro";
import editor from "../assets/shots/files-focus.png";
import term from "../assets/shots/terminals-focus.png";
import git from "../assets/shots/git-focus.png";
import agents from "../assets/shots/agents-focus.png";
import activity from "../assets/shots/activity-page.png";

const features = [
    {
        label: "Agents",
        icon: "agent",
        title: "Ask an agent to fix it, and watch it work.",
        body: "Start Claude Code, Codex or another agent right next to your code. It reads the project, edits files and runs commands while you watch, and you can step in at any time. Hand it a failing test, an error from the terminal, log lines or a GitHub issue in one click.",
        image: agents,
        alt: "Codex running the test suite, then committing its fix",
    },
    {
        label: "Review",
        icon: "git",
        title: "Check what it changed, then ship.",
        body: "See every file the agent touched before you commit, and let it write the commit message. Pull requests, issues and CI checks from GitHub and Bitbucket open right next to your code, so you can review and merge without a browser tab.",
        image: git,
        alt: "A commit message written by the agent above the files it changed",
    },
    {
        label: "Code",
        icon: "editor",
        title: "A real code editor when you want to dive in.",
        body: "Jump to any file, go to definitions, search the whole project and compare changes side by side. It also previews images, PDFs, video and Office files.",
        image: editor,
        alt: "The project's files beside a TypeScript file in the editor",
    },
    {
        label: "Terminals",
        icon: "command",
        title: "Terminals that keep running.",
        body: "Split as many terminals as you need for your dev server, tests and scripts. Close the window and your terminals and agents keep running in the background, right where you left them.",
        image: term,
        alt: "A terminal showing 50 passing tests",
    },
    {
        label: "Activity",
        icon: "activity",
        title: "See what your agents got done.",
        body: "Time spent, chats, tokens and commits, day by day, for each agent and each project. It only counts work done in Sikemux, and it never leaves your Mac.",
        image: activity,
        alt: "The Activity page: totals, a year of daily activity, and breakdowns by agent and by project",
    },
] as const;

---

<section class="section" id="features">
    <div class="page">
        <div class="section-head intro">
            <p class="label">How it works</p>
            <h2>Everything for one project, in one window.</h2>
            <p>Your agents, code, terminals, Git and a browser all open on the same project folder, so nothing gets lost between apps.</p>
        </div>
    </div>
    <div class="page">

        <div class="features">
            {
                features.map((feature, index) => (
                    <article class:list={["feature", { flip: index % 2 === 1 }]}>
                        <div class="text">
                            <p class="tag">
                                <span class="label name">
                                    <Icon name={feature.icon} size={14} />
                                    {feature.label}
                                </span>
                            </p>
                            <h3>{feature.title}</h3>
                            <p>{feature.body}</p>
                        </div>
                        <div class="shot frame" style={`--natural: ${feature.image.width / 2}px`}>
                            <Image src={feature.image} alt={feature.alt} format="avif" quality={80} widths={[760, 1140, 1520]} sizes="(min-width: 1240px) 760px, 100vw" />
                        </div>
                    </article>
                ))
            }
        </div>

        <Plugins />
    </div>
</section>

<style>
    .intro {
        margin-inline: auto;
        text-align: center;
        justify-items: center;
    }

    .features {
        display: grid;
        gap: clamp(56px, 8vw, 96px);
    }

    .feature {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
        align-items: start;
        gap: clamp(24px, 4vw, 64px);
    }

    .feature.flip {
        grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    }

    .feature.flip .text {
        order: 2;
    }

    .feature.flip .frame {
        justify-self: end;
    }

    .text {
        position: sticky;
        top: 96px;
        display: grid;
        gap: 16px;
        padding-top: 8px;
    }

    .text p {
        font-size: 15.5px;
        line-height: 1.65;
    }

    .frame {
        position: relative;
        justify-self: start;
        width: fit-content;
        max-width: 100%;
        padding: 10px;
        border: 1px solid var(--border);
        border-radius: var(--radius-4);
        background:
            radial-gradient(90% 60% at 50% 0%, color-mix(in oklab, var(--acc) 10%, transparent), transparent 70%),
            var(--surface);
        overflow: visible;
    }

    .frame :global(img) {
        width: var(--natural);
        max-width: 100%;
        border: 1px solid var(--border);
        border-radius: var(--radius-3);
    }

    .tag {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--border);
    }

    .name {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--text-secondary);
    }

    .op-title {
        display: flex;
        align-items: center;
        gap: 10px;
    }


    h3 {
        font-size: 24px;
        line-height: 1.2;
        letter-spacing: -0.025em;
    }


    @media (max-width: 860px) {
        .feature,
        .feature.flip {
            grid-template-columns: minmax(0, 1fr);
        }

        .feature.flip .text {
            order: 0;
        }

        .text {
            position: static;
        }
    }
</style>
