---
import Kbd from "./Kbd.astro";
import Icon from "./Icon.astro";

const keys = [
    { icon: "folder", keys: ["⌥P"], action: "Open a project" },
    { icon: "window", keys: ["⌥1", "⌥2", "⌥3", "⌥4", "⌥5"], action: "Files, Term, Git, Agents, Search" },
    { icon: "agent", keys: ["⌥N"], action: "New terminal or agent" },
    { icon: "run", keys: ["⌥Y"], action: "Toggle an agent's YOLO mode" },
    { icon: "panel", keys: ["⌥\\", "⌥-"], action: "Split by row or column" },
    { icon: "focus", keys: ["⌥H", "⌥J", "⌥K", "⌥L"], action: "Move between panes" },
    { icon: "zoom", keys: ["⌥Z"], action: "Zoom a pane" },
    { icon: "file", keys: ["⌘P"], action: "Open a file or request" },
    { icon: "command", keys: ["⌘⇧P"], action: "Command deck" },
    { icon: "search", keys: ["⌘⇧F"], action: "Search the project" },
    { icon: "globe", keys: ["⌘T"], action: "Browser tab" },
    { icon: "activity", keys: ["⌥⇧S"], action: "SSH to a host" },
] as const;
---

<section class="section" id="keys">
    <div class="page">
        <div class="section-head">
            <p class="label">Keyboard first</p>
            <h2>Every view is one key away.</h2>
            <p>⌥1 to ⌥5 switch views inside a project, and a project's sikemux.json can add its own shortcuts for its tasks.</p>
        </div>
        <dl class="keys">
            {
                keys.map((entry) => (
                    <div class="key">
                        <dt>
                            {entry.keys.map((keys) => <Kbd keys={keys} />)}
                        </dt>
                        <dd>
                            <Icon name={entry.icon} size={14} />
                            {entry.action}
                        </dd>
                    </div>
                ))
            }
        </dl>
    </div>
</section>

<style>
    .keys {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin: 0;
        border-top: 1px solid var(--border);
        border-left: 1px solid var(--border);
    }

    .key {
        display: grid;
        gap: 12px;
        align-content: start;
        padding: 20px;
        border-right: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
    }

    dt {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    dd {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0;
        font-size: 14px;
    }

    dd :global(svg) {
        flex: none;
        color: var(--text-tertiary);
    }

    @media (max-width: 860px) {
        .keys {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 520px) {
        .keys {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
