---
const use = [
    "You run more than one coding agent on the same repo.",
    "You keep a terminal, an editor and a Git client open side by side all day.",
    "You deploy through AWS or Rundeck and test APIs in Bruno.",
];

const skip = [
    "You want an editor with its own hosted agent. Cursor does that well.",
    "You want a terminal and nothing else. Use Ghostty.",
    "You're on an Intel Mac or Linux. There's no build for those yet.",
];
---

<section class="section">
    <div class="page">
        <div class="section-head">
            <p class="label">Is it for you</p>
            <h2>Opinionated, on purpose.</h2>
            <p>Sikemux picks one way to work: a project owns its windows, the keyboard comes first, and agents run as your own CLIs. If that's how you already work, it fits. If not, here's what to use instead.</p>
        </div>
        <div class="cols">
            <div class="col">
                <h3>Use Sikemux if</h3>
                <ul>{use.map((line) => <li>{line}</li>)}</ul>
            </div>
            <div class="col">
                <h3>Skip it if</h3>
                <ul class="skip">{skip.map((line) => <li>{line}</li>)}</ul>
            </div>
        </div>
    </div>
</section>

<style>
    .cols {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .col {
        display: grid;
        gap: 22px;
        align-content: start;
        padding: clamp(24px, 3vw, 36px);
        border: 1px solid var(--border);
        border-radius: var(--radius-4);
        background: var(--surface);
    }

    .col:first-child {
        border-color: color-mix(in oklab, var(--live) 22%, var(--border));
        background:
            radial-gradient(90% 70% at 0% 0%, color-mix(in oklab, var(--live) 9%, transparent), transparent 70%),
            var(--surface);
    }

    h3 {
        font-size: 20px;
    }

    ul {
        display: grid;
        gap: 14px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    li {
        position: relative;
        padding-left: 34px;
        font-size: 15.5px;
        line-height: 1.5;
        color: var(--text-primary);
    }

    li::before {
        content: "✓";
        position: absolute;
        top: 1px;
        left: 0;
        display: grid;
        place-items: center;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: color-mix(in oklab, var(--live) 16%, transparent);
        font-size: 12px;
        color: var(--live);
    }

    .skip li {
        color: var(--text-secondary);
    }

    .skip li::before {
        content: "–";
        background: var(--surface-hover);
        color: var(--text-tertiary);
    }

    @media (max-width: 760px) {
        .cols {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
