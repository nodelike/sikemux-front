---
const use = [
    "You use Claude Code, Codex or another coding agent, and want to see what it's doing.",
    "You keep an editor, terminals, Git and a browser open side by side all day.",
    "You check logs and deploys as part of your work.",
];

const skip = [
    "You want an editor with its own hosted agent. Cursor does that well.",
    "You want a terminal and nothing else. Use Ghostty.",
    "You're on Windows, Linux or an Intel Mac. There's no download for those yet.",
];
---

<div class="page fit">
        <div class="section-head">
            <p class="label">Is it for you</p>
            <h2>Is Sikemux right for you?</h2>
            <p>Sikemux is built around one way of working: one window per project, with your agents in it. Here's who it suits, and what to use instead if it doesn't.</p>
        </div>
        <div class="cols">
            <div class="col">
                <h3>Use Sikemux if</h3>
                <ul>{use.map((line) => <li>{line}</li>)}</ul>
            </div>
            <div class="col">
                <h3>Skip it if</h3>
                <ul class="skip">{skip.map((line) => <li>{line}</li>)}</ul>
            </div>
        </div>
</div>

<style>
    .fit {
        margin-bottom: clamp(56px, 8vw, 96px);
    }

    .cols {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .col {
        display: grid;
        gap: 22px;
        align-content: start;
        padding: clamp(24px, 3vw, 36px);
        border: 1px solid var(--border);
        border-radius: var(--radius-4);
        background: var(--surface);
    }

    .col:first-child {
        border-color: color-mix(in oklab, var(--live) 22%, var(--border));
        background:
            radial-gradient(90% 70% at 0% 0%, color-mix(in oklab, var(--live) 9%, transparent), transparent 70%),
            var(--surface);
    }

    h3 {
        font-size: 20px;
    }

    ul {
        display: grid;
        gap: 14px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    li {
        position: relative;
        padding-left: 34px;
        font-size: 15.5px;
        line-height: 1.5;
        color: var(--text-primary);
    }

    li::before {
        content: "✓";
        position: absolute;
        top: 1px;
        left: 0;
        display: grid;
        place-items: center;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: color-mix(in oklab, var(--live) 16%, transparent);
        font-size: 12px;
        color: var(--live);
    }

    .skip li {
        color: var(--text-secondary);
    }

    .skip li::before {
        content: "–";
        background: var(--surface-hover);
        color: var(--text-tertiary);
    }

    @media (max-width: 760px) {
        .cols {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
