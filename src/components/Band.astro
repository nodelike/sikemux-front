---
import { Picture } from "astro:assets";

interface Props {
    art: ImageMetadata;
    label?: string;
    titleId?: string;
    focus?: string;
    overlap?: number;
    room?: number;
    behind?: boolean;
}

const { art, label, titleId, focus = "center", overlap = 90, room = overlap + 40, behind = false } = Astro.props;
---

<div class:list={["banded", { behind }]} style={`--focus: ${focus}; --overlap: ${overlap}px; --room: ${room}px`}>
    <div class="band">
        <Picture class="art" src={art} alt="" formats={["avif", "webp"]} widths={[640, 960, 1280]} sizes="100vw" quality={55} loading="lazy" decoding="async" />
        <div class="veil" aria-hidden="true"></div>
        <div class="page copy" data-reveal>
            {label && <p class="label">{label}</p>}
            <h2 id={titleId} class="display"><slot name="title" /></h2>
            <p class="lede"><slot name="lede" /></p>
        </div>
    </div>
    <div class="page below">
        <slot />
    </div>
</div>

<style>
    .banded,
    .band {
        position: relative;
    }

    .band {
        display: grid;
        align-items: start;
        min-height: 520px;
    }

    .behind .band {
        position: static;
    }

    .behind .veil {
        bottom: 22%;
    }

    .behind .band :global(.art) {
        height: calc(78% - 24px);
    }

    .band :global(.art),
    .veil {
        position: absolute;
        inset: 0;
        pointer-events: none;
    }

    .band :global(.art) {
        inset: 12px 0 auto;
        width: 100%;
        height: calc(100% - 24px);
        mask-image: linear-gradient(transparent, #000 160px, #000 calc(100% - 220px), transparent);
        -webkit-mask-image: linear-gradient(transparent, #000 160px, #000 calc(100% - 220px), transparent);
        object-fit: cover;
        object-position: var(--focus);
    }

    .veil {
        background:
            linear-gradient(var(--bg-dim), color-mix(in oklab, var(--bg-dim) 55%, transparent) 60px, transparent 150px),
            linear-gradient(
                to top,
                var(--bg-dim) 24px,
                color-mix(in oklab, var(--bg-dim) 80%, transparent) 80px,
                color-mix(in oklab, var(--bg-dim) 40%, transparent) 170px,
                transparent 270px
            ),
            linear-gradient(
                90deg,
                color-mix(in oklab, var(--bg-dim) 90%, transparent) 0%,
                color-mix(in oklab, var(--bg-dim) 72%, transparent) 30%,
                color-mix(in oklab, var(--bg-dim) 30%, transparent) 52%,
                transparent 72%
            );
    }

    .copy {
        position: relative;
        display: grid;
        align-content: start;
        gap: 14px;
        padding-block: 128px var(--room);
    }

    .copy > * {
        max-width: 600px;
    }

    .label {
        color: var(--acc-soft);
    }

    .display {
        font-size: clamp(42px, 5.4vw, 68px);
        text-shadow: 0 2px 24px color-mix(in oklab, var(--bg-dim) 60%, transparent);
    }

    .lede {
        max-width: 500px;
        font-size: 17px;
        line-height: 1.55;
        color: color-mix(in oklab, var(--ink) 88%, transparent);
        text-shadow: 0 1px 12px var(--bg-dim);
    }

    .below {
        position: relative;
        z-index: 1;
        margin-top: calc(-1 * var(--overlap));
    }

    @media (max-width: 720px) {
        .band {
            min-height: 440px;
            align-items: end;
        }

        .band :global(.art),
        .behind .band :global(.art) {
            height: 300px;
        }

        .behind .veil {
            bottom: auto;
            height: 440px;
        }

        .veil {
            inset: 0;
            background:
                linear-gradient(var(--bg-dim), transparent 70px),
                linear-gradient(to top, var(--bg-dim) 38%, transparent 75%);
        }

        .copy {
            padding-block: 200px 24px;
        }

        .display {
            font-size: clamp(40px, 11vw, 52px);
        }

        .lede {
            font-size: 16px;
        }

        .below {
            margin-top: 8px;
        }
    }
</style>
