---
import { Image } from "astro:assets";
import "../styles/home.css";
import day from "../assets/hero/day.jpg";
import rail from "../assets/hero/rail.png";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="robots" content="noindex" />
        <title>A whole team of AI coders, in one window · Sikemux share card</title>
    </head>
    <body>
        <main class="card">
            <Image class="art" src={day} alt="" width={1792} format="jpg" quality={90} loading="eager" />
            <div class="wash"></div>
            <Image class="shot" src={rail} alt="" width={610} format="png" loading="eager" />
            <div class="copy">
                <img class="lockup" src="/brand/lockup-black.svg" alt="Sikemux" />
                <h1>A whole team of AI coders, in one window.</h1>
                <p class="fine mono">Free · Mac, Windows, Linux</p>
            </div>
        </main>
    </body>
</html>

<style>
    html,
    body {
        width: 100vw;
        height: 100vh;
        overflow: hidden;
        background: #f4f3f7;
    }

    .card {
        position: relative;
        width: 100vw;
        height: 100vh;
        overflow: hidden;
        color: #121017;
    }

    .art {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 50% 50%;
    }

    .wash {
        position: absolute;
        inset: 0;
        background: radial-gradient(70% 80% at 82% 30%, rgba(250, 248, 255, 0.72), rgba(250, 248, 255, 0) 70%);
    }

    .shot {
        position: absolute;
        display: block;
        left: 5.333vw;
        top: 8.889vh;
        height: 82.222vh;
        width: auto;
        border-radius: 14px;
        box-shadow:
            0 0 0 1px rgba(18, 16, 23, 0.55),
            0 24px 60px -18px rgba(40, 22, 90, 0.55);
    }

    .copy {
        position: absolute;
        left: 50vw;
        top: 9.84vh;
        width: 45vw;
    }

    .lockup {
        height: 30px;
        width: auto;
        display: block;
        margin-bottom: 34px;
    }

    h1 {
        font-size: 76px;
        font-weight: 600;
        line-height: 0.98;
        letter-spacing: -0.045em;
    }

    .fine {
        margin-top: 26px;
        font-size: 19px;
        letter-spacing: -0.01em;
        color: #3b3449;
    }
</style>
