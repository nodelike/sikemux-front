---
import type { GetStaticPaths } from "astro";
import ShareCard from "../../components/ShareCard.astro";
import { CARDS, type Card } from "../../lib/cards";

export const getStaticPaths = (() => CARDS.map((card) => ({ params: { path: card.path.slice(1) }, props: { card } }))) satisfies GetStaticPaths;

interface Props {
    card: Card;
}

const { card } = Astro.props;
---

<ShareCard title={card.title} body={card.body} label={card.label} agents={card.agents} />
