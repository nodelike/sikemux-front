---
import type { GetStaticPaths } from "astro";
import ShareCard from "../../components/ShareCard.astro";
import { CARDS, DOCS_CARD, type Card } from "../../lib/cards";

export const getStaticPaths = (() => [...CARDS, DOCS_CARD].map((card) => ({ params: { path: card.path.slice(1) }, props: { card } }))) satisfies GetStaticPaths;

interface Props {
    card: Card;
}

const { card } = Astro.props;
---

<ShareCard title={card.title} chip={card.chip} label={card.label} visual={card.visual} />
