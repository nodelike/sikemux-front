---
import Site from "../layouts/Site.astro";
---

<Site title="Page not found · Sikemux" description="This page does not exist." noindex>
    <header class="page-head missing">
        <span class="tag">404</span>
        <h1>Nothing<br /><span class="chip">lives here.</span></h1>
        <p class="lede">The page you asked for doesn't exist. The rest of Sikemux does.</p>
        <a class="btn solid" href="/">Back to sikemux.com</a>
    </header>
</Site>

<style>
    .missing {
        min-height: 56vh;
        align-content: center;
        border-bottom: 0;
    }
    .missing .tag,
    .missing .btn {
        justify-self: start;
    }
</style>
