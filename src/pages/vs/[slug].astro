---
import type { GetStaticPaths } from "astro";
import Article from "../../layouts/Article.astro";
import Highlights from "../../components/Highlights.astro";
import { COMPARISONS, comparisonPath, type Comparison } from "../../lib/comparisons";
import { formatSize, latestRelease } from "../../lib/release";

export const getStaticPaths = (() => COMPARISONS.map((comparison) => ({ params: { slug: comparison.slug }, props: { comparison } }))) satisfies GetStaticPaths;

interface Props {
    comparison: Comparison;
}

const { comparison } = Astro.props;
const release = await latestRelease();
const others = COMPARISONS.filter((other) => other !== comparison);
const description = `Sikemux vs ${comparison.name}: how a free, MIT-licensed native app for Claude Code and Codex compares with ${comparison.name}, the ${comparison.kind}, and which one fits how you work.`;
---

<Article
    title={`Sikemux vs ${comparison.name} · an agentic IDE compared`}
    description={description}
    crumbs={[
        { name: "Compare", path: "/vs" },
        { name: `vs ${comparison.name}`, path: comparisonPath(comparison) },
    ]}>
    <header>
        <p class="label">Compared</p>
        <h1>Sikemux vs<br /><span class="chip">{comparison.name}</span></h1>
        <p class="lede">{comparison.what}</p>
    </header>

    <section>
        <h2>The difference</h2>
        <p>{comparison.difference}</p>
    </section>

    <section class="picks">
        <div class="pick">
            <h2>Pick {comparison.name} if</h2>
            <ul>{comparison.pickThem.map((line) => <li>{line}</li>)}</ul>
        </div>
        <div class="pick own">
            <h2>Pick Sikemux if</h2>
            <ul>{comparison.pickSikemux.map((line) => <li>{line}</li>)}</ul>
        </div>
    </section>

    {
        comparison.bytes !== undefined && release.dmgBytes !== null && (
            <section>
                <h2>Download size</h2>
                <p>
                    Sikemux is <span data-release-size>{formatSize(release.dmgBytes)}</span> to download. {comparison.name}'s Apple Silicon installer{comparison.measuredAs && `, then called ${comparison.measuredAs},`} was{" "}
                    {formatSize(comparison.bytes)} when we checked on {comparison.checked}. Sikemux is drawn natively on the GPU, and its browser tabs use the
                    WebKit already built into macOS instead of shipping a browser of its own.
                </p>
            </section>
        )
    }

    <section>
        <h2>What you get in Sikemux</h2>
        <Highlights />
    </section>

    <section>
        <h2>More comparisons</h2>
        <p>
            {
                others.map((other, index) => (
                    <>
                        <a href={comparisonPath(other)}>Sikemux vs {other.name}</a>
                        {index < others.length - 1 ? " · " : ""}
                    </>
                ))
            }
        </p>
    </section>
</Article>

<style>
    .picks {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0;
        padding: 0;
    }

    .pick {
        display: grid;
        align-content: start;
        gap: 14px;
        padding: 32px 20px 36px;
    }

    .pick + .pick {
        border-left: 1px solid var(--rule);
    }

    .pick.own {
        background: var(--field);
    }

    .pick h2 {
        font-size: 20px;
    }

    @media (max-width: 640px) {
        .picks {
            grid-template-columns: minmax(0, 1fr);
        }
        .pick + .pick {
            border-left: 0;
            border-top: 1px solid var(--rule);
        }
    }
</style>
