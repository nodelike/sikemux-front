---
import Article from "../../layouts/Article.astro";
import { COMPARISONS, comparisonPath } from "../../lib/comparisons";

const description = "How Sikemux, a free, MIT-licensed native app for Claude Code and Codex, compares with T3 Code, Orca, Conductor, Paradev, herdr, Paseo, cmux, Cursor, Zed and Warp.";
---

<Article title="Sikemux vs T3 Code, Orca, Conductor, Paradev, herdr and more" description={description} crumbs={[{ name: "Compare", path: "/vs" }]}>
    <header>
        <p class="label">Compared</p>
        <h1>Sikemux and the tools<br /><span class="chip">you’re weighing it against.</span></h1>
        <p class="lede">
            Sikemux is built around one way of working: one window per project, with your agents in it. Here's how that differs from the agent apps,
            editors and terminals people compare it with, and when each one is the better pick. Each page says when its numbers were checked.
        </p>
    </header>

    <section>
        <ul class="list">
            {
                COMPARISONS.map((comparison) => (
                    <li>
                        <a href={comparisonPath(comparison)}>
                            <span class="name">Sikemux vs {comparison.name}</span>
                            <span class="kind">{comparison.kind}</span>
                        </a>
                    </li>
                ))
            }
        </ul>
    </section>
</Article>

<style>
    .list {
        display: grid;
        gap: 0;
        max-width: 68ch;
        border-top: 1px solid var(--rule);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .list a {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 16px 18px;
        border-bottom: 1px solid var(--rule);
        text-decoration: none;
        transition: background-color var(--dur-2) var(--ease-out);
    }

    .list a:hover {
        background: var(--field);
    }

    .name {
        font-weight: 500;
        color: var(--text-primary);
    }

    .kind {
        font-size: 14px;
        color: var(--text-tertiary);
    }
</style>
