---
import Site from "../layouts/Site.astro";
import Notch from "../components/home/widgets/Notch.astro";
import { APP_STORE_URL } from "../lib/release";

const testers = "https://groups.google.com/g/sikemux-android-testers";
const optIn = "https://play.google.com/apps/testing/com.nodelike.sikemux.mobile";
const play = "https://play.google.com/store/apps/details?id=com.nodelike.sikemux.mobile";

const steps = [
    { title: "Join the testers group", body: "Google Play only lets testers in while the app is in testing.", href: testers, action: "Join the group" },
    { title: "Become a tester", body: "Opt in on Google Play with the same Google account.", href: optIn, action: "Become a tester" },
    { title: "Install Sikemux", body: "It shows up on Google Play like any other app.", href: play, action: "Get it on Google Play", primary: true },
];

const connect = [
    { title: "Sign in", body: "Use the same account you signed in with in Sikemux on your computer." },
    { title: "Nothing to approve", body: "Signing in is the proof. Your computer shows the phone joining your account, and can take it off again." },
    { title: "That's it", body: "Your agents and chats show up on the phone, at home or anywhere else, end to end encrypted. No codes to scan." },
];
---

<Site title="Sikemux on your phone" description="Watch your coding agents work, answer what they ask and start new chats from your phone.">
    <header class="page-head">
        <span class="tag">Phone app</span>
        <h1>Your agents,<br /><span class="chip">in your pocket.</span></h1>
        <p class="lede">Watch every agent on your computer work, answer the one that needs you from a notification, and start new chats from anywhere.</p>
    </header>

    <section class="platforms">
        <div class="platform">
            <div class="platform-head">
                <h2>iPhone</h2>
                <span class="pill">On the App Store</span>
            </div>
            <ol class="steps">
                <li>
                    <span class="number mono">1</span>
                    <div class="step-text">
                        <p class="step-title">Install Sikemux</p>
                        <p class="step-body">Free on the App Store, for iOS 17 and later.</p>
                    </div>
                    <a class="btn solid" href={APP_STORE_URL}>Get it on the App Store</a>
                </li>
            </ol>
        </div>
        <div class="platform">
            <div class="platform-head">
                <h2>Android</h2>
                <span class="pill">In testing</span>
            </div>
            <ol class="steps">
                {
                    steps.map((step, index) => (
                        <li>
                            <span class="number mono">{index + 1}</span>
                            <div class="step-text">
                                <p class="step-title">{step.title}</p>
                                <p class="step-body">{step.body}</p>
                            </div>
                            <a class:list={["btn", { solid: step.primary }]} href={step.href}>
                                {step.action}
                            </a>
                        </li>
                    ))
                }
            </ol>
        </div>
    </section>

    <section class="scene" aria-label="The notch and the phone ask for the same permission">
        <Notch />
    </section>

    <section class="connect">
        <h2>Connecting<br /><span class="chip">takes a minute.</span></h2>
        <ol class="cards">
            {
                connect.map((step, index) => (
                    <li>
                        <span class="number mono">{index + 1}</span>
                        <h3>{step.title}</h3>
                        <p>{step.body}</p>
                    </li>
                ))
            }
        </ol>
    </section>
</Site>

<style>
    .platforms {
        display: grid;
        grid-template-columns: 1fr 1fr;
        border-bottom: 1px solid var(--rule);
    }
    .platform {
        display: grid;
        align-content: start;
        gap: 16px;
        padding: 32px 20px 36px;
    }
    .platform + .platform {
        border-left: 1px solid var(--rule);
    }
    .platform-head {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .platform-head h2 {
        font-size: 30px;
    }
    .pill {
        padding: 5px 8px;
        font: 500 11.5px/1 var(--mono);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        background: var(--ink);
        color: var(--paper);
    }
    .steps {
        list-style: none;
        margin: 0;
        padding: 0;
        border-top: 1px solid var(--rule);
    }
    .steps li {
        display: grid;
        grid-template-columns: 28px minmax(0, 1fr) auto;
        align-items: center;
        gap: 14px;
        padding: 14px 0;
        border-bottom: 1px solid var(--rule);
    }
    .number {
        font-size: 12px;
        color: var(--ink-3);
    }
    .step-title {
        font-weight: 500;
        color: var(--ink);
    }
    .step-body {
        font-size: 14px;
        color: var(--ink-2);
    }
    .scene {
        display: grid;
        place-items: center;
        padding: clamp(40px, 5vw, 72px) clamp(16px, 4vw, 56px);
        background: var(--field);
        border-bottom: 1px solid var(--rule);
    }
    .connect {
        display: grid;
        gap: 28px;
        padding: clamp(48px, 6vw, 80px) 20px;
    }
    .connect h2 {
        font-size: clamp(32px, 4vw, 52px);
    }
    .cards {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        border-top: 1px solid var(--rule);
        border-left: 1px solid var(--rule);
    }
    .cards li {
        display: grid;
        align-content: start;
        gap: 10px;
        padding: 22px 20px 26px;
        border-right: 1px solid var(--rule);
        border-bottom: 1px solid var(--rule);
    }
    .cards h3 {
        font-size: 18px;
        color: var(--ink);
    }
    .cards p {
        font-size: 15px;
        line-height: 1.6;
        color: var(--ink-2);
    }
    @media (max-width: 900px) {
        .platforms,
        .cards {
            grid-template-columns: minmax(0, 1fr);
        }
        .platform + .platform {
            border-left: 0;
            border-top: 1px solid var(--rule);
        }
        .steps li {
            grid-template-columns: 24px minmax(0, 1fr);
        }
        .steps .btn {
            grid-column: 2;
            justify-self: start;
        }
    }
</style>
