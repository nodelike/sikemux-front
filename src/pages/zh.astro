---
import { Image } from "astro:assets";
import Site from "../layouts/Site.astro";
import Icon from "../components/Icon.astro";
import Install from "../components/home/Install.astro";
import hero from "../assets/hero/hero.png";
import { REPO_URL, formatSize, latestRelease } from "../lib/release";

const release = await latestRelease();
const size = release.dmgBytes === null ? "约 30 MB" : formatSize(release.dmgBytes);

const points = [
    { title: "用你已有的订阅", body: "Claude Code、Codex 等七款编程智能体，直接用你已经在付费的订阅。" },
    { title: "原生应用，不是 Electron", body: `界面由 GPU 绘制，整个应用下载只有 ${size}。` },
    { title: "智能体之间会沟通", body: "它们互相发消息、交接任务，只把该由你拍板的事拿来问你。" },
    { title: "人不在电脑前也能回复", body: "MacBook 的刘海会提醒你；离开桌子，手机接着提醒。" },
];

const language = [
    { title: "打开设置", body: "在 Sikemux 里打开 Settings（设置）。" },
    { title: "外观 → 语言", body: "在「Appearance」页找到「Language」。" },
    { title: "选择「简体中文」", body: "界面文字立刻切换。智能体写的内容保持原样，不会被翻译。" },
];

const plans = ["智谱 GLM Coding Plan", "Kimi Code", "MiniMax M Plan", "阿里云百炼 Coding Plan", "火山方舟 Coding Plan", "小米 MiMo Token Plan", "阶跃星辰 Step Plan", "腾讯云 Coding Plan"];
---

<Site title="Sikemux · 一整支 AI 编程团队，尽在一个窗口" description="Sikemux 是免费、MIT 开源的 Mac 与 Linux 原生应用，把 Claude Code、Codex 等编程智能体并排放进一个窗口，用你自己的订阅，也支持国内编程套餐。" lang="zh-CN">
    <header class="page-head">
        <span class="tag">简体中文</span>
        <h1>一整支 AI 编程团队，<br /><span class="chip">尽在一个窗口。</span></h1>
        <p class="lede">Claude Code、Codex 等编程智能体，并排跑在同一个原生应用里。谁在干活、谁卡住了、谁在等你，一眼就能看到。</p>
        <div class="row">
            <a class="btn solid" href={release.dmgUrl} data-release-dmg>下载 Mac 版</a>
            <a class="btn" href="#download">Linux 版</a>
            <a class="btn ghost" href={REPO_URL}><Icon name="github" size={18} />Star</a>
        </div>
        <p class="fine mono">Apple Silicon Mac 与 Linux · <span data-release-size>{size}</span> · 免费，MIT 开源</p>
    </header>

    <figure class="shot window">
        <Image src={hero} alt="Sikemux 窗口：Claude Code 正在修复购物车页面的问题，右侧是它的浏览器标签页和项目里的其他智能体" widths={[828, 1560, 2340]} sizes="(min-width: 1240px) 1200px, 100vw" format="avif" quality={72} loading="eager" />
    </figure>

    <ul class="cards points">
        {
            points.map((point) => (
                <li>
                    <h3>{point.title}</h3>
                    <p>{point.body}</p>
                </li>
            ))
        }
    </ul>

    <section class="block">
        <h2>界面可以切换成<br /><span class="chip">简体中文。</span></h2>
        <p class="lede">从 0.6.2 版本起，Sikemux 自己的界面有简体中文。</p>
        <ol class="cards">
            {
                language.map((step, index) => (
                    <li>
                        <span class="number mono">{index + 1}</span>
                        <h3>{step.title}</h3>
                        <p>{step.body}</p>
                    </li>
                ))
            }
        </ol>
    </section>

    <section class="block">
        <h2>国内的编程套餐<br /><span class="chip">也能用。</span></h2>
        <p class="lede">在设置的「编程套餐」页填入密钥，智能体就能用上这些模型。按量计费的 DeepSeek、Moonshot 等 API 也可以接入。</p>
        <ul class="plans">{plans.map((plan) => <li>{plan}</li>)}</ul>
    </section>

    <section class="block" id="download">
        <h2>安装</h2>
        <p class="lede">macOS 11 及以上（Apple Silicon），或 x86_64、arm64 的 Linux。本机使用不需要注册账号。</p>
        <Install />
        <ul class="builds">
            {
                release.builds.map((build) => (
                    <li>
                        <a class:list={["btn", { solid: build.system === "macOS" }]} href={build.url} data-release-build={build.suffix}>
                            {build.system === "macOS" ? "下载 Mac 版" : build.label}
                            {build.bytes !== null && (
                                <span class="size mono" data-release-build-size={build.suffix}>
                                    {formatSize(build.bytes)}
                                </span>
                            )}
                        </a>
                    </li>
                ))
            }
        </ul>
    </section>

    <section class="block faq">
        <h3>免费吗？</h3>
        <p>免费，MIT 开源。Sikemux 用的是你自己的 Claude Code、Codex 等订阅，或者免费模型。我们不转售模型，也不抽成。</p>
        <h3>关于这一页</h3>
        <p>这一页由英文翻译而来。读起来有不通顺的地方，欢迎在 <a href={`${REPO_URL}/issues`}>GitHub</a> 上指出。</p>
    </section>
</Site>

<style>
    .page-head h1 {
        max-width: none;
        line-height: 1.2;
    }
    .row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }
    .fine {
        font-size: 12px;
        color: var(--ink-2);
    }
    .window {
        margin: clamp(32px, 4vw, 48px) 20px;
    }
    .block {
        display: grid;
        gap: 20px;
        justify-items: start;
        padding: clamp(48px, 6vw, 80px) 20px;
        border-top: 1px solid var(--rule);
    }
    .block h2 {
        font-size: clamp(30px, 4vw, 48px);
        line-height: 1.25;
    }
    .block .lede {
        max-width: 60ch;
        font-size: 17px;
        line-height: 1.7;
        color: var(--ink-2);
    }
    .block :global(.install) {
        width: min(100%, 560px);
    }
    .cards {
        list-style: none;
        margin: 0;
        padding: 0;
        width: 100%;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        border-top: 1px solid var(--rule);
        border-left: 1px solid var(--rule);
    }
    .points {
        grid-template-columns: repeat(4, minmax(0, 1fr));
        border-left: 0;
    }
    .cards li {
        display: grid;
        align-content: start;
        gap: 10px;
        padding: 22px 20px 26px;
        border-right: 1px solid var(--rule);
        border-bottom: 1px solid var(--rule);
    }
    .points li:last-child {
        border-right: 0;
    }
    .cards h3 {
        font-size: 18px;
        color: var(--ink);
    }
    .cards p {
        font-size: 15px;
        line-height: 1.7;
        color: var(--ink-2);
    }
    .number {
        font-size: 12px;
        color: var(--ink-3);
    }
    .plans,
    .builds {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }
    .plans li {
        padding: 8px 12px;
        border: 1px solid var(--rule);
        font-size: 14.5px;
        color: var(--ink);
    }
    .builds .size {
        margin-left: 8px;
        font-size: 12px;
        color: var(--ink-3);
    }
    .faq {
        gap: 12px;
    }
    .faq h3 {
        font-size: 18px;
        color: var(--ink);
    }
    .faq h3 + p {
        max-width: 60ch;
        margin-bottom: 16px;
        line-height: 1.7;
        color: var(--ink-2);
    }
    .faq a {
        color: var(--ink);
        text-decoration: underline;
    }
    @media (max-width: 900px) {
        .cards,
        .points {
            grid-template-columns: minmax(0, 1fr);
        }
        .points li {
            border-right: 0;
        }
    }
</style>
