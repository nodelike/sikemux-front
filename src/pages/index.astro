---
import Home from "../layouts/Home.astro";
import Nav from "../components/home/Nav.astro";
import Hero from "../components/home/Hero.astro";
import Agents from "../components/home/Agents.astro";
import Features from "../components/home/Features.astro";
import Beliefs from "../components/home/Beliefs.astro";
import Numbers from "../components/home/Numbers.astro";
import Closing from "../components/home/Closing.astro";
import Faq from "../components/home/Faq.astro";
import { FAQ, faqStructuredData } from "../lib/faq";
import Footer from "../components/home/Footer.astro";
import Play from "../components/home/Play.astro";
import LiveRelease from "../components/LiveRelease.astro";
import { getImage } from "astro:assets";
import hero from "../assets/hero/hero.png";
import { DISCORD_URL, X_URL, formatSize, latestRelease, REPO_URL } from "../lib/release";

const release = await latestRelease();

const description =
    "Out of Claude? The chat carries on in Codex. Sikemux is a free, MIT-licensed native app for Mac and Linux that runs Claude Code, Codex and other coding agents on your own plans and shows which one needs you.";

const screenshot = await getImage({ src: hero, width: 1560, format: "png" });
const origin = Astro.site!.href.replace(/\/$/, "");

const structuredData = [
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "Sikemux",
        url: "https://sikemux.com/",
    },
    {
        "@context": "https://schema.org",
        "@type": "Organization",
        name: "Sikemux",
        url: "https://sikemux.com/",
        logo: "https://sikemux.com/apple-touch-icon.png",
        sameAs: [REPO_URL, DISCORD_URL, X_URL],
    },
    {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: "Sikemux",
        description,
        url: "https://sikemux.com/",
        image: "https://sikemux.com/og.png",
        screenshot: `${origin}${screenshot.src}`,
        featureList: [
            "Runs Claude Code, Codex, OpenCode, Hermes, Grok, OMP and Pi with your own plan",
            "A real browser tab for each agent",
            "Agents test iOS apps in a live Simulator",
            "Code editor, terminals and Git review in one window",
            "Pull requests and CI from GitHub, GitLab and Bitbucket",
            "Jira, databases, AWS, Rundeck, SigNoz and Bruno views",
            "Terminals and agents keep running after the app quits",
            "Answer agents from the MacBook notch or the phone app",
        ],
        applicationCategory: "DeveloperApplication",
        operatingSystem: "macOS 11 or later, Linux",
        softwareVersion: release.version,
        downloadUrl: release.dmgUrl,
        ...(release.dmgBytes !== null && { fileSize: formatSize(release.dmgBytes) }),
        license: `${REPO_URL}/blob/main/LICENSE`,
        isAccessibleForFree: true,
        offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
        author: { "@type": "Person", name: "nodelike", url: "https://github.com/nodelike" },
        sameAs: [REPO_URL],
    },
    faqStructuredData(FAQ),
];
---

<Home
    title="Sikemux · a whole team of AI coders, in one window"
    description={description}
    structuredData={structuredData}>
    <Nav release={release} />
    <main>
        <Hero release={release} />
        <Agents />
        <Features />
        <Beliefs />
        <Numbers release={release} />
        <Faq />
    </main>
    <Closing release={release} />
    <Footer release={release} />
    <LiveRelease />
    <Play />
</Home>
