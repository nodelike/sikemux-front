---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import AgentStrip from "../components/AgentStrip.astro";
import Spread from "../components/Spread.astro";
import Features from "../components/Features.astro";
import Tools from "../components/Tools.astro";
import Keymap from "../components/Keymap.astro";
import Fit from "../components/Fit.astro";
import Faq from "../components/Faq.astro";
import Closing from "../components/Closing.astro";
import { latestRelease } from "../lib/release";

const release = await latestRelease();
---

<Base
    title="Sikemux: one window for the whole project"
    description="A tiling macOS workspace that keeps your editor, terminals, Git, coding agents, browser, AWS, Rundeck and Bruno on the same folder. Free and open source.">
    <Nav release={release} />
    <main>
        <Hero release={release} />
        <AgentStrip />
        <Spread />
        <Features />
        <Tools />
        <Keymap />
        <Fit />
        <Faq />
    </main>
    <Closing release={release} />
</Base>
