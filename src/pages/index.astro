---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Agents from "../components/Agents.astro";
import Features from "../components/Features.astro";
import Tools from "../components/Tools.astro";
import Size from "../components/Size.astro";
import Faq from "../components/Faq.astro";
import Closing from "../components/Closing.astro";
import LiveRelease from "../components/LiveRelease.astro";
import { formatSize, latestRelease, recentReleases, REPO_URL, starCount } from "../lib/release";

const [release, stars, releases] = await Promise.all([latestRelease(), starCount(), recentReleases()]);

const description =
    "Run Claude Code, Codex and other coding agents beside your editor, terminals, Git and a real browser, all on one project folder. Free and open source for macOS.";

const structuredData = [
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "Sikemux",
        url: "https://sikemux.com/",
    },
    {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: "Sikemux",
        description,
        url: "https://sikemux.com/",
        image: "https://sikemux.com/og.png",
        screenshot: "https://sikemux.com/og.png",
        applicationCategory: "DeveloperApplication",
        operatingSystem: "macOS 11 or later",
        softwareVersion: release.version,
        downloadUrl: release.dmgUrl,
        ...(release.dmgBytes !== null && { fileSize: formatSize(release.dmgBytes) }),
        license: "https://opensource.org/licenses/MIT",
        isAccessibleForFree: true,
        offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
        author: { "@type": "Person", name: "nodelike", url: "https://github.com/nodelike" },
        sameAs: [REPO_URL],
    },
];
---

<Base
    title="Sikemux · macOS workspace for coding agents and terminals"
    description={description}
    structuredData={structuredData}>
    <Nav release={release} stars={stars} />
    <main>
        <Hero release={release} stars={stars} />
        <Features />
        <Agents />
        <Tools />
        <Size release={release} />
        <Faq />
    </main>
    <Closing release={release} releases={releases} />
    <LiveRelease />
</Base>
