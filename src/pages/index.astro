---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Agents from "../components/Agents.astro";
import Features from "../components/Features.astro";
import Phone from "../components/Phone.astro";
import Notch from "../components/Notch.astro";
import Marquee from "../components/Marquee.astro";
import Compare from "../components/Compare.astro";
import Plugins from "../components/Plugins.astro";
import More from "../components/More.astro";
import Size from "../components/Size.astro";
import Faq from "../components/Faq.astro";
import Closing from "../components/Closing.astro";
import LiveRelease from "../components/LiveRelease.astro";
import { getImage } from "astro:assets";
import hero from "../assets/hero/hero.png";
import { FAQ, faqStructuredData } from "../lib/faq";
import { DISCORD_URL, X_URL, formatSize, latestRelease, recentReleases, REPO_URL, starCount } from "../lib/release";

const [release, stars, releases] = await Promise.all([latestRelease(), starCount(), recentReleases()]);

const description =
    "Sikemux is a free agentic IDE for Mac and Linux. Run Claude Code, Codex and other coding agents beside your editor, Git and a real browser, in one window.";

const screenshot = await getImage({ src: hero, width: 1560, format: "png" });
const origin = Astro.site!.href.replace(/\/$/, "");

const structuredData = [
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "Sikemux",
        url: "https://sikemux.com/",
    },
    {
        "@context": "https://schema.org",
        "@type": "Organization",
        name: "Sikemux",
        url: "https://sikemux.com/",
        logo: "https://sikemux.com/apple-touch-icon.png",
        sameAs: [REPO_URL, DISCORD_URL, X_URL],
    },
    {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: "Sikemux",
        description,
        url: "https://sikemux.com/",
        image: "https://sikemux.com/og.png",
        screenshot: `${origin}${screenshot.src}`,
        featureList: [
            "Runs Claude Code, Codex, OpenCode, Hermes, Grok, OMP and Pi with your own plan",
            "A real browser tab for each agent",
            "Agents test iOS apps in a live Simulator",
            "Code editor, terminals and Git review in one window",
            "Pull requests and CI from GitHub, GitLab and Bitbucket",
            "Jira, databases, AWS, Rundeck, SigNoz and Bruno views",
            "Terminals and agents keep running after the app quits",
            "Answer agents from the MacBook notch or the phone app",
        ],
        applicationCategory: "DeveloperApplication",
        operatingSystem: "macOS 11 or later, Linux",
        softwareVersion: release.version,
        downloadUrl: release.dmgUrl,
        ...(release.dmgBytes !== null && { fileSize: formatSize(release.dmgBytes) }),
        license: `${REPO_URL}/blob/main/LICENSE`,
        isAccessibleForFree: true,
        offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
        author: { "@type": "Person", name: "nodelike", url: "https://github.com/nodelike" },
        sameAs: [REPO_URL],
    },
    faqStructuredData(FAQ),
];
---

<Base
    title="Sikemux · the agentic IDE for Claude Code and Codex"
    description={description}
    structuredData={structuredData}>
    <Nav release={release} stars={stars} />
    <main>
        <Hero release={release} stars={stars} />
        <Marquee />
        <Features />
        <Notch />
        <Phone />
        <Agents />
        <Plugins />
        <More />
        <Compare />
        <Size release={release} />
        <Faq />
    </main>
    <Closing release={release} releases={releases} />
    <LiveRelease />
</Base>
