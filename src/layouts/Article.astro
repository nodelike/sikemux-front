---
import Site from "./Site.astro";
import { INSTALL_COMMAND, REPO_URL, formatSize, latestRelease } from "../lib/release";

interface Crumb {
    name: string;
    path: string;
}

interface Props {
    title: string;
    description: string;
    crumbs: Crumb[];
    structuredData?: Record<string, unknown>[];
    noindex?: boolean;
}

const { title, description, crumbs, structuredData = [], noindex = false } = Astro.props;
const release = await latestRelease();

const breadcrumbs = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [{ name: "Sikemux", path: "/" }, ...crumbs].map((crumb, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: crumb.name,
        item: new URL(crumb.path, Astro.site).href,
    })),
};
---

<Site title={title} description={description} structuredData={[breadcrumbs, ...structuredData]} noindex={noindex}>
    <div class="article">
        <nav class="crumbs" aria-label="Breadcrumb">
            <a href="/">Sikemux</a>
            {
                crumbs.map((crumb, index) =>
                    index === crumbs.length - 1 ? (
                        <span aria-current="page">{crumb.name}</span>
                    ) : (
                        <a href={crumb.path}>{crumb.name}</a>
                    ),
                )
            }
        </nav>
        <slot />
    </div>
    <aside class="cta" slot="after">
        <div class="frame cta-inner">
            <h2>Try it on your<br /><span class="chip">own project.</span></h2>
            <div class="side">
                <p>Free for Apple Silicon Macs on macOS 11 or later and x86_64 Linux{release.dmgBytes !== null && <>, <span data-release-size>{formatSize(release.dmgBytes)}</span> to download on a Mac</>}.</p>
                <div class="actions">
                    <a class="btn solid" href={release.dmgUrl} data-release-dmg>Download for Mac</a>
                    <a class="btn" href={REPO_URL}>Star on GitHub</a>
                </div>
                <code class="mono">{INSTALL_COMMAND}</code>
            </div>
        </div>
    </aside>
</Site>

<style>
    .crumbs {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding: 18px 20px;
        border-bottom: 1px solid var(--rule);
        font: 400 12px/1.4 var(--mono);
        color: var(--ink-3);
    }
    .crumbs > * + *::before {
        content: "/";
        margin-right: 8px;
        color: var(--ink-3);
    }
    .crumbs a {
        text-decoration: none;
    }
    .crumbs a:hover,
    .crumbs [aria-current] {
        color: var(--ink);
    }
    :global(:where(.article > header)) {
        display: grid;
        gap: 20px;
        padding: clamp(40px, 6vw, 88px) 20px clamp(32px, 4vw, 48px);
        border-bottom: 1px solid var(--rule);
    }
    :global(:where(.article > header > .label)) {
        justify-self: start;
        padding: 6px 8px;
        font: 500 11.5px/1 var(--mono);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        background: var(--ink);
        color: var(--paper);
    }
    .article :global(h1) {
        font-size: clamp(40px, 5.6vw, 76px);
        max-width: 18ch;
    }
    .article :global(.lede) {
        max-width: 60ch;
        font-size: 17px;
        line-height: 1.55;
        color: var(--ink-2);
    }
    :global(:where(.article > section)) {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 18px;
        padding: clamp(36px, 4.5vw, 56px) 20px;
        border-bottom: 1px solid var(--rule);
        color: var(--ink-2);
    }
    :global(:where(.article > section:last-child)) {
        border-bottom: 0;
    }
    .article :global(section h2) {
        font-size: clamp(24px, 2.8vw, 34px);
        color: var(--ink);
    }
    .article :global(section h2 a) {
        text-decoration: none;
    }
    .article :global(section h3) {
        color: var(--ink);
    }
    .article :global(section p),
    .article :global(section li) {
        max-width: 68ch;
        font-size: 16px;
        line-height: 1.7;
    }
    .article :global(section ul:not([class])) {
        display: grid;
        gap: 8px;
        margin: 0;
        padding-left: 20px;
    }
    .article :global(section p a) {
        color: var(--ink);
        text-decoration: underline;
        text-decoration-color: var(--ink-3);
        text-underline-offset: 3px;
    }
    .article :global(section p a:hover) {
        text-decoration-color: var(--violet);
    }
    .article :global(pre) {
        margin: 0;
        padding: 14px 16px;
        overflow-x: auto;
        border: 1px solid var(--rule);
        background: var(--paper-2);
        font: 400 13px/1.6 var(--mono);
        color: var(--ink);
    }
    .cta {
        background: var(--violet);
        color: #120d1c;
        border-top: 1px solid var(--rule);
    }
    .cta-inner {
        border-color: #120d1c;
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
        gap: 40px;
        align-items: end;
        padding: clamp(56px, 7vw, 96px) 20px;
    }
    .cta h2 {
        font-size: clamp(40px, 5vw, 72px);
        color: #120d1c;
    }
    .cta .side {
        display: grid;
        gap: 18px;
    }
    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }
    .cta .btn {
        border-color: #120d1c;
        color: #120d1c;
    }
    .cta .btn:hover,
    .cta .btn.solid {
        background: #120d1c;
        color: #f4f3f7;
    }
    .cta .btn.solid::after {
        background: #120d1c;
    }
    .cta code {
        font-size: 13px;
        overflow-wrap: anywhere;
    }
    @media (max-width: 900px) {
        .cta-inner {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
