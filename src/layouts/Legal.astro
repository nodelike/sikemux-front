---
import Site from "./Site.astro";

interface Props {
    title: string;
    description: string;
    updated: string;
}

const { title, description, updated } = Astro.props;
const here = Astro.url.pathname;
---

<Site title={`${title} · Sikemux`} description={description}>
    <nav class="legal-nav" aria-label="Legal">
        <a href="/privacy" aria-current={here.startsWith("/privacy") ? "page" : undefined}>Privacy</a>
        <a href="/terms" aria-current={here.startsWith("/terms") ? "page" : undefined}>Terms</a>
        <a href="/delete-account" aria-current={here.startsWith("/delete-account") ? "page" : undefined}>Delete account</a>
    </nav>
    <header class="page-head">
        <span class="tag">Updated {updated}</span>
        <h1>{title}</h1>
    </header>
    <div class="page-copy prose">
        <slot />
    </div>
</Site>

<style>
    .legal-nav {
        display: flex;
        border-bottom: 1px solid var(--rule);
        font-size: 14px;
    }
    .legal-nav a {
        padding: 14px 20px;
        border-right: 1px solid var(--rule);
        text-decoration: none;
        color: var(--ink-2);
    }
    .legal-nav a:hover {
        color: var(--ink);
    }
    .legal-nav a[aria-current="page"] {
        background: var(--ink);
        color: var(--paper);
    }
    .page-head .tag {
        justify-self: start;
    }
    .prose {
        max-width: 760px;
        gap: 16px;
    }
    .prose :global(h2) {
        margin-top: 24px;
        font-size: 24px;
    }
</style>
