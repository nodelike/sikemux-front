---
import Base from "./Base.astro";
import Logo from "../components/Logo.astro";

interface Props {
    title: string;
    description: string;
    updated: string;
}

const { title, description, updated } = Astro.props;
---

<Base title={`${title} · Sikemux`} description={description}>
    <header class="top">
        <div class="page bar">
            <a class="brand" href="/" aria-label="Sikemux home">
                <span class="mark"><Logo size={20} /></span>
                <span class="word">SIKE<span>MUX</span></span>
            </a>
            <nav aria-label="Legal">
                <a href="/privacy" aria-current={Astro.url.pathname.startsWith("/privacy") ? "page" : undefined}>Privacy</a>
                <a href="/terms" aria-current={Astro.url.pathname.startsWith("/terms") ? "page" : undefined}>Terms</a>
                <a href="/delete-account" aria-current={Astro.url.pathname.startsWith("/delete-account") ? "page" : undefined}>Delete account</a>
            </nav>
        </div>
    </header>
    <main class="page legal">
        <p class="label">Updated {updated}</p>
        <h1>{title}</h1>
        <div class="prose">
            <slot />
        </div>
    </main>
</Base>

<style>
    .top {
        border-bottom: 1px solid var(--border);
    }

    .bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 64px;
    }

    .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--text-primary);
    }

    .mark {
        display: grid;
        place-items: center;
        color: var(--acc);
    }

    .word {
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 0.16em;
    }

    .word span {
        color: var(--text-tertiary);
    }

    nav {
        display: flex;
        gap: 20px;
        font-size: 14px;
    }

    nav a {
        color: var(--text-secondary);
        transition: color var(--dur-2) var(--ease-out);
    }

    nav a:hover,
    nav a[aria-current="page"] {
        color: var(--text-primary);
    }

    .legal {
        max-width: 720px;
        padding-block: clamp(48px, 8vw, 96px);
    }

    h1 {
        margin: 14px 0 32px;
        font-size: clamp(36px, 5vw, 52px);
        line-height: 1.04;
        letter-spacing: -0.04em;
    }

    .prose {
        display: grid;
        gap: 16px;
        font-size: 16px;
        line-height: 1.7;
    }

    .prose :global(h2) {
        margin-top: 32px;
        font-size: 22px;
        line-height: 1.25;
        letter-spacing: -0.025em;
    }

    .prose :global(ul) {
        display: grid;
        gap: 8px;
        margin: 0;
        padding-left: 20px;
    }

    .prose :global(strong) {
        color: var(--text-primary);
        font-weight: 600;
    }

    .prose :global(a) {
        color: var(--text-primary);
        text-decoration: underline;
        text-decoration-color: var(--border-strong);
        text-underline-offset: 3px;
    }

    .prose :global(a:hover) {
        text-decoration-color: var(--text-primary);
    }
</style>
