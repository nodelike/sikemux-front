---
import "../styles/home.css";
import Head from "../components/Head.astro";
import Analytics from "../components/Analytics.astro";

type Props = import("../components/Head.astro").Props;
---

<!doctype html>
<html lang="en">
    <head>
        <Head {...Astro.props} />
        <link rel="preload" href="/fonts/Figtree-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/JetBrainsMonoNerdFontMono-Regular-Base.woff2" as="font" type="font/woff2" crossorigin />
        <script is:inline>
            (() => {
                let theme;
                try {
                    theme = localStorage.getItem("theme");
                } catch {}
                document.documentElement.dataset.theme = theme === "dark" ? "dark" : "light";
            })();
        </script>
    </head>
    <body>
        <slot />
        <Analytics />
    </body>
</html>
